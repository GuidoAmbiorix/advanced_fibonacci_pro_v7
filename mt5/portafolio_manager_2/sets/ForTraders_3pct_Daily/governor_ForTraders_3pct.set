; Portfolio Governor Configuration
; ForTraders Challenge: 3% Daily DD / 5% Max DD
; Account: ForTraders FTTrading-Server
; Strategy: Ultra-Conservative Dynamic Draft Portfolio

;═══════════════════════════════════════════════════════════════════
; FORTRADERS CHALLENGE PARAMETERS
;═══════════════════════════════════════════════════════════════════
; Daily Drawdown Limit:   3.0% (HARD STOP)
; Max Drawdown Limit:     5.0% (CHALLENGE FAILURE)
; Monthly Drawdown:       Usually 10% (but 5% max applies)
;
; STRATEGY: Stay well below limits with aggressive risk reduction
; - Pause trading at 2.9% daily DD (0.1% safety buffer)
; - Start reducing risk at 2.0% daily DD
; - Portfolio max risk: 2.5% total (conservative positioning)
;═══════════════════════════════════════════════════════════════════

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=2.5
; Max Total Portfolio Risk (%) - ForTraders Conservative Cap
; - Allows ~7 simultaneous trades at 0.35% risk each
; - Total exposure: 7 × 0.35% = 2.45% < 2.5% limit
; - Prevents over-concentration before hitting daily limit

InpMaxSymbolRisk=1.2
; Max Risk Per Symbol (%)
; - Single symbol max: 1.2% of account
; - With InpRiskBase=0.35%: Allows 3-4 positions per symbol
; - Typical usage: 1 position per symbol (0.35%) + safety margin

InpMaxGroupRisk=2.0
; Max Risk Per Correlation Group (%)
; - EUR Group (EURUSD, GBPUSD): Max 2.0% combined
; - JPY Group (USDJPY, GBPJPY): Max 2.0% combined
; - Prevents correlated drawdowns from stacking

;═══════ DRAWDOWN GOVERNOR (CRITICAL FOR 3% LIMIT) ═══════
InpDD_Normal=2.0
; DD Level: Normal Trading (%)
; - Triggers risk reduction at 2.0% daily drawdown
; - Allows 1.0% headroom before pause level
; - Strategy: Early reduction prevents approaching limit

InpDD_Reduced=2.5
; DD Level: Reduced Risk (%)
; - Second tier reduction at 2.5% daily drawdown
; - Applies additional InpDD_ReducedMult scaling
; - Only 0.4% away from pause level - trade cautiously

InpDD_Pause=2.9
; DD Level: Pause Trading (%) - HARD STOP
; - CRITICAL: Must be below 3.0% (ForTraders Daily Limit)
; - Set to 2.9% for 0.1% safety buffer
; - Stops ALL new trades at this level
; - Prevents challenge failure due to slight overshoot

InpDD_ReducedMult=0.50
; Risk Multiplier when DD > Normal
; - Cuts position sizes in HALF (50% reduction)
; - Example: 0.35% base risk → 0.175% when DD > 2.0%
; - Aggressive reduction to prevent approaching limits
; - Formula: ActualRisk = BaseRisk × 0.50

;═══════ ROLLING PROFIT FACTOR GOVERNOR ═══════
InpRollingTrades=20
; Rolling Window (trades)
; - Tracks last 20 trades for performance analysis
; - Faster adaptation than 50-trade window
; - Responds quickly to deteriorating performance

InpPF_Normal=1.3
; PF Level: Normal Trading
; - Target: Win $1.30 for every $1 lost
; - Realistic target with 0.35% risk sizing
; - Maintains edge while preserving capital

InpPF_Reduced=1.15
; PF Level: Reduced Risk
; - Warning: Performance degrading
; - Applies risk reduction multiplier
; - Example: PF drops from 1.3 to 1.2 → reduce size

InpPF_Pause=0.95
; PF Level: Pause Trading
; - Stop: Losing money (below break-even)
; - Prevents digging deeper hole
; - Reassess strategy immediately

InpPF_ReducedMult=0.70
; Risk Mult when PF < Normal
; - Reduce size by 30% when PF drops
; - Example: 0.35% → 0.245% when underperforming
; - More gradual than DD reduction (allows recovery)

;═══════ DAILY/WEEKLY/MONTHLY LIMITS ═══════
InpDailyMaxDD=2.9
; Daily Max Drawdown (%)
; - ForTraders Limit is 3.0%
; - Set to 2.9% for safety buffer (0.1% cushion)
; - CRITICAL: Exceeding 3.0% = Challenge Failure

InpWeeklyMaxDD=4.0
; Weekly Max Drawdown (%)
; - Conservative weekly limit
; - Intermediate stop before monthly/max limit
; - Prevents slow bleed across multiple days

InpMonthlyMaxDD=4.9
; Monthly Max Drawdown (%)
; - ForTraders Max Limit is 5.0%
; - Set to 4.9% for safety buffer
; - CRITICAL: Exceeding 5.0% = Challenge Failure
; - Should never reach this (daily limits prevent it)

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=true
; Enable Correlation Guard
; - Dynamic Draft System manages 5-symbol correlation ranking
; - Prevents taking correlated positions simultaneously
; - Essential for tight drawdown limits

InpHighCorrelation=0.70
; High Correlation Threshold
; - Detects pairs moving together
; - Examples:
;   * EURUSD / GBPUSD (EUR correlation)
;   * USDJPY / GBPJPY (JPY correlation)
; - Triggers size reduction when correlation > 0.70

InpCorrelationReduction=0.50
; Size Reduction Factor
; - Cut position size in HALF for correlated entries
; - Example: Want 0.35% risk on GBPUSD
; - But EURUSD already open with high correlation
; - Actual risk: 0.35% × 0.50 = 0.175%
; - Prevents double exposure to same market move

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
; Magic Number Base
; - Symbol_Engine instances: 100001-100999
; - Metals_Engine instances: 100011+

InpMagicRange=999
; Magic Number Range
; - Covers all Symbol_Engine and Metals_Engine instances
; - Governor monitors all trades in this range

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=5
; Update Interval (seconds)
; - Balance between responsiveness and CPU usage
; - Checks portfolio state every 5 seconds
; - Fast enough to catch limit breaches quickly

;═══════════════════════════════════════════════════════════════════
; RISK ALLOCATION EXAMPLE (5 SYMBOLS)
;═══════════════════════════════════════════════════════════════════
;
; Base Configuration (Normal Market, DD < 2.0%):
; ───────────────────────────────────────────────────────────────────
; Symbol      Risk/Trade   MaxTrades   MaxSymbolRisk
; ───────────────────────────────────────────────────────────────────
; EURUSD      0.35%        1           0.35%
; GBPUSD      0.30%        1           0.30%
; USDJPY      0.35%        1           0.35%
; GBPJPY      0.25%        1           0.25%
; XAUUSD      0.30%        1           0.30%
; ───────────────────────────────────────────────────────────────────
; TOTAL:                               1.55% < 2.5% ✓
;
; Maximum Simultaneous Exposure:
;   - All 5 pairs trading: 1.55% total portfolio risk
;   - Well below 2.5% portfolio limit
;   - Each pair limited to 1 position (no add-ons)
;   - Correlation guard prevents EUR/GBP doubling
;
; Scaled Down (DD = 2.2%, InpDD_ReducedMult = 0.50):
; ───────────────────────────────────────────────────────────────────
; EURUSD      0.175%       1           0.175%
; GBPUSD      0.150%       1           0.150%
; USDJPY      0.175%       1           0.175%
; GBPJPY      0.125%       1           0.125%
; XAUUSD      0.150%       1           0.150%
; ───────────────────────────────────────────────────────────────────
; TOTAL:                               0.775% < 2.5% ✓
;
; Paused (DD ≥ 2.9%):
; ───────────────────────────────────────────────────────────────────
; ALL TRADING STOPPED - No new positions allowed
; Emergency mode - assess situation before resuming
;
;═══════════════════════════════════════════════════════════════════
; PROFIT TARGET EXAMPLES
;═══════════════════════════════════════════════════════════════════
;
; Daily Target (Conservative 1% gain):
;   - Need: 1.0% / 0.35% = ~3 winning trades (at 1R)
;   - Or: 1-2 runners at 3-4R
;
; Weekly Target (Conservative 3% gain):
;   - Need: 10-12 winning trades per week
;   - Or: 5-6 runners at 3R average
;   - Max trades/day: 5 per symbol × 5 symbols = 25 potential
;   - Realistic: 2-4 quality setups per day
;
; Challenge Pass Criteria:
;   - Don't hit 3% daily DD ✓
;   - Don't hit 5% max DD ✓
;   - Achieve profit target (varies by challenge)
;
;═══════════════════════════════════════════════════════════════════
