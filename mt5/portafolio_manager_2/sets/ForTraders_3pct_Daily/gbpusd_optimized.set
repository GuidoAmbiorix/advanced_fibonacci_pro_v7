; GBPUSD - H1 Timeframe Institutional Flow
; ForTraders Server Configuration
; Optimized for 3% Daily / 5% Max Drawdown Challenge
; Core Major - Volatile

; ====== BROKER NOTES ======
; ForTraders Server: FTTrading-Server
; Run Spread_Diagnostics_ForTraders.mq5 to verify broker digit format
; Current setting assumes 5-digit broker (10 points = 1 pip)

; ====== IDENTITY ======
InpMagicNumber=100002

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

; ====== FIBONACCI ======
InpSwingLookback=8
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.5
InpDisplacementLookback=3

; ====== RSI ======
InpRSI_Period=9
InpRSI_Oversold=35
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.15

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=17
; STRICT: Increased to 17 for GBPUSD (more volatile, needs stricter filter)
; Tighter drawdown limits require better win rate
InpEnableAddOns=false
InpAddOn1_R=1.5
InpAddOn2_R=2.8
InpMaxPositions=1

; ====== RISK ======
InpRiskBase=0.30
; REDUCED: 0.30% per trade (was 0.35%)
; GBPUSD is more volatile, use smaller position size
; Allows ~9 losses before hitting 2.9% daily limit
InpMaxRisk=1.0
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
InpTPMode=2
InpFixedTP_R=3.5
; GBPUSD moves bigger - increased target
InpMinTP_R=2.0
; Increased minimum (GBPUSD volatile, need min 2R)
InpMaxTP_R=6.0
; GBPUSD can trend hard on H1
InpTPUseLearnedMFE=true

; ====== EXIT ======
InpTrailingMode=1
InpTrailType=1            ; 1=Chandelier
InpTrailStepATR=0.5       ; Step size (if Type=2)
InpMinVolatilityPips=8.0  ; Avoid dead zones (Volatile Pair)
InpMaxVolatilityFactor=3.0; Avoid crashes
InpVolatilityTP_Mult=4.0  ; Dynamic Target (Volatile Pair)
InpTPMode=4               ; Use Volatility TP
InpPartialTP_R=1.8
; GBPUSD - take partial at 1.8R (volatile, secure some profit)
InpPartialClosePercent=35.0
; Keep 65% running for big GBPUSD trends
InpBE_Threshold_R=0.6
; Dynamic trail activates at 0.6R
InpTrailStart_R=0.6
InpTrailATR_Mult=1.6
; GBPUSD: Slightly wider (more volatile than EURUSD)
InpTrailDecayRate=0.25
; Slower decay - GBPUSD needs more room
InpTrailMinMult=0.50
InpTrailRegimeAware=true

; ====== SPREAD ======
InpMaxSpreadPoints=35
; CRITICAL SETTING - Verify with Spread_Diagnostics_ForTraders.mq5!
;
; 5-DIGIT BROKER: 35 points = 3.5 pips (OPTIMAL for GBPUSD)
; 3-DIGIT BROKER: 35 points = 35 pips (TOO HIGH - change to 3-4)
;
; ForTraders typical spreads:
;   - GBPUSD: 0.8-3.0 pips during London/NY
;   - Set to 3.5 pips max (GBPUSD can widen during volatility)
;   - Blocks trades during high spread periods

; ====== SMC ======
InpUseSMC=true
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.5
InpSMC_MinFVG_ATR=0.50

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
; H1 chart uses H4 for higher timeframe context
InpMTF=16386
; H1: PRIMARY TIMEFRAME
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=15
InpNewsMinutesAfter=15

; ====== KELLY ======
InpUseKelly=true
InpKellyFraction=0.25
InpDailyMaxDD=2.9
; ForTraders daily limit is 3.0%
InpWeeklyMaxDD=4.0

; ====== LEARNING ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR ======
InpUseSessionGovernor=true
InpMaxTradesPerSession=10
InpTradeCooldownMinutes=10
InpEnableSessionBlacklist=false

; ====== PORTFOLIO PROTECTION ======
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=2.0
; Max 2R daily loss per symbol
; 0.30% × 2R = 0.6% max from GBPUSD
InpLossCooldownMinutes=90
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=5
InpUseReversalFilter=true
