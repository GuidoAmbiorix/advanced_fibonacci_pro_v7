; GBPJPY - H1 Timeframe Institutional Flow
; "The Dragon" - High Volatility Cross
; Optimized for H1 timeframe (reduced noise, cleaner signals)
; London session specialist with explosive volatility

; ====== IDENTITY ======
InpMagicNumber=100010

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
; Lower priority during Asian session
InpEnableLondonOpenKZ=true
; London open (3 AM - 6 AM EST): PEAK volatility for GBP/JPY
InpEnableNYKZ=true
; NY session: Good continuation with London-NY overlap
InpEnableLondonCloseKZ=false

; ====== FIBONACCI ======
InpSwingLookback=8
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.20

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.4
; Higher ATR multiplier for GBP/JPY volatility
InpDisplacementLookback=3

; ====== RSI ======
InpRSI_Period=9
InpRSI_Oversold=30
; Lower threshold for high volatility
InpRSI_Overbought=65
; Higher threshold for strong momentum
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.15
; Higher slope requirement for strong trends

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.70
; Slightly lower threshold (more permissive) for volatile pair
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=13
; H1: HIGHER threshold (13) for volatile pair - better quality setups
InpEnableAddOns=false
InpAddOn1_R=1.5
InpAddOn2_R=2.8
InpMaxPositions=1

; ====== RISK ======
InpRiskBase=10.0
; Aggressive Micro
InpMaxRisk=20.0
; Max aggression
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
InpTPMode=2
; H1: Adaptive TP mode for trend-following
InpFixedTP_R=3.5
; GBP/JPY: Larger target due to high volatility
InpMinTP_R=2.0
; H1: Minimum 2.0R (GBP/JPY has bigger moves)
InpMaxTP_R=7.0
; H1: GBP/JPY can trend explosively - capture full moves
InpTPUseLearnedMFE=true

; ====== EXIT ======
InpTrailingMode=1
; H1: Aggressive trailing stop for trend-following
InpPartialTP_R=2.0
; H1: Take partial at 2.0R (larger moves expected)
InpPartialClosePercent=35.0
; H1: Keep 65% running for explosive trends
InpBE_Threshold_R=1.0
; H1: Move to BE at 1.0R (slightly later due to volatility)
InpTrailStart_R=0.8
; H1: START TRAILING EARLIER - lock profits sooner
InpTrailATR_Mult=1.3
; H1: WIDER trail for GBP/JPY volatility (avoid premature stops)

; ====== SPREAD ======
InpMaxSpreadPoints=90
; Higher spread tolerance for GBP/JPY (typical 2-3 pips)

; ====== SMC ======
InpUseSMC=true
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.5
; Higher impulse requirement for GBP/JPY
InpSMC_MinFVG_ATR=0.60
; Larger FVG threshold for volatility

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
; H1 chart uses H4 (16388) for higher timeframe context
InpMTF=16386
; H1: Primary timeframe (16386)
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=20
; Wider buffer before news (GBP/JPY reacts violently)
InpNewsMinutesAfter=20
; Wider buffer after news

; ====== KELLY ======
InpUseKelly=true
InpKellyFraction=0.25
InpKellyFraction=0.25
InpKellyFraction=0.25
InpDailyMaxDD=30.0
InpWeeklyMaxDD=60.0

; ====== LEARNING ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR ======
InpUseSessionGovernor=true
InpMaxTradesPerSession=10
InpTradeCooldownMinutes=10
InpEnableSessionBlacklist=false

; ====== PORTFOLIO PROTECTION ======
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=90
; H1: Increased from 45 to 90 minutes
InpMaxConsecutiveLosses=2
; Phase 2 fix: Hard limit at 2 losses
InpUseReversalFilter=true
InpReversalCooldownMinutes=30

; ====== KILLSWITCH ======
InpUseKillSwitch=true
InpKS_MinTradesForActivation=20
InpKS_LossStreakThreshold=3
InpKS_RollingRThreshold=-5.0
InpKS_WinRateThreshold=0.30

; ====== SESSION TIMES ======
InpUseCustomSessions=false
InpAsianStart=0
InpAsianEnd=9
InpLondonStart=2
InpLondonEnd=11
InpNYStart=8
InpNYEnd=17

; ====== REVERSAL DETECTION ======
InpUseReversal=true
InpReversalATR_Mult=3.0
; Higher multiplier for GBP/JPY reversals
InpReversalSwingLookback=20
