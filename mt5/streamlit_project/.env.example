# ========================================
# MT5 Trading Intelligence Platform
# Environment Configuration
# ========================================
#
# Copy this file to .env and customize your settings
# Values shown are defaults - uncomment and modify as needed

# ========== MT5 Settings ==========

# Path to MT5 .set files directory
# MT5_SETS_PATH=C:\Users\gamparo\Desktop\Projects\advanced_fibonacci_pro_v7\mt5\portafolio_manager\sets

# MT5 Connection (optional - leave empty for default terminal)
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_TIMEOUT=60000

# ========== Portfolio Governor Settings ==========

# Correlation Analysis
# CORRELATION_TIMEFRAME=H1
# CORRELATION_BARS=100
# CORRELATION_CACHE_TTL=900
# CORRELATION_HIGH_THRESHOLD=0.75

# Group Generation Rules
# GROUP_SIZE=4
# MAX_SAME_DRIVER=2
# MAX_HIGH_CORR_PAIRS=1
# MIN_ASSET_CLASSES=2

# Symbol Scoring Weights (must sum to 100)
# SCORE_SESSION_ACTIVITY_MAX=20
# SCORE_TREND_ALIGNMENT_MAX=25
# SCORE_SPREAD_QUALITY_MAX=15
# SCORE_VOLATILITY_MATCH_MAX=15
# SCORE_HISTORICAL_PERF_MAX=25

# Scoring Thresholds
# MIN_ACCEPTABLE_SCORE=40
# EXCELLENT_SCORE_THRESHOLD=75

# ========== Analytics Settings ==========

# Risk-Free Rate for Sharpe Ratio (annual %)
# RISK_FREE_RATE=4.5

# Performance Calculation
# TRADING_DAYS_PER_YEAR=252
# MIN_TRADES_FOR_STATS=30

# Drawdown Alerts (%)
# MAX_DRAWDOWN_WARNING=10.0
# MAX_DRAWDOWN_CRITICAL=20.0

# ========== Data Settings ==========

# Data Fetching Limits
# MAX_TRADES_TO_FETCH=10000
# MAX_HISTORY_DAYS=365
# DEFAULT_CHART_BARS=500

# Database Path
# DATABASE_PATH=data/trading.db

# ========== Logging Settings ==========

# LOG_LEVEL=INFO
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
# LOGS_DIR=logs

# ========== Cache Settings ==========

# CACHE_ENABLED=true
# SYMBOL_SCORES_CACHE_TTL=60
# GROUPS_CACHE_TTL=300

# ========== UI Settings ==========

# PAGE_TITLE=Elite MT5 Trading Intelligence Platform
# THEME=dark
# SHOW_WARNINGS=true
# TOP_GROUPS_DISPLAY=5

# ========== Development Settings ==========

# DEBUG_MODE=false
# ENABLE_PROFILING=false
# SKIP_CONFIG_VALIDATION=false
