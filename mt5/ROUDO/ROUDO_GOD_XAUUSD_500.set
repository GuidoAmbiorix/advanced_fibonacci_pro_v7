; ROUDO GOD MODE v3.0 - Configuración Óptima para XAUUSD
; Cuenta recomendada: $500
; Símbolo: XAUUSD (Gold)
; Timeframe: Cualquiera (usa M1 para señales MACD)
; Creado: 2026-01-24

; ═══════════════════════════════════════════════════════════════════
; LOTES Y MARTINGALE
; ═══════════════════════════════════════════════════════════════════
Lots=0.01
||<-
UseFibonacciProgression=true
||<-
LotExponent=1.50
||<-
MaxLots=3.00
||<-
TakeProfit=50.0
||<-

; ═══════════════════════════════════════════════════════════════════
; KILLZONES ICT - CRÍTICO PARA ÉXITO
; ═══════════════════════════════════════════════════════════════════
UseKillzones=true
||<-
TradeAsianKillzone=false
||<-
TradeLondonOpen=true
||<-
TradeLondonClose=false
||<-
TradeNYOpen=false
||<-
TradeLondonNYOverlap=true
||<-
ServerTimeOffset=0
||0-10

; ═══════════════════════════════════════════════════════════════════
; TRAILING STOP
; ═══════════════════════════════════════════════════════════════════
UseTrailingStop=true
||<-
TrailingType=1
||0-3
; 0=TRAILING_NONE, 1=TRAILING_ATR, 2=TRAILING_STEP, 3=TRAILING_PERCENT
TrailingActivation=20.0
||10.0-50.0
TrailingDistance=15.0
||10.0-30.0
TrailingStep=10.0
||5.0-20.0
ATR_TrailingMultiplier=1.50
||1.0-3.0

; ═══════════════════════════════════════════════════════════════════
; BREAKEVEN
; ═══════════════════════════════════════════════════════════════════
UseBreakeven=true
||<-
BreakevenActivation=15.0
||10.0-30.0
BreakevenOffset=5.0
||3.0-10.0

; ═══════════════════════════════════════════════════════════════════
; PARTIAL TAKE PROFIT
; ═══════════════════════════════════════════════════════════════════
UsePartialTP=true
||<-
TP1_Level=30.0
||20.0-50.0
TP1_Percent=30.0
||20.0-40.0
TP2_Level=50.0
||40.0-70.0
TP2_Percent=40.0
||30.0-50.0
TP3_Level=80.0
||60.0-100.0
TP3_Percent=30.0
||20.0-40.0

; ═══════════════════════════════════════════════════════════════════
; GESTIÓN DE RIESGO - MUY IMPORTANTE
; ═══════════════════════════════════════════════════════════════════
MetaGananciaDiaria=50.0
||30.0-100.0
MaxDailyDrawdown=10.0
||5.0-20.0
MaxDrawdownPerTrade=5.0
||3.0-10.0
StopOnDrawdownHit=true
||<-
MaxOperacionesGrid=8
||5-12
Min_Margin_Level=800.0
||500.0-1000.0

; ═══════════════════════════════════════════════════════════════════
; INDICADORES
; ═══════════════════════════════════════════════════════════════════
ATR_Period=14
||10-20
ATR_Multiplier=2.50
||1.5-4.0
Max_Spread=30
||20-50
UseAdaptiveStep=true
||<-

; ═══════════════════════════════════════════════════════════════════
; DASHBOARD
; ═══════════════════════════════════════════════════════════════════
Enable_Dashboard=true
||<-
Enable_KillzoneInfo=true
||<-
Enable_SessionStats=true
||<-
DashboardCorner=0
||0-3
; 0=Superior Izquierda, 1=Superior Derecha, 2=Inferior Izquierda, 3=Inferior Derecha
DashboardXOffset=10
||0-100
DashboardYOffset=10
||0-100

; ═══════════════════════════════════════════════════════════════════
; IDENTIFICACIÓN
; ═══════════════════════════════════════════════════════════════════
MagicNumber_Hilo=11111
||10000-99999
