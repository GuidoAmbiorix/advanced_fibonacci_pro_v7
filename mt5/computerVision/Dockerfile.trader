FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy only necessary requirements (not MetaTrader5)
COPY requirements.txt ./
RUN pip install --no-cache-dir pandas numpy scikit-learn pyyaml requests

# Copy application code
COPY src/ ./src/
COPY data/ ./data/

# Create logs directory
RUN mkdir -p ./logs

CMD ["python", "src/trading/auto_trader.py"]
