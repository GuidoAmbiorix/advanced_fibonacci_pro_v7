FROM continuumio/miniconda3:23.3.1-0

WORKDIR /app

# Install TA-Lib via conda (easiest and most reliable method)
RUN conda install -c conda-forge ta-lib -y && \
    conda clean -afy

# Copy requirements and install (excluding TA-Lib since it's from conda)
COPY requirements-linux.txt ./requirements.txt
RUN grep -v "^TA-Lib" requirements.txt > requirements-filtered.txt || cp requirements.txt requirements-filtered.txt && \
    pip install --no-cache-dir -r requirements-filtered.txt

# Copy application code
COPY src/ ./src/
COPY dashboard/ ./dashboard/

# Create directories for volume mounts (don't copy data - will be mounted)
RUN mkdir -p ./data ./models ./logs

# Set environment variable to indicate Docker environment
ENV DOCKER_CONTAINER=true

EXPOSE 8501

CMD ["streamlit", "run", "dashboard/app.py", "--server.address=0.0.0.0"]
