# PostgreSQL Database Configuration
# IMPORTANT: Change the default password for production!
POSTGRES_PASSWORD=123
DB_PASSWORD=123
DB_USER=cv_agent
DB_NAME=cv_trading

# VNC Password for MT5 terminal access
VNC_PASSWORD=password
MT5_USER=trader
MT5_VNC_PASSWORD=trading

# PostgreSQL Connection URL (used by containers)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://cv_agent:123@postgres:5432/cv_trading

# MT5 Credentials (required for Windows container bridge)
# Get these from your MT5 broker account
MT5_LOGIN=your_mt5_login_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server_name

# Example MT5 server names:
# - FundingPips-Demo
# - FundingPips-Live
# - ICMarkets-Demo
# - ICMarkets-Live01
# Check your broker's documentation for the exact server name
