<?xml version="1.0" encoding="UTF-8"?>
<StrategyQuantProject version="4.0">
  <ProjectInfo>
    <Name>EURUSD_Scalping_Portfolio_Fibonacci_Elliott</Name>
    <Description>Scalping strategy configuration for EURUSD using Fibonacci, Elliott Waves, RSI, MACD and advanced filters. Optimized for portfolio integration with MT5 Symbol_Engine.</Description>
    <Author>Portfolio Manager Integration</Author>
    <Created>2026-01-25</Created>
    <Type>StrategyBuilder</Type>
  </ProjectInfo>

  <!-- DATA CONFIGURATION -->
  <DataSettings>
    <Symbol>EURUSD</Symbol>
    <Timeframes>
      <Primary>M5</Primary>
      <Secondary>M15</Secondary>
      <Validation>M15</Validation>
    </Timeframes>
    <DataPeriod>
      <StartDate>2023-01-01</StartDate>
      <EndDate>2026-01-25</EndDate>
      <MinimumYears>3</MinimumYears>
    </DataPeriod>
    <DataQuality>
      <TickData>true</TickData>
      <FillGaps>true</FillGaps>
      <RemoveOutliers>true</RemoveOutliers>
      <RequiredBars>50000</RequiredBars>
    </DataQuality>
    <TradingCosts>
      <Spread>1.5</Spread>
      <SpreadUnit>pips</SpreadUnit>
      <Commission>0</Commission>
      <Slippage>0.5</Slippage>
    </TradingCosts>
  </DataSettings>

  <!-- BUILDER CONFIGURATION -->
  <BuilderSettings>
    <GenerationMode>Random</GenerationMode>
    <StrategiesToGenerate>10000</StrategiesToGenerate>
    <MaxRuntime>720</MaxRuntime> <!-- 12 hours -->
    <ParallelTasks>MAX</ParallelTasks>
    <OptimizationEngine>Genetic</OptimizationEngine>

    <!-- BUILDING BLOCKS -->
    <EntryBlocks>
      <MaxConditions>3</MaxConditions>
      <MaxIndicators>4</MaxIndicators>
      <AllowedIndicators>
        <!-- FIBONACCI RETRACEMENT -->
        <Indicator>
          <Name>FibonacciRetracement</Name>
          <Enabled>true</Enabled>
          <Levels>0.236,0.382,0.500,0.618,0.786</Levels>
          <SwingLookback min="20" max="50" step="5"/>
          <PriceAction>TouchLevel,BreakLevel,RejectionLevel</PriceAction>
          <Weight>2.0</Weight>
        </Indicator>

        <!-- ELLIOTT WAVE -->
        <Indicator>
          <Name>ElliottWave</Name>
          <Enabled>true</Enabled>
          <WaveType>Impulse,Correction</WaveType>
          <WaveCount>3,5</WaveCount>
          <ValidationMethod>ZigZag</ValidationMethod>
          <MinWaveSize>15</MinWaveSize> <!-- pips -->
          <Weight>1.5</Weight>
        </Indicator>

        <!-- RSI -->
        <Indicator>
          <Name>RSI</Name>
          <Enabled>true</Enabled>
          <Period min="7" max="21" step="7"/>
          <OversoldLevel min="20" max="35" step="5"/>
          <OverboughtLevel min="65" max="80" step="5"/>
          <UseDivergence>true</UseDivergence>
          <Weight>1.0</Weight>
        </Indicator>

        <!-- MACD -->
        <Indicator>
          <Name>MACD</Name>
          <Enabled>true</Enabled>
          <FastPeriod min="8" max="12" step="2"/>
          <SlowPeriod min="21" max="26" step="2"/>
          <SignalPeriod min="7" max="9" step="1"/>
          <SignalType>Crossover,Histogram,Divergence</SignalType>
          <Weight>1.0</Weight>
        </Indicator>

        <!-- EMA TREND -->
        <Indicator>
          <Name>EMA</Name>
          <Enabled>true</Enabled>
          <Period min="20" max="200" step="20"/>
          <PricePosition>Above,Below</PricePosition>
          <SlopeFilter>true</SlopeFilter>
          <MinSlope>0.0001</MinSlope>
          <Weight>0.5</Weight>
        </Indicator>

        <!-- ATR VOLATILITY -->
        <Indicator>
          <Name>ATR</Name>
          <Enabled>true</Enabled>
          <Period>14</Period>
          <UseFilter>true</UseFilter>
          <MinATR>8</MinATR> <!-- pips -->
          <MaxATR>50</MaxATR> <!-- pips -->
          <Weight>0.5</Weight>
        </Indicator>

        <!-- BOLLINGER BANDS -->
        <Indicator>
          <Name>BollingerBands</Name>
          <Enabled>true</Enabled>
          <Period min="20" max="30" step="5"/>
          <Deviation min="1.5" max="2.5" step="0.5"/>
          <SignalType>TouchBand,BreakBand,Squeeze</SignalType>
          <Weight>0.5</Weight>
        </Indicator>

        <!-- STOCHASTIC -->
        <Indicator>
          <Name>Stochastic</Name>
          <Enabled>true</Enabled>
          <KPeriod min="5" max="14" step="3"/>
          <DPeriod min="3" max="5" step="1"/>
          <Slowing>3</Slowing>
          <OversoldLevel>20</OversoldLevel>
          <OverboughtLevel>80</OverboughtLevel>
          <Weight>0.5</Weight>
        </Indicator>

        <!-- ADX TREND STRENGTH -->
        <Indicator>
          <Name>ADX</Name>
          <Enabled>true</Enabled>
          <Period>14</Period>
          <MinLevel>20</MinLevel>
          <MaxLevel>50</MaxLevel>
          <Weight>0.5</Weight>
        </Indicator>

        <!-- PRICE PATTERNS -->
        <Indicator>
          <Name>CandlePatterns</Name>
          <Enabled>true</Enabled>
          <Patterns>Engulfing,PinBar,InsideBar,Doji</Patterns>
          <MinBodySize>5</MinBodySize> <!-- pips -->
          <Weight>0.3</Weight>
        </Indicator>
      </AllowedIndicators>
    </EntryBlocks>

    <!-- EXIT BLOCKS -->
    <ExitBlocks>
      <StopLoss>
        <Type>Fixed,ATR,Fibonacci</Type>
        <Fixed min="10" max="30" step="5"/> <!-- pips -->
        <ATRMultiplier min="1.0" max="2.5" step="0.5"/>
        <FibonacciLevel>0.382,0.500,0.618</FibonacciLevel>
      </StopLoss>

      <TakeProfit>
        <Type>Fixed,ATR,Risk-Reward,Fibonacci</Type>
        <Fixed min="15" max="60" step="10"/> <!-- pips -->
        <ATRMultiplier min="1.5" max="4.0" step="0.5"/>
        <RiskReward min="1.5" max="3.0" step="0.5"/>
        <FibonacciLevel>1.000,1.272,1.618,2.618</FibonacciLevel>
      </TakeProfit>

      <TrailingStop>
        <Enabled>true</Enabled>
        <Type>ATR,Fixed</Type>
        <StartProfit min="15" max="25" step="5"/> <!-- pips -->
        <TrailDistance min="8" max="15" step="2"/> <!-- pips -->
        <ATRMultiplier min="1.0" max="2.0" step="0.5"/>
      </TrailingStop>

      <TimeExit>
        <Enabled>true</Enabled>
        <MaxTradeDuration>120</MaxTradeDuration> <!-- minutes (scalping) -->
      </TimeExit>
    </ExitBlocks>

    <!-- POSITION SIZING -->
    <PositionSizing>
      <Method>FixedLots</Method>
      <FixedLots>0.01</FixedLots>
      <MinLots>0.01</MinLots>
      <MaxLots>0.10</MaxLots>
      <RiskPercent>0.25</RiskPercent> <!-- Sync with Symbol_Engine InpRiskBase -->
      <MaxRisk>0.50</MaxRisk>
      <Martingale>false</Martingale>
      <Pyramiding>false</Pyramiding>
      <MaxPositions>1</MaxPositions>
    </PositionSizing>

    <!-- TIME FILTERS -->
    <TimeFilters>
      <SessionFilter>
        <Enabled>true</Enabled>
        <Sessions>
          <Session>
            <Name>LondonOpen</Name>
            <StartTime>07:00</StartTime>
            <EndTime>11:00</EndTime>
            <TimeZone>UTC+0</TimeZone>
            <Priority>High</Priority>
          </Session>
          <Session>
            <Name>NYSession</Name>
            <StartTime>13:00</StartTime>
            <EndTime>17:00</EndTime>
            <TimeZone>UTC+0</TimeZone>
            <Priority>High</Priority>
          </Session>
          <Session>
            <Name>LondonNYOverlap</Name>
            <StartTime>13:00</StartTime>
            <EndTime>16:00</EndTime>
            <TimeZone>UTC+0</TimeZone>
            <Priority>VeryHigh</Priority>
          </Session>
        </Sessions>
        <AvoidSessions>Asian,Weekend,LateEvening</AvoidSessions>
      </SessionFilter>

      <DayOfWeekFilter>
        <Enabled>true</Enabled>
        <AllowedDays>Monday,Tuesday,Wednesday,Thursday</AllowedDays>
        <AvoidDays>Friday,Sunday</AvoidDays>
      </DayOfWeekFilter>

      <NewsFilter>
        <Enabled>true</Enabled>
        <MinutesBefore>30</MinutesBefore>
        <MinutesAfter>30</MinutesAfter>
        <Impact>High,Medium</Impact>
        <Currencies>USD,EUR</Currencies>
      </NewsFilter>
    </TimeFilters>

    <!-- ADVANCED FILTERS -->
    <AdvancedFilters>
      <SpreadFilter>
        <Enabled>true</Enabled>
        <MaxSpread>3.5</MaxSpread> <!-- pips -->
      </SpreadFilter>

      <VolatilityFilter>
        <Enabled>true</Enabled>
        <Method>ATR</Method>
        <MinATR>8</MinATR>
        <MaxATR>50</MaxATR>
      </VolatilityFilter>

      <CorrelationFilter>
        <Enabled>true</Enabled>
        <MaxCorrelation>0.70</MaxCorrelation>
        <CheckSymbols>GBPUSD,USDCHF</CheckSymbols>
      </CorrelationFilter>

      <TrendFilter>
        <Enabled>true</Enabled>
        <Method>EMA</Method>
        <RequireAlignment>true</RequireAlignment>
      </TrendFilter>
    </AdvancedFilters>
  </BuilderSettings>

  <!-- OPTIMIZATION CRITERIA -->
  <OptimizationCriteria>
    <Primary>
      <Metric>ProfitFactor</Metric>
      <MinValue>1.50</MinValue>
      <Weight>40</Weight>
    </Primary>

    <Secondary>
      <Metrics>
        <Metric>
          <Name>WinRate</Name>
          <MinValue>50</MinValue> <!-- % -->
          <Weight>25</Weight>
        </Metric>
        <Metric>
          <Name>MaxDrawdown</Name>
          <MaxValue>15</MaxValue> <!-- % -->
          <Weight>20</Weight>
        </Metric>
        <Metric>
          <Name>SharpeRatio</Name>
          <MinValue>0.80</MinValue>
          <Weight>10</Weight>
        </Metric>
        <Metric>
          <Name>RecoveryFactor</Name>
          <MinValue>2.0</MinValue>
          <Weight>5</Weight>
        </Metric>
      </Metrics>
    </Secondary>

    <Required>
      <MinTrades>200</MinTrades>
      <MaxConsecutiveLosses>6</MaxConsecutiveLosses>
      <MinAvgTrade>2.0</MinAvgTrade> <!-- pips -->
      <MinRiskReward>1.3</MinRiskReward>
      <MaxTimeInDrawdown>30</MaxTimeInDrawdown> <!-- days -->
    </Required>

    <!-- CUSTOM RANKING FORMULA -->
    <RankingFormula>
      (ProfitFactor * WinRate * 100) / MaxDrawdown
    </RankingFormula>

    <SecondaryRanking>
      Expectancy * SharpeRatio
    </SecondaryRanking>
  </OptimizationCriteria>

  <!-- ROBUSTNESS TESTING -->
  <RobustnessTests>
    <WalkForward>
      <Enabled>true</Enabled>
      <Type>Anchored</Type>
      <InSample>70</InSample> <!-- % -->
      <OutSample>30</OutSample> <!-- % -->
      <MinPeriods>10</MinPeriods>
      <ReoptimizationFrequency>90</ReoptimizationFrequency> <!-- days -->
      <PassCriteria>
        <OOSPerformance>80</OOSPerformance> <!-- % of IS -->
        <OOSProfitFactor>1.30</OOSProfitFactor>
        <OOSWinRate>45</OOSWinRate>
      </PassCriteria>
    </WalkForward>

    <MonteCarlo>
      <Enabled>true</Enabled>
      <Runs>1000</Runs>
      <PassRate>90</PassRate> <!-- % -->
      <MaxDDVariation>20</MaxDDVariation> <!-- % -->
      <ConfidenceLevel>95</ConfidenceLevel>
    </MonteCarlo>

    <StressTest>
      <Enabled>true</Enabled>
      <SpreadMultiplier>2.0</SpreadMultiplier>
      <SlippageMultiplier>2.0</SlippageMultiplier>
      <MinPassRate>70</MinPassRate>
    </StressTest>
  </RobustnessTests>

  <!-- STRATEGY VALIDATION -->
  <ValidationRules>
    <OverfittingCheck>
      <MaxParameterChangeSensitivity>15</MaxParameterChangeSensitivity> <!-- % -->
      <RequireRobustness>true</RequireRobustness>
    </OverfittingCheck>

    <LogicValidation>
      <RequireLogicalEntry>true</RequireLogicalEntry>
      <MaxComplexity>Medium</MaxComplexity>
      <AvoidConflictingSignals>true</AvoidConflictingSignals>
    </LogicValidation>

    <StatisticalTests>
      <TTest>true</TTest>
      <MinSignificance>0.05</MinSignificance>
    </StatisticalTests>
  </ValidationRules>

  <!-- EXPORT SETTINGS -->
  <ExportSettings>
    <Platform>MetaTrader5</Platform>
    <CodeGeneration>
      <Template>StandardMT5</Template>
      <IncludeMoneyManagement>false</IncludeMoneyManagement> <!-- Symbol_Engine handles this -->
      <IncludeComments>true</IncludeComments>
      <OptimizationFriendly>true</OptimizationFriendly>
      <CompactCode>true</CompactCode>
    </CodeGeneration>

    <Identification>
      <MagicNumberRange>
        <Start>100001</Start>
        <End>100100</End>
        <AutoIncrement>true</AutoIncrement>
      </MagicNumberRange>
      <CommentPrefix>SQ_FibElliott_</CommentPrefix>
    </Identification>

    <Integration>
      <RiskPerTrade>0.25</RiskPerTrade> <!-- Match InpRiskBase -->
      <MaxPositions>1</MaxPositions>
      <AllowAddOns>false</AllowAddOns> <!-- Symbol_Engine handles pyramiding -->
    </Integration>
  </ExportSettings>

  <!-- PORTFOLIO SETTINGS -->
  <PortfolioSettings>
    <MaxStrategies>5</MaxStrategies>
    <CorrelationLimit>0.65</CorrelationLimit>
    <DiversificationRequired>true</DiversificationRequired>
    <RebalancingFrequency>30</RebalancingFrequency> <!-- days -->

    <PortfolioOptimization>
      <Method>MarkowitzOptimization</Method>
      <MaxPortfolioDD>20</MaxPortfolioDD> <!-- % -->
      <MinPortfolioPF>2.0</MinPortfolioPF>
      <TargetSharpe>1.5</TargetSharpe>
    </PortfolioOptimization>
  </PortfolioSettings>

  <!-- FIBONACCI SPECIFIC SETTINGS -->
  <FibonacciSettings>
    <RetracementLevels>
      <Level>0.236</Level>
      <Level>0.382</Level>
      <Level>0.500</Level>
      <Level>0.618</Level>
      <Level>0.786</Level>
    </RetracementLevels>

    <ExtensionLevels>
      <Level>1.000</Level>
      <Level>1.272</Level>
      <Level>1.618</Level>
      <Level>2.000</Level>
      <Level>2.618</Level>
    </ExtensionLevels>

    <SwingDetection>
      <Method>ZigZag</Method>
      <MinSwingSize>15</MinSwingSize> <!-- pips -->
      <Lookback min="20" max="50" step="10"/>
    </SwingDetection>

    <ZoneTolerance>
      <ATRMultiplier>0.25</ATRMultiplier>
      <MinPips>2</MinPips>
      <MaxPips>8</MaxPips>
    </ZoneTolerance>

    <Confluence>
      <RequireMultipleLevels>false</RequireMultipleLevels>
      <BonusForConfluence>0.5</BonusForConfluence> <!-- points -->
    </Confluence>
  </FibonacciSettings>

  <!-- ELLIOTT WAVE SPECIFIC SETTINGS -->
  <ElliottWaveSettings>
    <WaveDetection>
      <Method>FractalBased</Method>
      <MinWaveSize>15</MinWaveSize> <!-- pips -->
      <MaxWaveSize>100</MaxWaveSize> <!-- pips -->
    </WaveDetection>

    <WaveTypes>
      <Impulse>
        <Enabled>true</Enabled>
        <Waves>1,3,5</Waves>
        <EntryOn>Wave3,Wave5</EntryOn>
        <FibonacciValidation>true</FibonacciValidation>
      </Impulse>

      <Correction>
        <Enabled>true</Enabled>
        <Patterns>ABC,Flat,Triangle</Patterns>
        <EntryOn>WaveC,TriangleBreakout</EntryOn>
      </Correction>
    </WaveTypes>

    <Validation>
      <RequireFibonacciAlignment>true</RequireFibonacciAlignment>
      <RequireVolumeConfirmation>false</RequireVolumeConfirmation>
      <MinWaveClarity>0.70</MinWaveClarity>
    </Validation>
  </ElliottWaveSettings>

  <!-- LOGGING AND MONITORING -->
  <Logging>
    <DetailLevel>Detailed</DetailLevel>
    <SaveTradeLog>true</SaveTradeLog>
    <SaveEquityCurve>true</SaveEquityCurve>
    <SaveOptimizationResults>true</SaveOptimizationResults>
    <ExportToCSV>true</ExportToCSV>
  </Logging>

  <!-- PERFORMANCE TARGETS -->
  <PerformanceTargets>
    <Daily>
      <MinTrades>2</MinTrades>
      <MaxTrades>10</MaxTrades>
      <TargetProfit>20</TargetProfit> <!-- pips -->
      <MaxLoss>-30</MaxLoss> <!-- pips -->
    </Daily>

    <Weekly>
      <MinTrades>10</MinTrades>
      <TargetProfit>100</TargetProfit> <!-- pips -->
      <MaxDrawdown>10</MaxDrawdown> <!-- % -->
    </Weekly>

    <Monthly>
      <MinTrades>40</MinTrades>
      <TargetProfit>400</TargetProfit> <!-- pips -->
      <TargetReturn>5</TargetReturn> <!-- % -->
    </Monthly>
  </PerformanceTargets>

</StrategyQuantProject>
