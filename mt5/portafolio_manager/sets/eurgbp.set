; EURGBP - Euro Pound Cross - European Majors Differential
; Low volatility, ranging tendency
; Best Performance: European session, central bank divergence
; Risk Profile: Conservative - low volatility
; Target: Win Rate 66-74%, Profit Factor 1.9+
; Correlation: Low with USD pairs, pure European dynamic

; ====== IDENTITY ======
InpMagicNumber=100012
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; European session focused
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
; Tight zones for low volatility
InpSwingLookback=26
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.15

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.0
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=43
InpRSI_Overbought=57
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.08

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.68
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.3
InpAddOn2_R=2.3
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.58
InpRiskAddOn1=0.33
InpRiskAddOn2=0.23

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.4
InpPartialClosePercent=48.0
InpBE_Threshold_R=1.0
InpTrailStart_R=1.8
InpTrailATR_Mult=0.95

; ====== SPREAD ======
InpMaxSpreadPoints=14

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=26
InpSMC_MinImpulseATR=1.7
InpSMC_MinFVG_ATR=0.42

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=35
InpNewsMinutesAfter=30

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.52
InpDailyMaxDD=3.2
InpWeeklyMaxDD=6.3

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
