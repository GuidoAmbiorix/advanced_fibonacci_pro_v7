; EURCHF - H4 - CONSERVATIVE LIVE SET
; PURPOSE: Real account / live trading. Capital preservation first.

InpMagicNumber=100007
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpCloseOnKillzoneEnd=false
InpKZBEMinutesBefore=15
InpKZBEMinProfitR=0.1
InpNotifyKillzoneOpen=true

;═══════ MOMENTUM EXIT ═══════
InpUseMomentumExit=true
InpMomADX_Period=14
InpMomADX_Threshold=25.0
InpMomATR_CollapseRatio=0.55
InpMomBarsNoProgress=8
InpMomProgressATR=0.3
InpMomSignalsToExit=3
InpMomRecoveryMinScore=2

;═══════ FIBONACCI ═══════
InpSwingLookback=20
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.0
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=45
InpRSI_Overbought=55
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.1

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.70
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=16
InpDominanceThreshold=2.0
InpMaxPositions=1

;═══════ RISK ═══════
InpRiskBase=1.0
InpMaxRisk=1.0
InpMaxLotsPerTrade=2.0
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=2.0
InpMaxTP_R=5.0
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.5

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=4.0
InpMaxVolatilityFactor=2.5
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING ═══════
InpPartialTP_R=1.0
InpPartialClosePercent=50.0
InpBE_Threshold_R=0.7
InpTrailStart_R=0.8
InpTrailATR_Mult=1.5
InpTrailDecayRate=0.20
InpTrailMinMult=0.50
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.35

;═══════ INFINITE ESCALATOR ═══════
InpEsc_FirstR=0.5
InpEsc_FirstSL_R=-0.05
InpEsc_StepR=0.7
InpEsc_GrowthFactor=1.2
InpEsc_BaseHarvest=25.0
InpEsc_HarvestDecay=0.80
InpEsc_MinHarvest=5.0
InpEsc_MaxStages=10
InpRunnerTrailTight=0.70
InpTimeStaleMins=200.0
InpTimeStaleTight1=0.75
InpTimeStaleTight2=0.60

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=2
InpPyr_MinProfitR=1.5
InpAgg_MaxTotalRisk=1.0
InpAgg_MaxPositions=1

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.05
InpRegimeHarvest=true
InpMFECalibration=false
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ STALE TRADE EXIT ═══════
InpUseStaleTrade=true
InpStaleBarLimit=6

;═══════ SPREAD ═══════
InpMaxSpreadPoints=25

;═══════ SMC - SMART MONEY CONCEPTS ═══════
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=1.8
InpSMC_MinFVG_ATR=0.4

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=2.5
InpVolatilitySpikeCooldown=45

;═══════ KELLY POSITION SIZING ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=2.0
InpWeeklyMaxDD=4.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=2.0
InpLossCooldownMinutes=60
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=3
InpUseReversalFilter=true
InpReversalCooldownMinutes=90

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=1
InpTradeCooldownMinutes=60
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ GOVERNOR ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=5.0
InpGov_DD_Pause=10.0
InpGov_ReducedMult=0.5
InpGov_DailyMaxDD=3.0

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=30
