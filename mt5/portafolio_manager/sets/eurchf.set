; EURCHF - Euro Swiss Franc Cross
; Low volatility, SNB intervention history
; Best Performance: European session
; Risk Profile: Very Conservative - SNB floor memories
; Target: Win Rate 64-72%, Profit Factor 1.8+
; Correlation: Safe haven dynamics, ECB-SNB policy

; ====== IDENTITY ======
InpMagicNumber=100014
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; European session only
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
; Very tight zones
InpSwingLookback=27
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.13

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=0.95
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=44
InpRSI_Overbought=56
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.07

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.66
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.2
InpAddOn2_R=2.1
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
; Very conservative due to SNB risk
InpRiskBase=0.38
InpRiskAddOn1=0.22
InpRiskAddOn2=0.14

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.3
InpPartialClosePercent=50.0
InpBE_Threshold_R=0.9
InpTrailStart_R=1.7
InpTrailATR_Mult=0.90

; ====== SPREAD ======
InpMaxSpreadPoints=16

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=27
InpSMC_MinImpulseATR=1.6
InpSMC_MinFVG_ATR=0.40

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Critical for SNB announcements
InpUseNewsFilter=true
InpNewsMinutesBefore=70
InpNewsMinutesAfter=60

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.38
InpDailyMaxDD=2.5
InpWeeklyMaxDD=5.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
