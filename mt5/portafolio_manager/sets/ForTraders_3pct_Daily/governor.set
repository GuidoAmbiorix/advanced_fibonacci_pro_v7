; Optimized for 6 assets: EURUSD, GBPUSD, USDJPY, XAUUSD, GBPJPY, USTEC
; Account: ForTraders Challenge (3% Daily DD)
; Strategy: Dynamic Draft Portfolio with Correlation Guard

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=2.5
; Max Total Portfolio Risk (%) - ForTraders Hard Cap
; Allows up to 4 simultaneous trades at 0.6% risk

InpMaxSymbolRisk=1.2
; Max Risk Per Symbol (%)
; Reduced to 1.2% (Entry 0.6% + Add-on 0.6%)

InpMaxGroupRisk=2.0
; Max Risk Per Correlation Group (%)
; Reduced to 2.0%

;═══════ DRAWDOWN GOVERNOR ═══════
InpDD_Normal=2.0
; DD Level: Normal Trading (%) - Start risk reduction
; Triggers at 2.0%

InpDD_Reduced=2.5
; DD Level: Reduced Risk (%)
; Strict reduction as we approach 3% daily limit

InpDD_Pause=2.9
; DD Level: Pause Trading (%) - HARD STOP
; MUST be below 3.0% (ForTraders Daily Limit)
; Stops all new trades at 2.9% drawdown

InpDD_ReducedMult=0.50
; Risk Multiplier when DD > Normal
; Aggressive reduction (50%) to prevent breach

;═══════ ROLLING PF GOVERNOR ═══════
InpRollingTrades=20
; Rolling Window (trades)

InpPF_Normal=1.3
; PF Level: Normal Trading

InpPF_Reduced=1.15
; PF Level: Reduced Risk

InpPF_Pause=0.95
; PF Level: Pause Trading

InpPF_ReducedMult=0.70
; Risk Mult when PF < Normal

;═══════ DAILY/WEEKLY LIMITS ═══════
InpDailyMaxDD=2.9
; Daily Max Drawdown (%)
; ForTraders Limit is 3.0% - Set to 2.9% for safety

InpWeeklyMaxDD=4.0
; Weekly Max Drawdown (%)

InpMonthlyMaxDD=4.9
; Monthly Max Drawdown (%)
; ForTraders Limit is 5.0%

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=true
InpHighCorrelation=0.70
InpCorrelationReduction=0.50

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
InpMagicRange=999

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=5
