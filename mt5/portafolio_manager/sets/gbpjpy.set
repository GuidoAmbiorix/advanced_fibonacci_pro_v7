; GBPJPY - M5 Volatility Scalper
; High frequency volatility capture for Portfolio Governor System
; Best Timeframe: H1 (Primary), H4 (Bias/Confirmation)
; Best Performance: London session (GBP) + Tokyo overlap (explosive volatility)
; Risk Profile: Aggressive - wider stops required, 200+ pip daily range
; Target: Win Rate 60-70%, Profit Factor 2.4+
; Correlation: Low to EURUSD, combines GBP volatility + JPY safe haven
; Characteristics: Massive intraday swings, deep liquidity sweeps, risk-on/risk-off indicator

; ====== IDENTITY ======
InpMagicNumber=100005

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; GBPJPY explosive during London session
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=true

; ====== FIBONACCI ======
; Tighter lookback for M5 volatility capture
InpSwingLookback=12
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.35

; ====== DISPLACEMENT ======
; Strong displacement very common in GBPJPY
InpUseDisplacement=true
InpDisplacementATR=1.8
InpDisplacementLookback=4

; ====== RSI ======
; Very wide RSI bands for extreme volatility
InpRSI_Period=14
InpRSI_Oversold=30
InpRSI_Overbought=70
InpRSI_Momentum=true

; ====== TREND ======
; Powerful trends - highest slope requirement
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.20

; ====== CHOP FILTER ======
; Highest threshold to avoid choppy sessions
InpUseChopFilter=true
InpChopThreshold=0.88
InpATR_MA_Period=20

; ====== CONFLUENCE ======
; OPTIMIZED: Standard Score 4.0 for M5 Scalping
InpMinConfluenceEntry=4
InpEnableAddOns=false
InpAddOn1_R=2.5
InpAddOn2_R=4.0
InpMaxPositions=1

; ====== RISK (Before Governor Scaling) ======
; LOWER base risk due to extreme volatility and wider stops
InpRiskBase=0.15
InpRiskAddOn1=0.10
InpRiskAddOn2=0.06
InpMaxRisk=0.45
InpMaxLotsPerTrade=0.5
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
; M5 Volatile Scalping TP (Runs further than EURUSD)
InpTPMode=2
InpFixedTP_R=2.5
InpMinTP_R=1.5
InpMaxTP_R=5.0
InpTPUseLearnedMFE=true

; ====== EXIT ======
; Wider targets for trending explosive nature
InpTrailingMode=1
InpPartialTP_R=1.5
InpPartialClosePercent=38.0
InpBE_Threshold_R=1.5
InpTrailStart_R=2.0
InpTrailATR_Mult=1.4

; ====== SPREAD ======
; Relaxed spread for volatile cross execution
InpMaxSpreadPoints=28

; ====== SMC - SMART MONEY CONCEPTS ======
; Critical for GBPJPY - massive liquidity sweeps
; M5 Structure Settings
InpUseSMC=true
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.8
InpSMC_MinFVG_ATR=0.65

; ====== MULTI-TIMEFRAME ======
; H4 bias critical for GBPJPY volatility
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; CRITICAL - GBP and JPY news cause explosive moves
InpUseNewsFilter=true
InpNewsMinutesBefore=50
InpNewsMinutesAfter=50

; ====== KELLY POSITION SIZING ======
; Very conservative Kelly for high volatility
InpUseKelly=true
InpKellyFraction=0.20
InpDailyMaxDD=1.8
InpWeeklyMaxDD=3.5

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR ======
; UPDATED: Active M5 Scalping (3 trades per session)
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpMaxProfitPerSession_R=7.0
InpMaxLossPerSession_R=2.0
InpMinSessionConfidence=0.5
InpTradeCooldownMinutes=15
InpEnableSessionBlacklist=true

; ====== PORTFOLIO PROTECTION ======
; Strict protection for volatile cross
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=2.5
InpLossCooldownMinutes=60
InpMaxConsecutiveLosses=2
InpUseReversalFilter=true

; ====== RISK (Before Governor Scaling) ======
; InpRiskBase updated to 0.50 (Aggressive)
InpRiskBase=0.50
