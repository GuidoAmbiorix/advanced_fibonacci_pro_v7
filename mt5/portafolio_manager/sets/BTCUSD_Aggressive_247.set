; BTCUSD Aggressive 24/7 Set File
; Strategy: Hit & Run (Managed by Portfolio Governor)
; ---------------------------------------

; Identity
InpMagicNumber=100100
InpEnableMobileAlerts=true

; Direction
InpDirection=0

; Risk (Aggressive - Governor handles the hard stop)
InpRiskBase=1.0
InpRiskAddOn1=0.5
InpRiskAddOn2=0.5
InpMaxRisk=5.0
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=true

; Confluence (Lower threshold for more activity)
InpMinConfluenceEntry=8
InpEnableAddOns=true

; Trend (Faster for Crypto)
InpEMA_Period=50
InpUseTrendFilter=true

; SMC
InpUseSMC=true
InpSMC_SwingLookback=20

; 24/7 Mode (Disable Sessions & Killzones)
InpUseSessionGovernor=false
InpUseKillzoneFilter=false
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=false
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false

; News (Disable for Crypto 24/7)
InpUseNewsFilter=false

; Portfolio Protection (Looser, let Governor decide)
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=20.0
InpMaxConsecutiveLosses=5
InpUseReversalFilter=true
InpReversalCooldownMinutes=15

; Kelly (Disable to ensure fixed aggressive risk)
InpUseKelly=false

; Take Profit & Exit
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=1.5
InpMaxTP_R=10.0
InpTrailingMode=1
InpTrailStart_R=1.5
InpTrailATR_Mult=1.5
