; CHFJPY - Swiss Franc Yen Cross - Double Safe Haven
; Low volatility, safe haven pair
; Best Performance: European and Asian sessions
; Risk Profile: Conservative - dual safe havens
; Target: Win Rate 64-72%, Profit Factor 1.9+
; Correlation: Risk-off flows, central bank policies

; ====== IDENTITY ======
InpMagicNumber=100017
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; European and Asian sessions
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=true
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
InpSwingLookback=24
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.19

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.1
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=41
InpRSI_Overbought=59
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.09

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.71
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.5
InpAddOn2_R=2.6
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.52
InpRiskAddOn1=0.30
InpRiskAddOn2=0.20

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.5
InpPartialClosePercent=46.0
InpBE_Threshold_R=1.1
InpTrailStart_R=2.0
InpTrailATR_Mult=1.05

; ====== SPREAD ======
InpMaxSpreadPoints=20

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=24
InpSMC_MinImpulseATR=1.9
InpSMC_MinFVG_ATR=0.47

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=50
InpNewsMinutesAfter=45

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.48
InpDailyMaxDD=3.0
InpWeeklyMaxDD=5.9

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
