; AUDUSD (Aussie) - Commodity/Risk Currency
; Enhanced with SMC (Smart Money Concepts) for Institutional-Level Trading
; Best Performance: Asian/Early London, Risk-on sentiment, China data
; Risk Profile: Moderate - commodity currency sensitivity
; Target: Win Rate 65-72%, Profit Factor 2.0+
; Correlation: +0.60 with XAUUSD (commodity), +0.87 with NZDUSD, Risk barometer

InpMagicNumber=100005
InpDirection=0
InpBrokerUTCOffset=2

; ====== SESSION CONFIGURATION ======
; AUD active Asian -> London transition
; China/Australia data releases drive early moves
InpSessionFilter=1
InpLondonStart=6
InpLondonEnd=15
InpNYStart=13
InpNYEnd=19

; ====== FIBONACCI ZONES ======
; Medium zones - AUD respects technicals well
; Clean price action during Asian session
InpSwingLookback=22
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.22

; ====== DISPLACEMENT FILTER ======
; Moderate filter - AUD can move on risk sentiment shifts
InpUseDisplacement=true
InpDisplacementATR=1.3
InpDisplacementLookback=5

; ====== RSI CONFIGURATION ======
; Standard bands - AUD trends with risk sentiment
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND FILTER ======
; Moderate slope - AUD follows commodity/risk cycles
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.10

; ====== CHOP FILTER ======
; Standard volatility filter
InpUseChopFilter=true
InpChopThreshold=0.72
InpATR_MA_Period=20

; ====== CONFLUENCE SYSTEM ======
; Standard threshold for commodity pair
InpMinConfluenceEntry=5.0
InpEnableAddOns=true
InpAddOn1_R=1.6
InpAddOn2_R=2.8
InpMaxPositions=3

; ====== RISK MANAGEMENT ======
; Moderate risk - can gap on China data
InpRiskBase=0.50
InpRiskAddOn1=0.28
InpRiskAddOn2=0.18

; ====== EXIT STRATEGY ======
; Balanced targets for trending/ranging
InpTrailingMode=1
InpPartialTP_R=1.6
InpPartialClosePercent=45.0
InpBE_Threshold_R=1.2
InpTrailStart_R=2.2
InpTrailATR_Mult=1.2

; ====== SPREAD FILTER ======
; Medium spread tolerance
InpMaxSpreadPoints=18

; ====== SMC - SMART MONEY CONCEPTS ======
; Full SMC suite - AUD has clean institutional flows
InpUseSMC=true
InpSMC_SwingLookback=22
InpSMC_MinImpulseATR=2.2
InpSMC_MinFVG_ATR=0.50

; ====== MULTI-TIMEFRAME ANALYSIS ======
; H4 bias, H1 confirmation
; Risk sentiment visible on HTF
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Important for AUD - RBA decisions, China PMI
; Standard buffer sufficient
InpUseNewsFilter=true
InpNewsMinutesBefore=35
InpNewsMinutesAfter=30

; ====== SESSION OPTIMIZER ======
; Include Asian session - AUD primary session
; Best during Asian-London overlap
InpUseSessionFilter=true
InpSkipAsianSession=false
InpFocusOverlapOnly=false

; ====== KELLY POSITION SIZING ======
; Half-Kelly for safe scaling
InpUseKelly=true
InpKellyFraction=0.5
InpDailyMaxDD=2.8
InpWeeklyMaxDD=5.5
