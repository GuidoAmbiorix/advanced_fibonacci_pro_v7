; AUDUSD - M5 Range Scalper
; Commodity-linked pair - Optimized for Portfolio Governor System
; Best Timeframe: H1 (Primary), H4 (Bias/Confirmation)
; Best Performance: Asian session (China data) + NY session (USD data)
; Risk Profile: Moderate - commodity volatility, China sensitivity
; Target: Win Rate 64-74%, Profit Factor 2.1+
; Correlation: Low to EURUSD (~0.3), inverse to USDCAD, risk-on indicator
; Characteristics: China data sensitive, commodity cycles, clean trends during risk-on

; ====== IDENTITY ======
InpMagicNumber=100006

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; AUD most active during Asian and NY sessions
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
; Tighter lookback for M5 precision
InpSwingLookback=12
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.22

; ====== DISPLACEMENT ======
; Moderate displacement during commodity moves
InpUseDisplacement=true
InpDisplacementATR=1.4
InpDisplacementLookback=5

; ====== RSI ======
; Fast RSI for M5 Momentum
InpRSI_Period=9
InpRSI_Oversold=38
InpRSI_Overbought=62
InpRSI_Momentum=true

; ====== TREND ======
; Good trends during risk-on periods
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.11

; ====== CHOP FILTER ======
; Moderate threshold for commodity volatility
InpUseChopFilter=true
InpChopThreshold=0.76
InpATR_MA_Period=20

; ====== CONFLUENCE ======
; OPTIMIZED: Standard Score 4.0 for M5 Scalping
InpMinConfluenceEntry=4
InpEnableAddOns=false
InpAddOn1_R=1.8
InpAddOn2_R=3.0
InpMaxPositions=1

; ====== RISK (Before Governor Scaling) ======
; Moderate base for commodity pair
InpRiskBase=0.18
InpRiskAddOn1=0.12
InpRiskAddOn2=0.08
InpMaxRisk=0.50
InpMaxLotsPerTrade=0.5
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
; M5 Range Scalping TP
InpTPMode=2
InpFixedTP_R=1.8
InpMinTP_R=1.1
InpMaxTP_R=3.0
InpTPUseLearnedMFE=true

; ====== EXIT ======
; Moderate targets for commodity trends
InpTrailingMode=1
InpPartialTP_R=1.1
InpPartialClosePercent=40.0
InpBE_Threshold_R=1.2
InpTrailStart_R=1.5
InpTrailATR_Mult=1.2

; ====== SPREAD ======
; Relaxed spread for M5 execution
InpMaxSpreadPoints=20

; ====== SMC - SMART MONEY CONCEPTS ======
; Good for AUD - respects institutional levels
; M5 Structure Settings
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.1
InpSMC_MinFVG_ATR=0.52

; ====== MULTI-TIMEFRAME ======
; H4 bias for commodity cycles
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Filter Australian and Chinese economic data
InpUseNewsFilter=true
InpNewsMinutesBefore=35
InpNewsMinutesAfter=35

; ====== KELLY POSITION SIZING ======
; Conservative Quarter Kelly
InpUseKelly=true
InpKellyFraction=0.25
InpDailyMaxDD=2.0
InpWeeklyMaxDD=4.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR ======
; UPDATED: Active M5 Scalping (3 trades per session)
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpMaxProfitPerSession_R=5.0
InpMaxLossPerSession_R=1.5
InpMinSessionConfidence=0.5
InpTradeCooldownMinutes=15
InpEnableSessionBlacklist=true

; ====== PORTFOLIO PROTECTION ======
; Correlation filter and circuit breaker
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=45
