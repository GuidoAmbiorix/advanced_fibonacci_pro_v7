; GBPJPY - H1 Timeframe "The Beast"
; High Volatility Specialist
; Optimized for wide swings and strong momentum

; ====== IDENTITY ======
InpMagicNumber=100004
InpEnableMobileAlerts=true
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
InpUseKillzoneFilter=true
InpEnableAsianKZ=true
; GBPJPY moves in Asia too (Tokyo)
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=true

; ====== FIBONACCI (Wider Tolerance) ======
InpSwingLookback=10
; Increased lookback for major swing points
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.30
; Wider tolerance for volatile wicks

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.5
; Higher threshold for valid breakout
InpDisplacementLookback=3

; ====== RSI ======
InpRSI_Period=14
; Slower RSI to filter noise
InpRSI_Oversold=30
InpRSI_Overbought=70
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.15
; Steeper slope required

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.60
; Strict chop filter, GJ chops hard
InpATR_MA_Period=14

; ====== CONFLUENCE ======
InpMinConfluenceEntry=14
; H1: Increased from 11 to 12 for better quality signals on cleaner timeframe
InpEnableAddOns=false
InpAddOn1_R=1.5
InpAddOn2_R=2.8
InpMaxPositions=1

; ====== RISK ======
InpRiskBase=0.5
; $50 Risk (FundingPips)
InpMaxRisk=1.0
InpMaxLotsPerTrade=0.03
InpEnableMarginCheck=true

; ====== TAKE PROFIT (Aggressive Targets) ======
InpTPMode=2
InpFixedTP_R=4.0
; Aiming for 4R runs
InpMinTP_R=2.0
InpMaxTP_R=8.0
InpTPUseLearnedMFE=true

; ====== EXIT (Wide Trailing) ======
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.5
InpMinVolatilityPips=10.0
InpMaxVolatilityFactor=4.0
InpVolatilityTP_Mult=4.0
InpPartialTP_R=1.0
; Secure quick 1R
InpPartialClosePercent=50.0
; Bank 50%, run the rest
InpBE_Threshold_R=0.8
; GBPJPY: Slightly later activation (needs room)
InpTrailStart_R=0.8
InpTrailATR_Mult=1.8
; GBPJPY: Wide base (most volatile forex pair)
InpTrailDecayRate=0.20
; Slow decay - let GBPJPY trends run
InpTrailMinMult=0.60
; Higher floor (volatile pair needs buffer)
InpTrailRegimeAware=true

; ====== SPREAD ======
InpMaxSpreadPoints=80
; Higher spread tolerance for Cross

; ====== SMC ======
InpUseSMC=true
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.5
InpSMC_MinFVG_ATR=1.0

; ====== MTF ======
InpUseMTF=true
InpHTF=16388
InpMTF=16386
InpMTF_EMAPeriod=50

; ====== NEWS ======
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30
; Longer avoidance window

; ====== KELLY ======
InpUseKelly=true
InpKellyFraction=0.25
InpDailyMaxDD=0.8
InpWeeklyMaxDD=1.5
InpDailyTarget=0.4

; ====== LEARNING ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR ======
InpUseSessionGovernor=true
InpMaxTradesPerSession=10
InpTradeCooldownMinutes=10

; ====== PORTFOLIO PROTECTION ======
InpUseCorrelationFilter=false
; Governor Draft System handles correlation ranking
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=120
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=5
; Max 5 trades per day (prevent overtrading)
InpUseReversalFilter=true
