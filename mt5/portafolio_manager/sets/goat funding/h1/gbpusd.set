; GBPUSD - H1 Timeframe Institutional Flow
; Core Major - Volatile
; Optimized for H1 timeframe (reduced noise, cleaner signals)

; ====== IDENTITY ======
InpMagicNumber=100002

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

; ====== FIBONACCI ======
InpSwingLookback=8
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.5
InpDisplacementLookback=3

; ====== RSI ======
InpRSI_Period=9
InpRSI_Oversold=35
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.15

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=14
; H1: Increased to 13 for GBPUSD (more volatile, needs stricter filter)
InpEnableAddOns=false
InpAddOn1_R=1.5
InpAddOn2_R=2.8
InpMaxPositions=1

; ====== RISK ======
InpRiskBase=0.5
; 0.5% base risk on $2500 account
InpMaxRisk=1.0
InpMaxLotsPerTrade=0.03
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
InpTPMode=2
InpFixedTP_R=3.5
; H1: GBPUSD moves bigger - increased from 2.5R to 3.5R
InpMinTP_R=2.0
; H1: Increased from 1.0R to 2.0R (GBPUSD volatile, need min 2R)
InpMaxTP_R=6.0
; H1: Increased from 3.5R to 6.0R (GBPUSD can trend hard on H1)
InpTPUseLearnedMFE=true

; ====== EXIT ======
InpTrailingMode=1
InpTrailType=1            ; 1=Chandelier
InpTrailStepATR=0.5       ; Step size (if Type=2)
InpMinVolatilityPips=8.0  ; Avoid dead zones (Volatile Pair)
InpMaxVolatilityFactor=3.0; Avoid crashes
InpVolatilityTP_Mult=4.0  ; Dynamic Target (Volatile Pair)
InpTPMode=4               ; Use Volatility TP
InpPartialTP_R=1.0
; Take 1.0R for quick secure (volatile)
InpPartialClosePercent=50.0
; Bank 50% immediately, 50% runs
InpBE_Threshold_R=0.6
; Dynamic trail activates at 0.6R
InpTrailStart_R=0.6
InpTrailATR_Mult=1.6
; GBPUSD: Slightly wider (more volatile than EURUSD)
InpTrailDecayRate=0.25
; Slower decay - GBPUSD needs more room
InpTrailMinMult=0.50
InpTrailRegimeAware=true

; ====== SPREAD ======
InpMaxSpreadPoints=80
; H1: Increased from 60 to 80 (avoid rejected entries during volatility)

; ====== SMC ======
InpUseSMC=true
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.5
InpSMC_MinFVG_ATR=0.50

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
; H1 chart uses H4 (16388) for higher timeframe context
InpMTF=16386
; H1: Changed from M15 (16385) to H1 (16386) - PRIMARY TIMEFRAME
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=15
InpNewsMinutesAfter=15

; ====== KELLY ======
InpUseKelly=true
InpKellyFraction=0.25
InpDailyMaxDD=0.8
InpWeeklyMaxDD=1.5
InpDailyTarget=0.4

; ====== LEARNING ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR (DISABLED FOR 24h) ======
InpUseSessionGovernor=true
InpMaxTradesPerSession=10
InpTradeCooldownMinutes=10
InpEnableSessionBlacklist=false

; ====== PORTFOLIO PROTECTION ======
InpUseCorrelationFilter=false
; Governor Draft System handles correlation ranking
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=90
; H1: Increased from 45 to 90 minutes (bug fix - consecutive loss protection)
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=5
; Max 5 trades per day (prevent overtrading)
InpUseReversalFilter=true
