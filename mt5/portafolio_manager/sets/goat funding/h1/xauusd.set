
; XAUUSD (GOLD) - H1 Timeframe - HYPER-AGGRESSIVE SCALPING + METALS ANALYSIS
; Goat Funding - $80 Max DD | $20 Risk/trade
; STRATEGY: Lower confluence (14) = More signals, Micro-profit taking (0.25R)
; NEW: DXY correlation, safe-haven flow detection, volatility regime filtering
; EXAMPLE: SL=-$11 → Take 75% profit at +$2.75, trail remaining 25% tight
InpMagicNumber=100008
InpDirection=0
InpBrokerUTCOffset=2
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpSwingLookback=20
; Gold trends longer - increased from 16
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.15
InpUseDisplacement=false
InpDisplacementATR=0.0
InpDisplacementLookback=3
InpRSI_Period=14
InpRSI_Oversold=30
InpRSI_Overbought=70
InpRSI_Momentum=true
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.15
InpUseChopFilter=true
InpChopThreshold=0.60
InpATR_MA_Period=20
InpMinConfluenceEntry=14
; STRATEGY: More signals + micro-profit scalping (0.25R = ~$3 profit on $11 SL)
InpEnableAddOns=false
InpMaxPositions=1
InpRiskBase=1.0
InpMaxRisk=1.0
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=true
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=1.5
InpMaxTP_R=6.0
InpTPUseLearnedMFE=true
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.5
InpMinVolatilityPips=50.0
; Gold minimum volatility is 10x higher (50 vs 5 pips)
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=3.0
InpPartialTP_R=0.25
; HYPER-AGGRESSIVE: Close 75% at 0.25R (~$2.75 profit on $11 SL)
InpPartialClosePercent=75.0
; Close 75% of position, let 25% run with tight trailing
InpBE_Threshold_R=0.2
; Move SL to breakeven at +$2.20 (20% of risk)
InpTrailStart_R=0.2
; Start trailing immediately at +$2.20
InpTrailATR_Mult=0.5
; TIGHT trailing (0.5 ATR - very aggressive, locks in tiny profits)
InpTrailDecayRate=0.15
InpTrailMinMult=0.50
InpTrailRegimeAware=true
InpMaxSpreadPoints=100
; Gold spreads can be 20-100 points (vs 50 for forex)
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=2.5
InpSMC_MinFVG_ATR=0.5
InpUseMTF=true
InpHTF=16408
; H4 timeframe
InpMTF=16388
; H1 timeframe (same as chart)
InpUseNewsFilter=true
InpNewsMinutesBefore=60
InpNewsMinutesAfter=60
InpEnableVolatilityFilter=true
InpVolatilityThreshold=4.0
InpVolatilitySpikeCooldown=15
InpUseKelly=true
InpKellyFraction=1.0
InpDailyMaxDD=20.0
InpWeeklyMaxDD=20.0
InpDailyTarget=0.0
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=true
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=20.0
InpLossCooldownMinutes=90
InpMaxConsecutiveLosses=1
InpMaxDailyTrades=5
; INCREASED: Scalping strategy = more frequent trades
InpUseReversalFilter=true
InpReversalCooldownMinutes=15
InpUseSessionGovernor=true
InpMaxTradesPerSession=1
InpTradeCooldownMinutes=120
InpEnableVisualLevels=true
