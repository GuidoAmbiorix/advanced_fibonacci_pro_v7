; 🪙 XAUUSD - H1 Timeframe Metals Optimized
; Metals Engine - XAUUSD Specialized Configuration
; Session-aware + Spread filtering + News protection

; ====== IDENTITY ======
InpMagicNumber=400011
InpEnableMobileAlerts=true

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
; Metals: Disable Asian session (low liquidity, high spread)
InpEnableLondonOpenKZ=true
; Metals: Prime London-NY overlap is optimal
InpEnableNYKZ=true
; Metals: US session active
InpEnableLondonCloseKZ=false
InpNotifyKillzoneOpen=true

; ====== FIBONACCI ======
InpSwingLookback=30
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=45
InpRSI_Overbought=55
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.1

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=11.0
; Metals: Set to 13 for production
InpEnableAddOns=true
InpAddOn1_R=1.5
InpAddOn2_R=2.5
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.30
; FundingPips: 0.50 = $25 risk per trade (0.5% of $5K)
InpRiskAddOn1=0.25
InpRiskAddOn2=0.15
InpMaxRisk=0.60
; FundingPips: 0.75 = $37.50 max risk (0.75% of $5K)
InpMaxLotsPerTrade=0.01
; $2500 account: strict 0.01 lot size for XAUUSD (goat firm request)
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
InpTPMode=2
; Adaptive TP mode
InpFixedTP_R=3.0
InpMinTP_R=1.5
InpMaxTP_R=5.0
InpTPUseLearnedMFE=true

; ====== EXIT ======
InpTrailingMode=1
; Runner mode
InpTrailType=1
; Chandelier Exit
InpTrailStepATR=0.5
InpMinVolatilityPips=5.0
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=3.0
InpPartialTP_R=1.0
; Take 50% quickly to secure profit at 1R
InpPartialClosePercent=50.0
; Close 50% and keep runner
InpBE_Threshold_R=1.0
; XAUUSD: Activate at 1.0R (gold needs more room early)
InpTrailStart_R=1.0
InpTrailATR_Mult=3.5
; XAUUSD: Very wide base (ATR=$8-15, massive swings)
InpTrailDecayRate=0.10
; Very slow decay - let gold runners run far
InpTrailMinMult=0.60
; Higher floor (gold spikes need buffer)
InpTrailRegimeAware=true

; ====== SPREAD ======
InpMaxSpreadPoints=50
InpMetals_MaxSpreadUSD=1.0
; Metals: Session-dependent spread filter (max 1.0 USD in prime time)

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=2.0
InpSMC_MinFVG_ATR=0.5

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
; H4
InpMTF=16385
; H1
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=60
; Metals: 1-hour blackout before news (increased from 30 min)
InpNewsMinutesAfter=60
; Metals: 1-hour blackout after news (increased from 30 min)

; ====== VOLATILITY SPIKE PROTECTION ======
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
; 3x ATR spike detection
InpVolatilitySpikeCooldown=15
; 15-minute cooldown after spike

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.5
; Half-Kelly for safety
InpDailyMaxDD=0.8
; Daily max drawdown 0.8% ($20 limit)
InpWeeklyMaxDD=1.5
; Weekly max drawdown 1.5%
InpDailyTarget=0.4
; 0.4% target ($10 for Consistency Rule)

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
; 180 days of history
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
; Temporarily disabled for testing

; ====== PORTFOLIO PROTECTION ======
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=4.0
; Circuit breaker at -4R daily loss
InpLossCooldownMinutes=30
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=5
; Max 5 trades per day (prevent overtrading)
InpUseReversalFilter=true
InpReversalCooldownMinutes=15

; ====== SESSION GOVERNOR ======
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpTradeCooldownMinutes=30
