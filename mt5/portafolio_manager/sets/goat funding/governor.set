; Portfolio Governor - Goat Funded Trading Instant Pro
; Account: $2,500 - 7 Symbols Forex (sin XAUUSD)
; Strategy: Dynamic Draft Portfolio with Correlation Guard
; Risk: $20/trade | Max DD: $80 total | Sin daily DD limit

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=1.6
; Max Total Portfolio Risk (%)
; Permite hasta 2 trades de $20 simultáneos (1.6% × $2500 = $40).

InpMaxSymbolRisk=0.8
; Max Risk Per Symbol (%)
; Exactamente 1 trade de $20 por símbolo (0.8% × $2500 = $20).

InpMaxGroupRisk=1.6
; Max Risk Per Correlation Group (%)
; Máximo 2 trades correlacionados de $20 = $40.

;═══════ DRAWDOWN GOVERNOR ═══════
InpDD_Normal=1.0
; DD Level: Normal Trading (%)
; Reducir riesgo al llegar a $25 DD (~1.25 trades de $20)

InpDD_Reduced=1.6
; DD Level: Reduced Risk (%)
; $40 → cortar riesgo al 50% (2 trades perdedores de $20)

InpDD_Pause=2.4
; DD Level: Pause Trading (%) - HARD STOP
; $60 → para bien antes del límite de $80

InpDD_ReducedMult=0.50
; Risk Multiplier
; 50% cut when underwater.

;═══════ ROLLING PF GOVERNOR ═══════
InpRollingTrades=20
; Rolling Window (trades)

InpPF_Normal=1.3
; Target: Win $1.30 for every $1 lost

InpPF_Reduced=1.15
; Warning: Performance degrading, reduce size

InpPF_Pause=0.95
; Stop: Losing money, reassess strategy immediately

InpPF_ReducedMult=0.60
; Cut risk significantly on performance degradation.

;═══════ DAILY/WEEKLY LIMITS ═══════
InpDailyTarget=0.0
; $10 daily target.
InpDailyMaxDD=1.0
; $25 max limit for daily drawdown (1 trade de riesgo completo).

InpWeeklyMaxDD=2.5
; Weekly Max Drawdown (%) = $62.50

InpMonthlyMaxDD=3.0
; Monthly Max Drawdown (%) = $75 → bajo el límite de $80 del broker

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=true
; Enable Correlation Guard
; ENABLED: Dynamic Draft System manages 6-asset correlation ranking

InpHighCorrelation=0.85
; High Correlation Threshold
; Detects pairs moving together (EURUSD/GBPUSD, XAUUSD/USDJPY)

InpCorrelationReduction=0.50
; Size Reduction Factor
; Cut position size in half for correlated entries

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
; Magic Number Base
; Symbol_Engine instances use 100000-100999

InpMagicRange=999
; Magic Number Range
; Covers all Symbol_Engine instances

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=5
; Update Interval (seconds)
; Balance between responsiveness and CPU usage
