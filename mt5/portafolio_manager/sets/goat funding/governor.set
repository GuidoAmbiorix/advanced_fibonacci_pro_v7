; Portfolio Governor - Goat Funded Trading Instant Pro
; Account: $2,500 - 5 Symbols: EURUSD, GBPUSD, USDJPY, XAUUSD, GBPJPY
; Strategy: Dynamic Draft Portfolio with Correlation Guard
; Daily Target: $10 (0.4%) | Daily Limit: $20 (0.8%) | Monthly Max DD: 3.5%

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=1.5
; Max Total Portfolio Risk (%)
; Strict limit scaling down portfolio size for safety.

InpMaxSymbolRisk=1.0
; Max Risk Per Symbol (%)
; Reduced for smaller lot configurations.

InpMaxGroupRisk=1.5
; Max Risk Per Correlation Group (%)
; Adjusted for the tight daily restrictions.

;═══════ DRAWDOWN GOVERNOR ═══════
InpDD_Normal=0.4
; DD Level: Normal Trading (%)
; Start risk reduction at $10 drawdown to save the $20 daily limit.

InpDD_Reduced=0.6
; DD Level: Reduced Risk (%)
; Immediate drastic scale back before hitting daily max.

InpDD_Pause=1.4
; DD Level: Pause Trading (%) - HARD STOP
; Ensure portfolio stops well before hitting max weekly to save 1.5%.

InpDD_ReducedMult=0.50
; Risk Multiplier
; 50% cut when underwater.

;═══════ ROLLING PF GOVERNOR ═══════
InpRollingTrades=20
; Rolling Window (trades)

InpPF_Normal=1.3
; Target: Win $1.30 for every $1 lost

InpPF_Reduced=1.15
; Warning: Performance degrading, reduce size

InpPF_Pause=0.95
; Stop: Losing money, reassess strategy immediately

InpPF_ReducedMult=0.60
; Cut risk significantly on performance degradation.

;═══════ DAILY/WEEKLY LIMITS ═══════
InpDailyTarget=0.0
; $10 daily target.
InpDailyMaxDD=0.8
; $20 max limit for daily drawdown.

InpWeeklyMaxDD=1.5
; Weekly Max Drawdown (%)

InpMonthlyMaxDD=3.5
; Monthly Max Drawdown (%)
; Safe stop far before the 4% hard prop firm threshold.

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=true
; Enable Correlation Guard
; ENABLED: Dynamic Draft System manages 6-asset correlation ranking

InpHighCorrelation=0.70
; High Correlation Threshold
; Detects pairs moving together (EURUSD/GBPUSD, XAUUSD/USDJPY)

InpCorrelationReduction=0.50
; Size Reduction Factor
; Cut position size in half for correlated entries

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
; Magic Number Base
; Symbol_Engine instances use 100000-100999

InpMagicRange=999
; Magic Number Range
; Covers all Symbol_Engine instances

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=5
; Update Interval (seconds)
; Balance between responsiveness and CPU usage
