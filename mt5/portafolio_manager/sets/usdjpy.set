; USDJPY - Traditional Safe Haven Pair
; Strong trending characteristics, respects technical levels
; Best Performance: Asian and NY sessions, risk-off environments
; Risk Profile: Moderate - smooth trending moves
; Target: Win Rate 65-75%, Profit Factor 2.1+
; Correlation: -0.80 with GBPUSD, +0.70 with USD Index

; ====== IDENTITY ======
InpMagicNumber=100004
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; JPY active in Asian and NY sessions
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=false
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
; Precise levels - JPY respects technicals well
InpSwingLookback=25
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.20

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.3
InpDisplacementLookback=5

; ====== RSI ======
; Standard RSI settings
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND ======
; Strong trending pair
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.12

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.8
InpAddOn2_R=3.0
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.50
InpRiskAddOn1=0.30
InpRiskAddOn2=0.20

; ====== EXIT ======
; Wider targets for trending moves
InpTrailingMode=1
InpPartialTP_R=1.8
InpPartialClosePercent=45.0
InpBE_Threshold_R=1.3
InpTrailStart_R=2.3
InpTrailATR_Mult=1.2

; ====== SPREAD ======
InpMaxSpreadPoints=15

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=25
InpSMC_MinImpulseATR=2.0
InpSMC_MinFVG_ATR=0.55

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Monitor both USD and JPY news
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
