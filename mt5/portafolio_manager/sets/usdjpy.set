; USDJPY - 24h Institutional Flow
; Core Major - Asian Engine
; Optimized for 24h Operation (No Killzones)

; ====== IDENTITY ======
InpMagicNumber=100003

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

; ====== FIBONACCI ======
; ====== FIBONACCI ======
InpSwingLookback=8
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=3

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.10

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=14
; H1: Increased from 11 to 12 for better quality signals on cleaner timeframe
InpEnableAddOns=false
InpAddOn1_R=1.5
InpAddOn2_R=2.8
InpMaxPositions=1

; ====== RISK ======
; ====== RISK ======
InpRiskBase=0.5
; $50 Risk (FundingPips)
InpMaxRisk=1.0
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=1.5
InpMaxTP_R=5.0
InpTPUseLearnedMFE=true

; ====== EXIT ======
InpTrailingMode=1
InpTrailType=1            ; 1=Chandelier
InpTrailStepATR=0.5       ; Step size (if Type=2)
InpMinVolatilityPips=5.0  ; Avoid dead zones
InpMaxVolatilityFactor=3.0; Avoid crashes
InpVolatilityTP_Mult=3.5  ; Dynamic Target
InpTPMode=4               ; Use Volatility TP
InpPartialTP_R=1.5
InpPartialClosePercent=45.0
InpBE_Threshold_R=0.6
InpTrailStart_R=0.6
InpTrailATR_Mult=1.4
; USDJPY: Tighter (trending pair, cleaner moves)
InpTrailDecayRate=0.30
InpTrailMinMult=0.45
; Slightly tighter floor for trending pair
InpTrailRegimeAware=true

; ====== SPREAD ======
InpMaxSpreadPoints=50

; ====== SMC ======
InpUseSMC=true
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.0
InpSMC_MinFVG_ATR=0.50

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16386
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=15
InpNewsMinutesAfter=15

; ====== KELLY ======
InpUseKelly=true
InpKellyFraction=0.25
InpKellyFraction=0.25
InpDailyMaxDD=4.9
InpWeeklyMaxDD=8.0

; ====== LEARNING ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR (DISABLED FOR 24h) ======
InpUseSessionGovernor=true
InpMaxTradesPerSession=10
InpTradeCooldownMinutes=10
InpEnableSessionBlacklist=false

; ====== PORTFOLIO PROTECTION ======
InpUseCorrelationFilter=true
; Governor Draft System handles correlation ranking
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=90
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=5
; Max 5 trades per day (prevent overtrading)
InpUseReversalFilter=true
