; USDJPY (Gopher) - Safe Haven Currency Pair
; Enhanced with SMC (Smart Money Concepts) for Institutional-Level Trading
; Best Performance: Tokyo/NY sessions, BOJ/Fed policy divergence
; Risk Profile: Conservative - JPY is safe haven
; Target: Win Rate 65-75%, Profit Factor 2.0+
; Correlation: Low/Negative with EURUSD, Negative with XAUUSD (risk-off hedge)

InpMagicNumber=100004
InpDirection=0
InpBrokerUTCOffset=2

; ====== SESSION CONFIGURATION ======
; USDJPY unique - Tokyo + NY sessions most active
; JPY carries during Asian, USD drives during NY
InpSessionFilter=1
InpLondonStart=7
InpLondonEnd=15
InpNYStart=13
InpNYEnd=21

; ====== FIBONACCI ZONES ======
; Medium zones - JPY pairs can be precise
; Strong respect for round numbers
InpSwingLookback=22
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.22

; ====== DISPLACEMENT FILTER ======
; Moderate filter - JPY can move smoothly or explosively
InpUseDisplacement=true
InpDisplacementATR=1.3
InpDisplacementLookback=5

; ====== RSI CONFIGURATION ======
; Standard bands - JPY trends well when BOJ/Fed diverge
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND FILTER ======
; Strong trend filter - JPY pairs can trend for months
; BOJ policy creates extended trends
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.12

; ====== CHOP FILTER ======
; Standard volatility filter
InpUseChopFilter=true
InpChopThreshold=0.72
InpATR_MA_Period=20

; ====== CONFLUENCE SYSTEM ======
; Standard threshold for quality entries
; JPY pairs give good signals when filtered
InpMinConfluenceEntry=5.0
InpEnableAddOns=true
InpAddOn1_R=1.6
InpAddOn2_R=2.8
InpMaxPositions=3

; ====== RISK MANAGEMENT ======
; Moderate risk - JPY pairs can gap on BOJ news
InpRiskBase=0.50
InpRiskAddOn1=0.28
InpRiskAddOn2=0.18

; ====== EXIT STRATEGY ======
; Extended targets - JPY trends can run far
InpTrailingMode=1
InpPartialTP_R=1.7
InpPartialClosePercent=45.0
InpBE_Threshold_R=1.3
InpTrailStart_R=2.3
InpTrailATR_Mult=1.2

; ====== SPREAD FILTER ======
; Medium spread tolerance
InpMaxSpreadPoints=18

; ====== SMC - SMART MONEY CONCEPTS ======
; Full SMC suite - institutional JPY flows are massive
InpUseSMC=true
InpSMC_SwingLookback=22
InpSMC_MinImpulseATR=2.2
InpSMC_MinFVG_ATR=0.52

; ====== MULTI-TIMEFRAME ANALYSIS ======
; H4 bias critical for JPY pairs
; BOJ intervention levels visible on HTF
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Critical for JPY - BOJ surprises can be violent
; Extended buffer for BOJ meetings
InpUseNewsFilter=true
InpNewsMinutesBefore=60
InpNewsMinutesAfter=45

; ====== SESSION OPTIMIZER ======
; Include Asian session - JPY active
; But best during overlap periods
InpUseSessionFilter=true
InpSkipAsianSession=false
InpFocusOverlapOnly=false

; ====== KELLY POSITION SIZING ======
; Half-Kelly with tighter limits
; JPY can gap significantly
InpUseKelly=true
InpKellyFraction=0.5
InpDailyMaxDD=2.5
InpWeeklyMaxDD=5.0
