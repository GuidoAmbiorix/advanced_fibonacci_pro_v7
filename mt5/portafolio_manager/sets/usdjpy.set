; USDJPY - M5 Trend Scalper
; Low volatility, strong trending for Portfolio Governor System
; Best Timeframe: H1 (Primary), H4 (Bias/Confirmation)
; Best Performance: Tokyo session (Japanese market hours), NY session (USD data)
; Risk Profile: Conservative - stable, clean trends, predictable
; Target: Win Rate 68-76%, Profit Factor 2.3+
; Correlation: Low correlation to EURUSD (~0.15), inverse to risk assets
; Characteristics: Safe haven flows, BOJ policy sensitive, clean technical levels

; ====== IDENTITY ======
InpMagicNumber=100004

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; JPY most active during Tokyo and NY sessions
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=false
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
; Tighter lookback for M5 precision
InpSwingLookback=12
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.20

; ====== DISPLACEMENT ======
; Moderate displacement for trending nature
InpUseDisplacement=true
InpDisplacementATR=1.3
InpDisplacementLookback=5

; ====== RSI ======
; Fast RSI for M5 Momentum
InpRSI_Period=9
InpRSI_Oversold=42
InpRSI_Overbought=58
InpRSI_Momentum=true

; ====== TREND ======
; Strong trends in JPY - moderate slope
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.12

; ====== CHOP FILTER ======
; Moderate threshold - cleaner than EUR pairs
InpUseChopFilter=true
InpChopThreshold=0.78
InpATR_MA_Period=20

; ====== CONFLUENCE ======
; OPTIMIZED: Score 6.0 for M5 Premium Setups (BoJ volatility protection)
InpMinConfluenceEntry=6
InpEnableAddOns=false
InpAddOn1_R=1.5
InpAddOn2_R=2.5
InpMaxPositions=1

; ====== RISK (Before Governor Scaling) ======
; Conservative base for stable pair
InpRiskBase=0.18
InpRiskAddOn1=0.12
InpRiskAddOn2=0.08
InpMaxRisk=0.50
InpMaxLotsPerTrade=0.5
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
; M5 Trend Scalping TP
InpTPMode=2
InpFixedTP_R=2.2
InpMinTP_R=1.3
InpMaxTP_R=3.5
InpTPUseLearnedMFE=true

; ====== EXIT ======
; Moderate targets for trending conditions
InpTrailingMode=1
InpPartialTP_R=1.3
InpPartialClosePercent=42.0
InpBE_Threshold_R=1.3
InpTrailStart_R=1.8
InpTrailATR_Mult=1.15

; ====== SPREAD ======
; Relaxed spread for M5 execution
InpMaxSpreadPoints=18

; ====== SMC - SMART MONEY CONCEPTS ======
; JPY respects institutional levels well
InpUseSMC=true
; M5 Structure Settings
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.0
InpSMC_MinFVG_ATR=0.48

; ====== MULTI-TIMEFRAME ======
; H4 bias, H1 confirmation
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Critical for JPY (BOJ) and USD news
InpUseNewsFilter=true
InpNewsMinutesBefore=35
InpNewsMinutesAfter=35

; ====== KELLY POSITION SIZING ======
; Conservative Quarter Kelly
InpUseKelly=true
InpKellyFraction=0.25
InpDailyMaxDD=2.0
InpWeeklyMaxDD=4.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR ======
; UPDATED: Active M5 Scalping (3 trades per session)
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpMaxProfitPerSession_R=5.5
InpMaxLossPerSession_R=1.5
InpMinSessionConfidence=0.5
InpTradeCooldownMinutes=15
InpEnableSessionBlacklist=true

; ====== PORTFOLIO PROTECTION ======
; Correlation filter and circuit breaker
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=45
InpMaxConsecutiveLosses=2
InpUseReversalFilter=true

; ====== RISK (Before Governor Scaling) ======
; PORTFOLIO-ADJUSTED: 0.20% for safe haven pair with BoJ event risk
InpRiskBase=0.20
