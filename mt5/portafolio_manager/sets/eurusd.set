; EURUSD - H1 Timeframe Institutional Flow
; Core Major - Balanced
; Optimized for H1 timeframe (reduced noise, cleaner signals)

; ====== IDENTITY ======
InpMagicNumber=100001

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

; ====== FIBONACCI ======
InpSwingLookback=8
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.20

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=3

; ====== RSI ======
InpRSI_Period=9
InpRSI_Oversold=35
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.10

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=12
; H1: Increased from 11 to 12 for better quality signals on cleaner timeframe
InpEnableAddOns=false
InpAddOn1_R=1.5
InpAddOn2_R=2.8
InpMaxPositions=1

; ====== RISK ======
InpRiskBase=0.30
InpMaxRisk=0.50
InpMaxLotsPerTrade=0.5
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
InpTPMode=2
; H1: Adaptive TP mode for trend-following
InpFixedTP_R=3.0
; H1: Increased from 2.5R to 3.0R for larger moves
InpMinTP_R=1.5
; H1: Increased from 1.0R to 1.5R (H1 has bigger moves)
InpMaxTP_R=5.0
; H1: Increased from 3.5R to 5.0R to capture full H1 trends
InpTPUseLearnedMFE=true

; ====== EXIT ======
InpTrailingMode=1
; H1: Aggressive trailing stop for trend-following
InpPartialTP_R=1.5
; H1: Increased from 1.2R to 1.5R (take partial earlier on H1 moves)
InpPartialClosePercent=40.0
; H1: Reduced from 45% to 40% (keep more running for trends)
InpBE_Threshold_R=0.8
; H1: Quick BE to protect capital (H1 can reverse fast)
InpTrailStart_R=0.8
; H1: START TRAILING EARLIER - reduced from 1.0R to 0.8R to lock profits sooner
InpTrailATR_Mult=1.0
; H1: Increased from 0.8 to 1.0 (H1 ATR is larger, need wider trail)

; ====== SPREAD ======
InpMaxSpreadPoints=50

; ====== SMC ======
InpUseSMC=true
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.2
InpSMC_MinFVG_ATR=0.50

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
; H1 chart uses H4 (16388) for higher timeframe context
InpMTF=16386
; H1: Changed from M15 (16385) to H1 (16386) - PRIMARY TIMEFRAME
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=15
InpNewsMinutesAfter=15

; ====== KELLY ======
InpUseKelly=true
InpKellyFraction=0.25
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0

; ====== LEARNING ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR (DISABLED FOR 24h) ======
InpUseSessionGovernor=true
InpMaxTradesPerSession=10
InpTradeCooldownMinutes=10
InpEnableSessionBlacklist=false

; ====== PORTFOLIO PROTECTION ======
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=90
; H1: Increased from 45 to 90 minutes (bug fix - consecutive loss protection)
InpMaxConsecutiveLosses=2
InpUseReversalFilter=true
