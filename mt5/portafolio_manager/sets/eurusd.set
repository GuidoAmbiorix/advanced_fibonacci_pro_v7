; EURUSD - M5 Timeframe - Scalper Mode
; Account: $6,000 Virtual | Phase 1: 4% Target, 5% Max DD, 3% Daily DD
; Strategy: M5 Scalping, Fast TP, Tight Trailing, Quick In/Out
; Confluence: 6, TP Cap 2R, Compressed Profit Escalator

InpMagicNumber=100001
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=true
; M5: Enable London Close for extra scalp window

;═══════ FIBONACCI ═══════
InpSwingLookback=12
; M5: 12 bars = 1 hour of data
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.20
; M5: Tighter tolerance

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=0.8
; M5: Smaller moves count as displacement
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=7
; M5: Fast RSI for quick signals
InpRSI_Oversold=35
InpRSI_Overbought=65
; M5: Less extreme levels for scalping
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=50
; M5: Faster EMA (50 on M5 ~ 4 hours of data)
InpUseTrendFilter=true
InpEMA_MinSlope=0.05
; M5: Lower slope threshold (smaller moves)

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.65
; M5: Looser chop filter (M5 is inherently choppier)
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=6
; M5: Lower threshold for more frequent entries
InpDominanceThreshold=1.5
; M5: Tighter delta allowed
InpEnableAddOns=false
InpMaxPositions=3
; M5: Fewer simultaneous positions

;═══════ RISK (Before Governor Scaling) ═══════
InpRiskBase=10.0
; Cent account: 10% needed for 0.03 lots (full escalator)
InpRiskAddOn1=0.0
InpRiskAddOn2=0.0
InpMaxRisk=10.0
InpMaxLotsPerTrade=20.0
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=1
; M5: Fixed TP (predictable, fast exits)
InpFixedTP_R=1.5
; M5: Take 1.5R and get out
InpMinTP_R=0.8
; M5: Accept smaller wins
InpMaxTP_R=2.0
; M5: Cap at 2R (don't wait for extended runs)
InpTPUseLearnedMFE=true

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
; Chandelier Exit
InpTrailStepATR=0.3
; M5: Tighter trail step

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=3.0
; M5: Lower min vol (M5 has smaller moves)
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=1.5
; M5: Reduced TP multiplier

;═══════ PARTIAL TP & TRAILING (M5 SCALP OPTIMIZED) ═══════
InpPartialTP_R=0.5
; M5: Partial TP at 0.5R (take money fast)
InpPartialClosePercent=60.0
; M5: Close 60% at partial (secure the bag)

InpBE_Threshold_R=0.3
; M5: Move to BE quickly at +0.3R
InpTrailStart_R=0.3
; M5: Start trailing immediately

InpTrailATR_Mult=0.5
; M5: Tight trailing distance
InpTrailDecayRate=0.40
; M5: Faster decay (tighten quickly)
InpTrailMinMult=0.25
; M5: Very tight floor

InpTrailRegimeAware=true
InpTrailMinBufferATR=0.15
; M5: Minimal buffer from price

;═══════ PROFIT ESCALATOR (M5 Compressed) ═══════
InpStage1_R=0.2
; M5: Instant lock at 0.2R
InpStage1_SL_R=0.0
; M5: Lock at entry (true BE)
InpStage2_R=0.5
; M5: First harvest at 0.5R
InpStage2_Close=50.0
; M5: Close 50% (take the money)
InpStage2_SL_R=0.2
; M5: Lock SL at +0.2R
InpStage3_R=1.0
; M5: Second harvest at 1.0R
InpStage3_Close=30.0
InpStage3_SL_R=0.5
InpRunnerTrailTight=0.6
; M5: Tighter runner trail
InpTimeStaleMins=10.0
; M5: 10 min stale (price should move fast on M5)
InpTimeStaleTight1=0.7
InpTimeStaleTight2=0.5

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.05
InpRegimeHarvest=true
InpMFECalibration=true
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ SPREAD ═══════
InpMaxSpreadPoints=20
; M5: Tight spread required for scalping (max ~2 pips)

;═══════ SMC - SMART MONEY CONCEPTS ═══════
InpUseSMC=true
InpSMC_SwingLookback=15
; M5: Shorter lookback
InpSMC_MinImpulseATR=1.0
; M5: Smaller impulses valid
InpSMC_MinFVG_ATR=0.3
; M5: Smaller FVGs valid

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=16385
; H1 higher timeframe (bias)
InpMTF=15
; M15 medium timeframe (structure)
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
; M5: ENABLED (critical for scalping)
InpNewsMinutesBefore=15
InpNewsMinutesAfter=15
; M5: Tighter windows

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
InpVolatilitySpikeCooldown=10
; M5: Faster cooldown

;═══════ KELLY POSITION SIZING ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=4.0
InpDailyTarget=0.0

;═══════ LEARNING & ADAPTATION ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=true

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=10.0
; M5: Tighter circuit breaker (more trades = more risk)
InpLossCooldownMinutes=3
; M5: Faster cooldown
InpMaxConsecutiveLosses=3
; M5: Stop after 3 consecutive losses
InpMaxDailyTrades=20
InpUseReversalFilter=true
InpReversalCooldownMinutes=3
; M5: 3 min same-direction cooldown

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=10
InpTradeCooldownMinutes=3
; M5: Faster cooldown between trades
InpCloseIntradayProfits=true
; M5: Close all at EOD
InpEndOfDayHour=22

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=5
; M5: React fast (every 5 seconds)
