; EURUSD - M5 Scalping - London-NY Session
; Optimized for 4-Pair Portfolio (EURUSD, GBPUSD, USDCAD, XAUUSD)
; Best Timeframe: H1 (Primary), H4 (Bias/Confirmation)
; Best Performance: London-NY overlap (cleanest technicals, highest liquidity)
; Risk Profile: Conservative with precise entries
; Target: Win Rate 70-78%, Profit Factor 2.2+
; Correlation: +0.70 with GBPUSD (manageable), Low with CAD/Gold

; ====== IDENTITY ======
InpMagicNumber=100002

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; EUR performs excellently in both London and NY killzones
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
; Tight zones for precise EUR entries
; Tight zones for M5 precision
InpSwingLookback=12
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.20

; ====== DISPLACEMENT ======
; Moderate filter for EUR - cleaner moves than volatile pairs
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=5

; ====== RSI ======
; Standard bands for balanced, liquid pair
; Fast RSI for M5 Momentum
InpRSI_Period=9
InpRSI_Oversold=35
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND ======
; Moderate slope - EUR trends are gradual but consistent
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.10

; ====== CHOP FILTER ======
; Standard volatility filter
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

; ====== CONFLUENCE ======
; OPTIMIZED: Score 6.0 for M5 Premium Setups Only (Structure+Momentum+SMC/MTF required)
InpMinConfluenceEntry=6
InpEnableAddOns=false
InpAddOn1_R=1.5
InpAddOn2_R=2.8
InpMaxPositions=1

; ====== RISK (Before Governor Scaling) ======
; UPDATED: Conservative base for safety (reduced from 0.55)
InpRiskBase=0.20
InpRiskAddOn1=0.15
InpRiskAddOn2=0.10
InpMaxRisk=0.50
InpMaxLotsPerTrade=0.5
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
; Adaptive TP for clean EUR structure (M5 Scalping)
InpTPMode=2
InpFixedTP_R=2.0
InpMinTP_R=1.2
InpMaxTP_R=3.0
InpTPUseLearnedMFE=true

; ====== EXIT ======
; Balanced targets for ranging/trending conditions
InpTrailingMode=1
InpPartialTP_R=1.2
InpPartialClosePercent=45.0
InpBE_Threshold_R=1.2
InpTrailStart_R=1.6
InpTrailATR_Mult=1.0

; ====== SPREAD ======
; ====== SPREAD ======
; Relaxed for M5 execution reliability
InpMaxSpreadPoints=15

; ====== SMC - SMART MONEY CONCEPTS ======
; Full SMC suite - EUR respects institutional levels
; M5 Structure Settings
InpUseSMC=true
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.2
InpSMC_MinFVG_ATR=0.50

; ====== MULTI-TIMEFRAME ======
; H4 bias, H1 confirmation - Clean HTF structure on EUR
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Filter EUR and USD high-impact news
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

; ====== KELLY POSITION SIZING ======
; UPDATED: Conservative Kelly for safety
InpUseKelly=true
InpKellyFraction=0.25
InpDailyMaxDD=2.0
InpWeeklyMaxDD=4.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR ======
; UPDATED: Active M5 Scalping (3 trades per session)
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpMaxProfitPerSession_R=6.0
InpMaxLossPerSession_R=1.5
InpMinSessionConfidence=0.5
InpTradeCooldownMinutes=10
InpEnableSessionBlacklist=true

; ====== PORTFOLIO PROTECTION ======
; NEW: Daily circuit breaker and correlation protection
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=45
InpMaxConsecutiveLosses=2
InpUseReversalFilter=true

; ====== RISK (Before Governor Scaling) ======
; PORTFOLIO-ADJUSTED: 0.30% for 4-pair London-NY portfolio
InpRiskBase=0.30
