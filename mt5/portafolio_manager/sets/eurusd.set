; EURUSD - Most Liquid Major Pair - Institutional Grade Setup
; Enhanced with SMC (Smart Money Concepts) for Institutional-Level Trading
; Best Timeframe: H1 (Primary), H4 (Bias/Confirmation)
; Best Performance: London-NY overlap (cleanest technicals, highest liquidity)
; Risk Profile: Conservative with precise entries
; Target: Win Rate 68-78%, Profit Factor 2.2+
; Correlation: +0.95 with GBPUSD, -0.95 with USDCHF

; ====== IDENTITY ======
InpMagicNumber=100002

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; EUR performs excellently in both London and NY killzones
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
; Tight zones for precise EUR entries
InpSwingLookback=22
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.18

; ====== DISPLACEMENT ======
; Moderate filter for EUR - cleaner moves than volatile pairs
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=5

; ====== RSI ======
; Standard bands for balanced, liquid pair
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND ======
; Moderate slope - EUR trends are gradual but consistent
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.10

; ====== CHOP FILTER ======
; Standard volatility filter
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

; ====== CONFLUENCE ======
; Standard threshold for liquid pair
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.5
InpAddOn2_R=2.8
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
; Moderate base for consistent growth
InpRiskBase=0.55
InpRiskAddOn1=0.30
InpRiskAddOn2=0.20
InpMaxRisk=0.75
InpMaxLotsPerTrade=0.5
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
; Adaptive TP for clean EUR structure
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=1.5
InpMaxTP_R=5.0
InpTPUseLearnedMFE=true

; ====== EXIT ======
; Balanced targets for ranging/trending conditions
InpTrailingMode=1
InpPartialTP_R=1.6
InpPartialClosePercent=45.0
InpBE_Threshold_R=1.2
InpTrailStart_R=2.2
InpTrailATR_Mult=1.1

; ====== SPREAD ======
; Tight spread requirement - EUR should have best spreads
InpMaxSpreadPoints=12

; ====== SMC - SMART MONEY CONCEPTS ======
; Full SMC suite - EUR respects institutional levels
InpUseSMC=true
InpSMC_SwingLookback=22
InpSMC_MinImpulseATR=2.2
InpSMC_MinFVG_ATR=0.50

; ====== MULTI-TIMEFRAME ======
; H4 bias, H1 confirmation - Clean HTF structure on EUR
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Filter EUR and USD high-impact news
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

; ====== KELLY POSITION SIZING ======
; Half-Kelly for consistent scaling
InpUseKelly=true
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

; ====== SESSION GOVERNOR ======
; Session-level control: max trades, P&L limits, confidence tracking
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpMaxProfitPerSession_R=5.0
InpMaxLossPerSession_R=2.0
InpMinSessionConfidence=0.4
InpTradeCooldownMinutes=15
InpEnableSessionBlacklist=true
