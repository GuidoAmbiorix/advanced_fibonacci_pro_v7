; NZDUSD - M5 Range Scalper
; Optimized for Portfolio Governor System
; Correlated to AUDUSD, Commodity-linked
; Magic: 100009

; ====== IDENTITY ======
InpMagicNumber=100009

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== RISK ======
InpRiskBase=0.50
InpRiskAddOn1=0.15
InpRiskAddOn2=0.10
InpMaxRisk=1.0

; ====== PROTECTION ======
InpMaxConsecutiveLosses=2
InpUseReversalFilter=true
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=45

; ====== STRATEGY ======
InpSwingLookback=12
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpUseDisplacement=true
InpDisplacementATR=1.4
InpUseTrendFilter=true
InpEMA_Period=200
InpMinConfluenceEntry=4

; ====== SMC ======
InpUseSMC=true
InpSMC_MinImpulseATR=2.1
InpSMC_MinFVG_ATR=0.5

; ====== FILTERS ======
InpUseKillzoneFilter=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
