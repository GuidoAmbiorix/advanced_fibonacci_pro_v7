; NZDUSD - The Kiwi - High Beta Commodity Currency
; Similar to AUD but more volatile
; Best Performance: Asian session, dairy/NZ data releases
; Risk Profile: Moderate-High - follows risk sentiment
; Target: Win Rate 62-70%, Profit Factor 1.9+
; Correlation: +0.87 with AUDUSD, +0.55 with risk assets

; ====== IDENTITY ======
InpMagicNumber=100008
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; NZD most active during Asian session
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=false
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
InpSwingLookback=21
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.4
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=37
InpRSI_Overbought=63
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.11

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.73
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.7
InpAddOn2_R=2.9
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.42
InpRiskAddOn1=0.26
InpRiskAddOn2=0.16

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.7
InpPartialClosePercent=42.0
InpBE_Threshold_R=1.3
InpTrailStart_R=2.2
InpTrailATR_Mult=1.15

; ====== SPREAD ======
InpMaxSpreadPoints=20

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=21
InpSMC_MinImpulseATR=2.2
InpSMC_MinFVG_ATR=0.53

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=35
InpNewsMinutesAfter=35

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.45
InpDailyMaxDD=2.8
InpWeeklyMaxDD=5.5

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
