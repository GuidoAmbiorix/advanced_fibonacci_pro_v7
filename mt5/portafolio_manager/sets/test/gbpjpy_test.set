; GBPJPY - H1 - CONSERVATIVE SCALPER TEST
; PURPOSE: Slow steady equity curve. Small account ($10-$50). Capital preservation.
; NOTE: GBPJPY is the most volatile forex pair — "The Dragon".
;       JPY pip value ~$0.07/pip for 0.01 lots — cheaper than EURUSD ($0.10/pip).
;       H1 ATR ~15-25 pips × $0.07 = ~$1.05-1.75 min lot risk → works on $50 accounts.

InpMagicNumber=100014
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
; GBPJPY: London Open (GBP impulse) + NY (USD/risk flows move JPY)
; London Close also included — JPY pairs move strongly at session crossover
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=true
InpCloseOnKillzoneEnd=false
InpKZBEMinutesBefore=0
InpKZBEMinProfitR=0.0
InpNotifyKillzoneOpen=false

;═══════ MOMENTUM EXIT ═══════
InpUseMomentumExit=true
InpMomADX_Period=14
InpMomADX_Threshold=18.0
InpMomATR_CollapseRatio=0.65
InpMomBarsNoProgress=5
InpMomProgressATR=0.2
InpMomSignalsToExit=1
InpMomRecoveryMinScore=1

;═══════ FIBONACCI ═══════
InpSwingLookback=20
InpFibLevelLow=0.500
InpFibLevelHigh=0.786
InpZoneTolerance=0.55

;═══════ DISPLACEMENT ═══════
; GBPJPY moves fast — displacement threshold slightly lower
InpUseDisplacement=true
InpDisplacementATR=0.7
InpDisplacementLookback=4

;═══════ RSI ═══════
; GBP cross: wider RSI thresholds — strong trends hold extreme levels
InpRSI_Period=14
InpRSI_Oversold=30
InpRSI_Overbought=70
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.03

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.72
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=19
InpDominanceThreshold=0.5
InpMaxPositions=1

;═══════ RISK - CONSERVATIVE SMALL ACCOUNT ═══════
; GBPJPY 0.01 lots: ~$0.07/pip pip value
; H1 ATR ~20 pips → min lot risk ~$1.40
; 3% on $50 = $1.50 → covers most setups
; 3% on $10 = $0.30 → tight SL setups only — some trades may still reject
InpRiskBase=25.0
InpMaxRisk=30.0
InpMaxLotsPerTrade=0.01
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=2.0
InpMinTP_R=1.5
InpMaxTP_R=3.0
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.2

;═══════ VOLATILITY FILTER ═══════
; GBPJPY H1: wide noise floor — require meaningful volatility
InpMinVolatilityPips=3.0
InpMaxVolatilityFactor=4.0
InpVolatilityTP_Mult=2.0

;═══════ PARTIAL TP & TRAILING — AGGRESSIVE HARVEST ═══════
InpPartialTP_R=0.20
InpPartialClosePercent=75.0
InpBE_Threshold_R=0.10
InpTrailStart_R=0.15
InpTrailATR_Mult=0.35
InpTrailDecayRate=0.55
InpTrailMinMult=0.08
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.06

;═══════ INFINITE ESCALATOR — SUPER DUPER AGGRESSION ═══════
InpEsc_FirstR=0.06
InpEsc_FirstSL_R=-0.005
InpEsc_StepR=0.08
InpEsc_GrowthFactor=2.0
InpEsc_BaseHarvest=75.0
InpEsc_HarvestDecay=0.55
InpEsc_MinHarvest=30.0
InpEsc_MaxStages=20
InpRunnerTrailTight=0.97
InpTimeStaleMins=45.0
InpTimeStaleTight1=0.97
InpTimeStaleTight2=0.90

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=2
InpPyr_MinProfitR=1.0
InpAgg_MaxTotalRisk=2.0
InpAgg_MaxPositions=1

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.15
InpRegimeHarvest=true
InpMFECalibration=false
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ STALE TRADE EXIT ═══════
; 4 H1 bars = 4 hours
InpUseStaleTrade=true
InpStaleBarLimit=4

;═══════ SPREAD ═══════
; GBPJPY spread is wider than majors
InpMaxSpreadPoints=50

;═══════ SMC ═══════
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=1.2
InpSMC_MinFVG_ATR=0.25

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=false
InpHTF=16408
InpMTF=16388
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=false
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
; GBPJPY spikes hard on risk events — tighter cooldown
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
InpVolatilitySpikeCooldown=30

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=5.0
InpWeeklyMaxDD=10.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=20

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=2.0
InpLossCooldownMinutes=60
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=3
InpUseReversalFilter=false
InpReversalCooldownMinutes=30

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=1
InpTradeCooldownMinutes=60
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ GOVERNOR ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=5.0
InpGov_DD_Pause=10.0
InpGov_ReducedMult=0.5
InpGov_DailyMaxDD=4.0

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=10

