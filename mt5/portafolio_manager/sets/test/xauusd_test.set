; XAUUSD (Gold) - H1 - CONSERVATIVE SCALPER TEST
; PURPOSE: Slow steady equity curve. Small account ($10-$50). Capital preservation.
; NOTE: Gold 0.01 lots has large SL dollar value. 5% is the minimum viable risk
;       for $50 accounts. On $10 accounts, trades may still be rejected — Gold
;       requires a larger account than forex pairs for conservative sizing.

InpMagicNumber=100011
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpCloseOnKillzoneEnd=false
InpKZBEMinutesBefore=0
InpKZBEMinProfitR=0.0
InpNotifyKillzoneOpen=false

;═══════ MOMENTUM EXIT ═══════
InpUseMomentumExit=true
InpMomADX_Period=14
InpMomADX_Threshold=20.0
InpMomATR_CollapseRatio=0.65
InpMomBarsNoProgress=5
InpMomProgressATR=0.2
InpMomSignalsToExit=2
InpMomRecoveryMinScore=1

;═══════ FIBONACCI ═══════
InpSwingLookback=20
InpFibLevelLow=0.500
InpFibLevelHigh=0.786
InpZoneTolerance=0.50

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=0.7
InpDisplacementLookback=4

;═══════ RSI ═══════
; Gold: wide thresholds — stays overbought in bull trends for weeks
InpRSI_Period=14
InpRSI_Oversold=30
InpRSI_Overbought=70
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.03

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.80
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=12
InpDominanceThreshold=0.5
InpMaxPositions=1

;═══════ RISK - SMALL ACCOUNT XAUUSD ═══════
; XAUUSDm 0.01 lots (minimum) = ~$17-20 SL dollar risk regardless of %.
; InpRiskBase=40% is NOT actual exposure — it only unlocks the trade validation.
; InpMaxLotsPerTrade=0.01 is the real cap. The account always risks ~$17-20/trade.
; Governors and session limits are the real protection here.
; Minimum account recommended for Gold: $200+ for meaningful risk control.
InpRiskBase=40.0
InpMaxRisk=40.0
InpMaxLotsPerTrade=0.01
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=2.0
InpMinTP_R=1.5
InpMaxTP_R=3.0
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.2

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=10.0
InpMaxVolatilityFactor=4.0
InpVolatilityTP_Mult=2.0

;═══════ PARTIAL TP & TRAILING — AGGRESSIVE HARVEST ═══════
InpPartialTP_R=0.30
InpPartialClosePercent=70.0
InpBE_Threshold_R=0.15
InpTrailStart_R=0.20
InpTrailATR_Mult=0.45
InpTrailDecayRate=0.50
InpTrailMinMult=0.12
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.10

;═══════ INFINITE ESCALATOR — AGGRESSIVE HARVEST ═══════
InpEsc_FirstR=0.08
InpEsc_FirstSL_R=-0.01
InpEsc_StepR=0.10
InpEsc_GrowthFactor=1.8
InpEsc_BaseHarvest=70.0
InpEsc_HarvestDecay=0.60
InpEsc_MinHarvest=25.0
InpEsc_MaxStages=15
InpRunnerTrailTight=0.96
InpTimeStaleMins=60.0
InpTimeStaleTight1=0.95
InpTimeStaleTight2=0.85

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=2
InpPyr_MinProfitR=1.0
InpAgg_MaxTotalRisk=2.0
InpAgg_MaxPositions=1

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.15
InpRegimeHarvest=true
InpMFECalibration=false
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=21

;═══════ STALE TRADE EXIT ═══════
InpUseStaleTrade=true
InpStaleBarLimit=4

;═══════ SPREAD ═══════
InpMaxSpreadPoints=200

;═══════ SMC ═══════
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=1.2
InpSMC_MinFVG_ATR=0.25

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=false
InpHTF=16408
InpMTF=16388
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=false
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
InpVolatilitySpikeCooldown=20

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=5.0
InpWeeklyMaxDD=10.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=20

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=30
InpMaxConsecutiveLosses=3
InpMaxDailyTrades=5
InpUseReversalFilter=false
InpReversalCooldownMinutes=30

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=2
InpTradeCooldownMinutes=30
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ GOVERNOR ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=5.0
InpGov_DD_Pause=10.0
InpGov_ReducedMult=0.5
InpGov_DailyMaxDD=4.0

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=10

