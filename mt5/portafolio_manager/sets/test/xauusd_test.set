; XAUUSD (Gold) - H4 Timeframe - STANDALONE TEST
; Account: Standard | Strategy: H4 Swing, Adaptive TP, Smart Trailing
; PURPOSE: Testing without Governor - standalone backtest
; LOAD: Strategy Tester > XAUUSD H4 > Load this .set

InpMagicNumber=100011
InpDirection=0
InpBrokerUTCOffset=2

;═══════ GOVERNOR (STANDALONE) ═══════
InpStandaloneMode=true

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

;═══════ FIBONACCI ═══════
InpSwingLookback=24
; Gold H4: Wider lookback matching production gold settings
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.40
; TEST: Wider tolerance to catch more Fib zone entries

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=0.8
; TEST FIX: Relaxed from 1.5 - 1.5x ATR is too strict for H4 gold, SMC was getting 0 pts
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=40
; Gold H4: Wider RSI bands - gold trends from deeper levels
InpRSI_Overbought=60
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.1

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.60
; TEST FIX: Lowered from 0.80 - 80% was blocking too many H4 gold bars during normal consolidation
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=7
; TEST FIX: Lowered from 10 - without SMC firing, score barely hits 10. Need SMC to build up data first.
InpDominanceThreshold=1.5
; TEST FIX: Lowered from 2.5 - gold has balanced buy/sell signals, 2.5 was zeroing valid setups
InpMaxPositions=2

;═══════ RISK ═══════
InpRiskBase=100.0
; TEST: Full balance risk - backtest mode
InpMaxRisk=100.0
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=false

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=5.0
; Gold H4: Extended fixed TP - gold swings regularly reach 5R+
InpMinTP_R=2.5
InpMaxTP_R=10.0
InpTPUseLearnedMFE=true

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.6
; Gold H4: Wider trail step - gold ATR is large

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=30.0
; Gold H4: High min volatility - gold H4 bars move big
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING ═══════
InpPartialTP_R=1.2
; Gold H4: Later partial - give gold room to develop
InpPartialClosePercent=40.0
; Gold H4: Close less - keep more running in gold
InpBE_Threshold_R=1.0
InpTrailStart_R=1.0
InpTrailATR_Mult=1.5
InpTrailDecayRate=0.20
; Gold H4: Slower decay - runner stays loose longer
InpTrailMinMult=0.50
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.35

;═══════ INFINITE ESCALATOR - AGGRESSIVE GOLD H4 ═══════
InpEsc_FirstR=0.4
; AGGR: Quick Lock at 0.4R - secure profit fast in gold
InpEsc_FirstSL_R=-0.05
; AGGR: Very tight post-lock buffer
InpEsc_StepR=0.6
; AGGR: Smaller steps - more stages, more harvests, more control on gold
InpEsc_GrowthFactor=1.2
InpEsc_BaseHarvest=20.0
; AGGR: Large harvest per stage - gold generates high dollar value
InpEsc_HarvestDecay=0.80
; AGGR: Faster decay - runner concentrates on home run
InpEsc_MinHarvest=4.0
; AGGR: Substantial floor harvest
InpEsc_MaxStages=25
; AGGR: More stages - gold can trend for many H4 bars
InpRunnerTrailTight=0.85
; AGGR: Looser runner trail - gold needs significant room
InpTimeStaleMins=300.0
; AGGR: 300 min before stale - gold takes time to develop
InpTimeStaleTight1=0.75
; AGGR: Tighter stale squeeze
InpTimeStaleTight2=0.55

;═══════ SCALE-IN PYRAMID - AGGRESSIVE GOLD ═══════
InpPyr_Enable=true
InpPyr_Frequency=2
; AGGR: More frequent scale-in - capitalize on gold momentum
InpPyr_FirstRiskPct=0.15
InpPyr_RiskDecay=0.65
; AGGR: Steeper pyramid decay
InpPyr_MinRiskPct=0.04
InpPyr_MaxAddOns=4
; AGGR: More add-ons - gold trends can compound strongly
InpPyr_MinProfitR=1.0
InpAgg_MaxTotalRisk=100.0
; TEST: Full aggregate risk
InpAgg_MaxPositions=5

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.06
; Gold: Stronger score adaptation
InpRegimeHarvest=true
InpMFECalibration=true
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ CONFLUENCE FLIP EXIT (legacy fallback) ═══════
InpUseConflFlipExit=false
InpConflFlipMinScore=10.0
InpConflFlipDelta=3.0
InpConflFlipOnlyAfterStage0=true

;═══════ STALE TRADE EXIT ═══════
InpUseStaleTrade=true
InpStaleBarLimit=10
; Gold H4: More bars before stale - gold pauses are longer

;═══════ SMART REVERSAL DETECTION (OFF - test pure escalator) ═══════
InpUseSmartReversal=false
; TEST GOLD: All reversal detection OFF - isolate escalator behavior
InpUseMFERetraceExit=false
InpUseFlipAndReverse=false
InpRevW_CHoCH=0.40
InpRevW_Divergence=0.25
InpRevW_LiqSweep=0.20
InpRevW_ScoreVelocity=0.15
InpRevExitThreshold=0.55
InpRevExitMinScore=8.0
InpRevOnlyAfterStage0=true
InpRevCHoCH_MaxBars=5
InpRevRegimeGate=3
InpMFERetrace_Threshold=0.40
InpMFERetrace_MinPeakR=1.0
InpMFERetrace_AfterStage0=true
InpFlipRev_MinScore=0.75
InpFlipRev_RiskPct=0.20
InpFlipRev_CooldownBars=2
InpFlipRev_RequireMFE=true
InpFlipRev_MinPeakR=0.5

;═══════ SPREAD ═══════
InpMaxSpreadPoints=200
; TEST FIX: Raised from 50 - XAUUSD spread in points can vary by broker/decimal representation

;═══════ SMC - SMART MONEY CONCEPTS ═══════
InpUseSMC=true
InpSMC_SwingLookback=24
InpSMC_MinImpulseATR=1.2
; TEST FIX: Lowered from 2.5 - 2.5x ATR threshold was making ALL 5 SMC modules return 0 pts (13 pts of signal lost)
InpSMC_MinFVG_ATR=0.4
; TEST FIX: Lowered from 0.6 to allow more FVG signals

;═══════ MULTI-TIMEFRAME (OFF for backtest) ═══════
InpUseMTF=false
; TEST: MTF disabled - avoid history cache build errors in tester
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER (OFF for backtest) ═══════
InpUseNewsFilter=false
InpNewsMinutesBefore=45
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.5
; Gold H4: Higher threshold - gold volatility naturally elevated
InpVolatilitySpikeCooldown=45
; Gold: Longer cooldown after spike

;═══════ KELLY POSITION SIZING ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0
InpDailyTarget=0.0

;═══════ LEARNING (OFF for backtest) ═══════
InpEnableLearning=false
InpLogTradesToFile=false
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
; TEST: No correlation filter - standalone test
InpDailyMaxLoss_R=6.0
InpLossCooldownMinutes=45
; Gold: Longer cooldown after loss
InpMaxConsecutiveLosses=2
; Gold: Stop after 2 consecutive losses
InpMaxDailyTrades=8
; TEST FIX: Raised from 4 - allow more daily trades to observe backtest behavior
InpUseReversalFilter=true
InpReversalCooldownMinutes=60

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
; TEST FIX: Raised from 1 - allow more trades per session to observe behavior
InpTradeCooldownMinutes=45
; TEST FIX: Lowered from 90 - 90 min cooldown was too restrictive for H4 backtest observation
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=30
; TEST: More frequent throttle for backtest
