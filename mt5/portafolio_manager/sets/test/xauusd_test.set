; XAUUSD (Gold) - H4 - ULTRA CONSERVATIVE TEST SET
; PURPOSE: Maximum equity curve preservation. Profit only from elite setups.
; LOAD: Strategy Tester OR attach to XAUUSD H4 chart with Standalone=true
; PHILOSOPHY: One great trade > three mediocre trades. Never give back profits.

InpMagicNumber=100011
InpDirection=0
InpBrokerUTCOffset=2

;═══════ GOVERNOR (STANDALONE) ═══════

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

;═══════ FIBONACCI ═══════
InpSwingLookback=24
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.35
; Slightly tighter than before - only take clean fib taps

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.0
; Require clearer institutional displacement on gold
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.15
; Require a more defined trend - avoids ranging gold markets

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.65
; Tighter - only trade when gold has clear directional structure
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=19
; Elite setups only - 19+ required
InpDominanceThreshold=1.5
; Gold: relaxed dominance - signals are naturally more balanced
InpMaxPositions=1
; One position only - never overlap on gold

;═══════ RISK - TEST ═══════
InpRiskBase=50.0
; TEST: 50% balance for backtest observation
InpMaxRisk=50.0
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=false

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=3.0
; Reduced from 4R - take profits consistently, do not chase
InpMinTP_R=2.0
InpMaxTP_R=5.0
; Cap at 5R - gold rarely runs cleanly beyond that on H4
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.4
; Tighter trail step - lock in gains faster on gold

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=20.0
InpMaxVolatilityFactor=2.0
; Tighter max - avoid entering chaotic gold spikes
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING ═══════
InpPartialTP_R=0.8
; Take partial much earlier - lock cash before gold reverses
InpPartialClosePercent=50.0
; Close 50% at partial - meaningful protection
InpBE_Threshold_R=0.5
; Move to breakeven at 0.5R - protect capital aggressively
InpTrailStart_R=0.7
; Start trailing early
InpTrailATR_Mult=1.4
; Tighter trail multiplier
InpTrailDecayRate=0.25
InpTrailMinMult=0.35
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.30

;═══════ INFINITE ESCALATOR - ULTRA CONSERVATIVE ═══════
InpEsc_FirstR=0.4
; Lock profits at 0.4R - very early protection
InpEsc_FirstSL_R=-0.03
; Almost no buffer after first lock
InpEsc_StepR=0.6
; Smaller escalator steps - harvest frequently
InpEsc_GrowthFactor=1.1
; Slow growth factor - do not let steps expand too much
InpEsc_BaseHarvest=35.0
; Harvest 35% per stage - lock gains aggressively
InpEsc_HarvestDecay=0.85
InpEsc_MinHarvest=8.0
InpEsc_MaxStages=8
; Cap at 8 stages - do not chase extended runners
InpRunnerTrailTight=0.65
InpTimeStaleMins=240.0
; 240 min before stale on gold H4
InpTimeStaleTight1=0.70
InpTimeStaleTight2=0.55

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
; DISABLED: Pyramiding forbidden in ultra-conservative mode
InpPyr_Frequency=2
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.65
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=2
InpPyr_MinProfitR=2.0
InpAgg_MaxTotalRisk=1.0
InpAgg_MaxPositions=1

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.06
InpRegimeHarvest=true
InpMFECalibration=false
InpMomentumTrail=true
InpChaosEmergencyLock=true
; Critical for gold - flash crashes happen
InpFridayCloseHour=21
; Close 1 hour earlier on Friday - gold weekend gaps are dangerous

;═══════ STALE TRADE EXIT ═══════
InpUseStaleTrade=true
InpStaleBarLimit=8
; Exit faster - free capital if gold is not moving

;═══════ SPREAD ═══════
InpMaxSpreadPoints=200
; Gold: Wide spread tolerance - XAUUSD broker representation varies

;═══════ SMC - SMART MONEY CONCEPTS ═══════
InpUseSMC=true
InpSMC_SwingLookback=24
InpSMC_MinImpulseATR=1.5
; Slightly tighter - require more meaningful institutional impulse
InpSMC_MinFVG_ATR=0.4

;═══════ MULTI-TIMEFRAME (OFF for backtest) ═══════
InpUseMTF=false
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER (OFF for backtest) ═══════
InpUseNewsFilter=false
InpNewsMinutesBefore=45
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=2.0
; More sensitive spike detection - gold flash crashes are lethal
InpVolatilitySpikeCooldown=90
; 90 min cooldown - do not rush back into gold after a spike

;═══════ KELLY POSITION SIZING ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=2.0
InpWeeklyMaxDD=4.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=false
InpLogTradesToFile=false
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=1.5
; Stop after 1.5R daily loss - gold losses are large in dollar terms
InpLossCooldownMinutes=120
; 2 hour cooldown after any loss
InpMaxConsecutiveLosses=1
; Stop after 1 consecutive loss - investigate before re-entering gold
InpMaxDailyTrades=2
; Maximum 2 trades per day - quality over quantity
InpUseReversalFilter=true
InpReversalCooldownMinutes=180
; 3 hour reversal cooldown - never chase gold in the same session

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=1
; One trade per session - the best setup only
InpTradeCooldownMinutes=120
; 2 hour cooldown between trades
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ GOVERNOR ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=3.0
; Reduce risk at 3% drawdown from peak
InpGov_DD_Pause=6.0
; Pause trading at 6% drawdown from peak
InpGov_ReducedMult=0.3
; Drop to 30% risk when in drawdown - very conservative
InpGov_DailyMaxDD=3.0
; Stop for the day after 3% daily drawdown

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=30
