; EURUSD - H4 - CONSERVATIVE TEST SET
; PURPOSE: Demo or live account testing. Capital preservation first.
; LOAD: Strategy Tester OR attach to EURUSD H4 chart with Standalone=true

InpMagicNumber=100001
InpDirection=0
InpBrokerUTCOffset=2

;═══════ GOVERNOR (STANDALONE) ═══════

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

;═══════ FIBONACCI ═══════
InpSwingLookback=20
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.0
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=45
InpRSI_Overbought=55
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.1

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.70
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=19
; TEST: Elite setups only - score 19+ required
InpDominanceThreshold=2.0
InpMaxPositions=1
; One position at a time - no overlap risk

;═══════ RISK - TEST ═══════
InpRiskBase=50.0
; TEST: 50% balance risk for backtest observation
InpMaxRisk=50.0
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=false

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=2.0
InpMaxTP_R=6.0
InpTPUseLearnedMFE=false
; Disabled: not enough history on first run

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.5

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=5.0
InpMaxVolatilityFactor=2.5
; Tighter: avoid entering in extreme volatility
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING ═══════
InpPartialTP_R=1.0
InpPartialClosePercent=50.0
InpBE_Threshold_R=0.7
; Move to BE early - protect capital first
InpTrailStart_R=0.8
InpTrailATR_Mult=1.5
InpTrailDecayRate=0.20
InpTrailMinMult=0.50
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.35

;═══════ INFINITE ESCALATOR - CONSERVATIVE ═══════
InpEsc_FirstR=0.5
; Quick lock at 0.5R - get to breakeven fast
InpEsc_FirstSL_R=-0.05
; Very tight post-lock buffer
InpEsc_StepR=0.8
InpEsc_GrowthFactor=1.2
InpEsc_BaseHarvest=25.0
; Harvest more per stage - lock in gains consistently
InpEsc_HarvestDecay=0.80
InpEsc_MinHarvest=5.0
InpEsc_MaxStages=10
; Cap at 10 stages - do not chase extended runners
InpRunnerTrailTight=0.70
InpTimeStaleMins=200.0
InpTimeStaleTight1=0.75
InpTimeStaleTight2=0.60

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
; DISABLED: No pyramiding in conservative test mode
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=2
InpPyr_MinProfitR=1.5
InpAgg_MaxTotalRisk=2.0
; Max 2% aggregate risk even if pyramid were enabled
InpAgg_MaxPositions=2

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.05
InpRegimeHarvest=true
InpMFECalibration=false
InpMomentumTrail=true
InpChaosEmergencyLock=true
; Emergency lock in chaos - critical for capital protection
InpFridayCloseHour=22

;═══════ STALE TRADE EXIT ═══════
InpUseStaleTrade=true
InpStaleBarLimit=6
; Close stale trades faster - free capital sooner

;═══════ SPREAD ═══════
InpMaxSpreadPoints=25
; Strict spread: only trade in good liquidity conditions

;═══════ SMC - SMART MONEY CONCEPTS ═══════
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=1.8
InpSMC_MinFVG_ATR=0.4

;═══════ MULTI-TIMEFRAME (OFF for backtest) ═══════
InpUseMTF=false
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER (OFF for backtest) ═══════
InpUseNewsFilter=false
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=2.5
; More sensitive spike detection
InpVolatilitySpikeCooldown=45

;═══════ KELLY POSITION SIZING ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=2.0
InpWeeklyMaxDD=4.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=false
InpLogTradesToFile=false
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=3.0
; Stop trading after 3R daily loss - hard rule
InpLossCooldownMinutes=60
; 1 hour cooldown after loss streak
InpMaxConsecutiveLosses=2
; Stop after 2 consecutive losses - investigate before continuing
InpMaxDailyTrades=3
; Quality over quantity
InpUseReversalFilter=true
InpReversalCooldownMinutes=90
; 90 min before retrying same direction

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=1
; One trade per session - best setup only
InpTradeCooldownMinutes=60
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ GOVERNOR ═══════
InpGov_Enabled=true
; Activate drawdown control during standalone/backtest testing
InpGov_DD_Reduce=5.0
; Reduce risk at 5% total drawdown from peak
InpGov_DD_Pause=10.0
; Pause trading at 10% total drawdown from peak
InpGov_ReducedMult=0.5
; Risk multiplier when in reduced mode (50% of normal risk)
InpGov_DailyMaxDD=5.0
; Stop trading for the day after 5% daily drawdown

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=30
