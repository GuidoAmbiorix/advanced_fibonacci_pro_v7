; GBPUSD - M5 Scalping - London-NY Session
; Optimized for Portfolio Governor System (Governor handles aggregate risk)
; Best Timeframe: H1 (Primary), H4 (Bias/Confirmation)
; Best Performance: London-NY overlap (highest volatility, deep liquidity)
; Risk Profile: Moderate - More volatile than EUR, clean technicals
; Target: Win Rate 66-76%, Profit Factor 2.3+
; Correlation: +0.70 with EURUSD (both USD pairs, but GBP more volatile)

; ====== IDENTITY ======
InpMagicNumber=100003

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; GBP performs excellently in London and NY sessions
InpUseKillzoneFilter=false
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
; Tight zones for M5 precision (slightly wider tolerance for GBP volatility)
InpSwingLookback=12
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

; ====== DISPLACEMENT ======
; Higher displacement for GBP - more aggressive moves than EUR
InpUseDisplacement=true
InpDisplacementATR=1.4
InpDisplacementLookback=5

; ====== RSI ======
; Wider RSI bands for GBP volatility
; Fast RSI for M5 Momentum
InpRSI_Period=9
InpRSI_Oversold=33
InpRSI_Overbought=67
InpRSI_Momentum=true

; ====== TREND ======
; Moderate-strong slope - GBP trends powerfully
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.13

; ====== CHOP FILTER ======
; Higher threshold for GBP volatility
InpUseChopFilter=true
InpChopThreshold=0.80
InpATR_MA_Period=20

; ====== CONFLUENCE ======
; OPTIMIZED: Score 6.0 for M5 Premium Setups Only (Structure+Momentum+SMC/MTF required)
InpMinConfluenceEntry=6
InpEnableAddOns=false
InpAddOn1_R=1.5
InpAddOn2_R=2.8
InpMaxPositions=1

; ====== RISK (Before Governor Scaling) ======
; PORTFOLIO-ADJUSTED: 0.30% for 4-pair London-NY portfolio
InpRiskBase=0.30
InpRiskAddOn1=0.15
InpRiskAddOn2=0.10
InpMaxRisk=0.60
InpMaxLotsPerTrade=0.5
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
; Adaptive TP for GBP structure (M5 Scalping, runs further than EUR)
InpTPMode=2
InpFixedTP_R=2.2
InpMinTP_R=1.3
InpMaxTP_R=3.5
InpTPUseLearnedMFE=true

; ====== EXIT ======
; Balanced targets for GBP ranging/trending conditions
InpTrailingMode=1
InpPartialTP_R=1.3
InpPartialClosePercent=42.0
InpBE_Threshold_R=1.3
InpTrailStart_R=1.7
InpTrailATR_Mult=1.1

; ====== SPREAD ======
; Relaxed for M5 execution (GBP slightly wider than EUR)
InpMaxSpreadPoints=18

; ====== SMC - SMART MONEY CONCEPTS ======
; Full SMC suite - GBP respects institutional levels well
; M5 Structure Settings
InpUseSMC=true
InpSMC_SwingLookback=12
InpSMC_MinImpulseATR=2.4
InpSMC_MinFVG_ATR=0.55

; ====== MULTI-TIMEFRAME ======
; H4 bias, H1 confirmation - Clean HTF structure on GBP
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Filter GBP and USD high-impact news (GBP sensitive to data)
InpUseNewsFilter=true
InpNewsMinutesBefore=35
InpNewsMinutesAfter=35

; ====== KELLY POSITION SIZING ======
; Conservative Quarter Kelly
InpUseKelly=true
InpKellyFraction=0.25
InpDailyMaxDD=2.0
InpWeeklyMaxDD=4.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=true
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

; ====== SESSION GOVERNOR ======
; UPDATED: Active M5 Scalping (3 trades per session)
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpMaxProfitPerSession_R=6.0
InpMaxLossPerSession_R=1.5
InpMinSessionConfidence=0.5
InpTradeCooldownMinutes=12
InpEnableSessionBlacklist=true

; ====== PORTFOLIO PROTECTION ======
; Daily circuit breaker and correlation protection
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=45
InpMaxConsecutiveLosses=2
InpUseReversalFilter=true
