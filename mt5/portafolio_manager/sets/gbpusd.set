; GBPUSD - The Cable - Volatile Major with Strong Trends
; Enhanced with SMC for capturing institutional moves
; Best Timeframe: H1 (Primary), H4 (Bias/Confirmation)
; Best Performance: London session (explosive moves, deeper sweeps)
; Risk Profile: Moderate - wider stops due to volatility
; Target: Win Rate 62-72%, Profit Factor 2.0+
; Correlation: +0.95 with EURUSD, -0.80 with USDJPY
; Characteristics: More impulsive moves, larger daily range, prone to sharp sweeps

; ====== IDENTITY ======
InpMagicNumber=100003

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; GBP is most active during London session
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=true

; ====== FIBONACCI ======
; Wider zones due to volatility and deeper sweeps
InpSwingLookback=20
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.30

; ====== DISPLACEMENT ======
; Strong displacement common in GBP
InpUseDisplacement=true
InpDisplacementATR=1.5
InpDisplacementLookback=5

; ====== RSI ======
; Wider RSI bands for volatile pair
InpRSI_Period=14
InpRSI_Oversold=35
InpRSI_Overbought=65
InpRSI_Momentum=true

; ====== TREND ======
; Strong trends in GBP - higher slope requirement
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.15

; ====== CHOP FILTER ======
; Higher threshold for volatile pair
InpUseChopFilter=true
InpChopThreshold=0.80
InpATR_MA_Period=20

; ====== CONFLUENCE ======
; UPDATED: Maintained strict threshold (6.0 is good for GBP)
InpMinConfluenceEntry=6
InpEnableAddOns=false
InpAddOn1_R=2.0
InpAddOn2_R=3.5
InpMaxPositions=1

; ====== RISK (Before Governor Scaling) ======
; UPDATED: More conservative base (reduced from 0.40)
InpRiskBase=0.18
InpRiskAddOn1=0.12
InpRiskAddOn2=0.08
InpMaxRisk=0.50
InpMaxLotsPerTrade=0.5
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
; Adaptive TP for trending nature
InpTPMode=2
InpFixedTP_R=3.5
InpMinTP_R=2.0
InpMaxTP_R=6.0
InpTPUseLearnedMFE=true

; ====== EXIT ======
; Wider targets for trending nature
InpTrailingMode=1
InpPartialTP_R=2.0
InpPartialClosePercent=40.0
InpBE_Threshold_R=1.5
InpTrailStart_R=2.5
InpTrailATR_Mult=1.3

; ====== SPREAD ======
; Allow wider spreads for GBP
InpMaxSpreadPoints=20

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=2.5
InpSMC_MinFVG_ATR=0.60

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Critical for GBP due to volatility spikes
InpUseNewsFilter=true
InpNewsMinutesBefore=45
InpNewsMinutesAfter=45

; ====== KELLY POSITION SIZING ======
; UPDATED: Quarter Kelly for volatile GBP
InpUseKelly=true
InpKellyFraction=0.25
InpDailyMaxDD=2.0
InpWeeklyMaxDD=4.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

; ====== SESSION GOVERNOR ======
; UPDATED: Only 1 trade per session for volatile GBP
InpUseSessionGovernor=true
InpMaxTradesPerSession=1
InpMaxProfitPerSession_R=3.5
InpMaxLossPerSession_R=1.5
InpMinSessionConfidence=0.5
InpTradeCooldownMinutes=30
InpEnableSessionBlacklist=true

; ====== PORTFOLIO PROTECTION ======
; NEW: Correlation filter and circuit breaker
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=45
