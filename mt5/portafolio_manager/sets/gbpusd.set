; GBPUSD - H4 Timeframe - Swing Trading
; Account: Standard | Strategy: H4 Swing, Adaptive TP, Smart Trailing

InpMagicNumber=100002
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=true
; GBPUSD: London close active - cable respects London session closure

;═══════ FIBONACCI ═══════
InpSwingLookback=20
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=45
InpRSI_Overbought=55
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.1

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=8
InpDominanceThreshold=2.0
InpMaxPositions=3

;═══════ RISK (Before Governor Scaling) ═══════
InpRiskBase=0.5
InpMaxRisk=1.0
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=4.0
InpMinTP_R=2.0
InpMaxTP_R=8.0
InpTPUseLearnedMFE=true

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.5

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=6.0
; GBPUSD: Slightly higher min volatility - cable ranges are larger
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING ═══════
InpPartialTP_R=1.0
InpPartialClosePercent=50.0
InpBE_Threshold_R=0.8
InpTrailStart_R=0.8
InpTrailATR_Mult=1.5
InpTrailDecayRate=0.25
InpTrailMinMult=0.55
; GBPUSD: Tighter trail floor - cable trends strongly when it moves
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.35

;═══════ INFINITE ESCALATOR ═══════
InpEsc_FirstR=0.5
InpEsc_FirstSL_R=-0.1
InpEsc_StepR=0.7
InpEsc_GrowthFactor=1.3
InpEsc_BaseHarvest=15.0
; GBPUSD: Harvest 15% per stage
InpEsc_HarvestDecay=0.85
InpEsc_MinHarvest=3.0
InpEsc_MaxStages=20
InpRunnerTrailTight=0.75
InpTimeStaleMins=240.0
InpTimeStaleTight1=0.8
InpTimeStaleTight2=0.65

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=true
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.15
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.05
InpPyr_MaxAddOns=3
InpPyr_MinProfitR=1.0
InpAgg_MaxTotalRisk=1.5
; GBPUSD: Elevated aggregate risk - cable can run far
InpAgg_MaxPositions=6

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.05
InpRegimeHarvest=true
InpMFECalibration=true
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ CONFLUENCE FLIP EXIT (legacy fallback) ═══════
InpUseConflFlipExit=false
InpConflFlipMinScore=10.0
InpConflFlipDelta=3.0
InpConflFlipOnlyAfterStage0=true

;═══════ STALE TRADE EXIT ═══════
InpUseStaleTrade=true
InpStaleBarLimit=8

;═══════ SMART REVERSAL DETECTION ═══════
InpUseSmartReversal=true
InpUseMFERetraceExit=true
InpUseFlipAndReverse=true
InpRevW_CHoCH=0.40
InpRevW_Divergence=0.25
InpRevW_LiqSweep=0.20
InpRevW_ScoreVelocity=0.15
InpRevExitThreshold=0.55
InpRevExitMinScore=8.0
InpRevOnlyAfterStage0=true
InpRevCHoCH_MaxBars=5
InpRevRegimeGate=3
InpMFERetrace_Threshold=0.40
InpMFERetrace_MinPeakR=1.0
InpMFERetrace_AfterStage0=true
InpFlipRev_MinScore=0.75
InpFlipRev_RiskPct=0.20
InpFlipRev_CooldownBars=2
InpFlipRev_RequireMFE=true
InpFlipRev_MinPeakR=0.5

;═══════ SPREAD ═══════
InpMaxSpreadPoints=35
; GBPUSD: Wider spread tolerance - cable naturally wider spread

;═══════ SMC - SMART MONEY CONCEPTS ═══════
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=2.0
InpSMC_MinFVG_ATR=0.5

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
InpVolatilitySpikeCooldown=30

;═══════ KELLY POSITION SIZING ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0
InpDailyTarget=0.0

;═══════ LEARNING & ADAPTATION ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=true

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=6.0
InpLossCooldownMinutes=30
InpMaxConsecutiveLosses=3
InpMaxDailyTrades=3
InpUseReversalFilter=true
InpReversalCooldownMinutes=60

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=2
InpTradeCooldownMinutes=60
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=60
