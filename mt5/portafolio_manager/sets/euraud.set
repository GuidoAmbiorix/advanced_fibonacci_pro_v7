; EURAUD - Euro Australian Dollar Cross
; Risk sentiment differential
; Best Performance: European and Asian transitions
; Risk Profile: Moderate - commodity vs safe haven
; Target: Win Rate 63-71%, Profit Factor 2.0+
; Correlation: Inverse to risk sentiment strength

; ====== IDENTITY ======
InpMagicNumber=100013
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; Active during European and Asian
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=true
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
InpSwingLookback=22
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.24

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.3
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=38
InpRSI_Overbought=62
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.11

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.74
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.7
InpAddOn2_R=2.9
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.46
InpRiskAddOn1=0.27
InpRiskAddOn2=0.17

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.7
InpPartialClosePercent=43.0
InpBE_Threshold_R=1.3
InpTrailStart_R=2.2
InpTrailATR_Mult=1.15

; ====== SPREAD ======
InpMaxSpreadPoints=24

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=22
InpSMC_MinImpulseATR=2.2
InpSMC_MinFVG_ATR=0.53

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=35
InpNewsMinutesAfter=32

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.46
InpDailyMaxDD=2.8
InpWeeklyMaxDD=5.5

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
