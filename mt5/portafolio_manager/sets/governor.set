; Portfolio Governor - GOAT Instant Funding Pro
; Account: $6,000 Virtual Capital
; Phase 1 Rules: 4% Profit Target | 5% Max DD | 3% Daily DD | 3 Min Days
; Strategy: Conservative Risk, Aggressive Trailing, Fast Profit Locking

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=2.5
; Max Total Portfolio Risk (%)
; Permite hasta 5 symbols activos x 0.5% = 2.5% total
; Conservador para proteger la cuenta

InpMaxSymbolRisk=1.5
; Max Risk Per Symbol (%)
; 1.5% max para permitir max risk en pares selectos
; 0.5% máximo por symbol para prevenir pérdidas grandes

InpMaxGroupRisk=1.5
; Max Risk Per Correlation Group (%)
; Máximo 1.5% por grupo correlacionado (USD, JPY, GBP, etc)

;═══════ DRAWDOWN GOVERNOR ═══════
InpDD_Normal=1.5
; DD Level: Normal Trading (%)
; Empezar a reducir riesgo cuando DD > 1.5%

InpDD_Reduced=2.5
; DD Level: Reduced Risk (%)
; Reducción agresiva cuando DD > 2.5%

InpDD_Pause=4.5
; DD Level: Pause Trading (%) - HARD STOP
; Pausar antes del límite GOAT de 5%

InpDD_ReducedMult=0.50
; Risk Multiplier when DD > Normal
; Cortar riesgo a 50% cuando en drawdown

;═══════ ROLLING PF GOVERNOR ═══════
InpRollingTrades=30
; Rolling Window (trades)
; Ventana de 30 trades para calcular Profit Factor

InpPF_Normal=1.8
; PF Level: Normal Trading
; Target: Ganar $1.80 por cada $1 perdido

InpPF_Reduced=1.2
; PF Level: Reduced Risk
; Warning: Performance degradando

InpPF_Pause=1.0
; PF Level: Pause Trading
; Stop: No hay edge, reevaluar estrategia

InpPF_ReducedMult=0.70
; Risk Mult when PF < Normal
; Reducir riesgo cuando PF baja

;═══════ DAILY/WEEKLY LIMITS ═══════
InpDailyMaxDD=3.0
; Daily Max Drawdown (%)
; GOAT limit: 3% diario ($180)

InpWeeklyMaxDD=4.0
; Weekly Max Drawdown (%)
; Conservador: 4% semanal

InpMonthlyMaxDD=5.0
; Monthly Max Drawdown (%)
; GOAT limit: 5% mensual ($300)

InpDailyTarget=0.0
; Daily Profit Target (%, 0=disabled)

InpDailyTargetUSD=80.0
; Daily Profit Target ($)
; Target conservador: $80/día ($240 / 3 días = $80)
; Cuando se alcanza: cerrar todo y pausar trading

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=true
; Enable Correlation Guard
; ENABLED: Previene overexposure a pares correlacionados

InpHighCorrelation=0.70
; High Correlation Threshold
; Detecta pares correlacionados (EURUSD/GBPUSD, etc)

InpCorrelationReduction=0.50
; Size Reduction Factor
; Reducir 50% el tamaño en entries correlacionadas

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
; Magic Number Base
; Symbol_Engine instances usan 100000-100999

InpMagicRange=999
; Magic Number Range
; Cubre todas las instancias de Symbol_Engine

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=5
; Update Interval (seconds)
; Balance entre responsividad y uso de CPU
