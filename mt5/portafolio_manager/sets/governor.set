; Portfolio Governor - FundingPips 5K Account Configuration
; Optimized for 8 pairs: EURUSD, GBPUSD, USDJPY, AUDUSD, USDCAD, EURJPY, AUDJPY, XAUUSD
; Account: $5,000 FundingPips
; Strategy: Conservative multi-symbol portfolio management

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=2.0
; Max Total Portfolio Risk (%) - Optimized for $10/trade target
; With 8 pairs @ 0.20% each, max risk = $100 total (5 positions max)
; Increased from 1.5% to 2.0% to allow more concurrent positions

InpMaxSymbolRisk=0.30
; Max Risk Per Symbol (%) = $15 per pair
; Allows 6-7 positions max before hitting portfolio limit
; Reduced from 0.4% to better align with $10 base risk

InpMaxGroupRisk=0.60
; Max Risk Per Correlation Group (%)
; Prevents overexposure to USD, JPY, or correlated pairs
; Reduced from 0.8% to maintain discipline with more concurrent trades

;═══════ DRAWDOWN GOVERNOR ═══════
InpDD_Normal=3.0
; DD Level: Normal Trading (%) - Start risk reduction at 3.0%
; Increased from 2.5% to 3.0% to allow more breathing room with $10 trades
; Triggers at -$150 drawdown from peak

InpDD_Reduced=5.0
; DD Level: Reduced Risk (%) - Heavy reduction at 5%
; Increased from 4.0% to 5.0% for better tolerance
; Triggers at -$250 drawdown from peak

InpDD_Pause=7.0
; DD Level: Pause Trading (%) - Emergency stop at 7%
; Increased from 6.0% to 7.0% (still well before FundingPips 10% daily limit)
; Triggers at -$350

InpDD_ReducedMult=0.60
; Risk Multiplier when DD > Normal
; Increased from 0.5 to 0.60 (40% reduction instead of 50%)
; More gradual risk reduction allows recovery

;═══════ ROLLING PF GOVERNOR ═══════
InpRollingTrades=50
; Rolling Window (trades) - Larger sample for 8 pairs
; Increased from 40 to 50 trades (~6-7 trades per pair for better statistics)

InpPF_Normal=1.3
; PF Level: Normal Trading
; Reduced from 1.4 to 1.3 (more achievable target)
; Target: Win $1.30 for every $1 lost (realistic with $10 risk)

InpPF_Reduced=1.15
; PF Level: Reduced Risk
; Reduced from 1.3 to 1.15 (earlier warning signal)
; Warning: Performance degrading, reduce size

InpPF_Pause=0.95
; PF Level: Pause Trading
; Reduced from 1.0 to 0.95 (stop before break-even)
; Stop: Losing money, reassess strategy immediately

InpPF_ReducedMult=0.70
; Risk Mult when PF < Normal
; Increased from 0.65 to 0.70 (reduce size by 30% instead of 35%)
; More gradual reduction allows recovery

;═══════ DAILY/WEEKLY LIMITS ═══════
InpDailyMaxDD=3.0
; Daily Max Drawdown (%) = $150
; Increased from 2.5% to 3.0% - FundingPips allows ~5% daily loss
; Allows 15 losing trades @ $10 before daily stop

InpWeeklyMaxDD=6.0
; Weekly Max Drawdown (%) = $300
; Increased from 5.0% to 6.0% for better tolerance
; Prevents weekly blowout while allowing normal variance

InpMonthlyMaxDD=10.0
; Monthly Max Drawdown (%) = $500
; Increased from 8.0% to 10.0% - matches typical prop firm limits
; Allows full monthly drawdown if needed for recovery

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=true
; Enable Correlation Guard
; Critical for 8-pair portfolio

InpHighCorrelation=0.70
; High Correlation Threshold
; Detects pairs moving together (EURUSD/GBPUSD, AUDUSD/NZDUSD)

InpCorrelationReduction=0.50
; Size Reduction Factor
; Cut position size in half for correlated entries

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
; Magic Number Base
; Symbol_Engine instances use 100000-100999

InpMagicRange=999
; Magic Number Range
; Covers all 8 Symbol_Engine instances

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=5
; Update Interval (seconds)
; Balance between responsiveness and CPU usage
