; Optimized for 3 pairs: EURUSD, GBPUSD, USDJPY
; Account: $5,000 FundingPips
; Strategy: Aggressive London/NY Session Focus

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=5.0
; Max Total Portfolio Risk (%) - FundingPips Hard Cap
; Allows up to 5 simultaneous trades at 1% risk

InpMaxSymbolRisk=2.0
; Max Risk Per Symbol (%)
; Increased to 2.0% to allow scaling (e.g., initial entry + 1 add-on)

InpMaxGroupRisk=3.0
; Max Risk Per Correlation Group (%)
; Increased to 3.0% to allow USD pairs to trade freely (e.g. EURUSD + GBPUSD + USDJPY)

;═══════ DRAWDOWN GOVERNOR ═══════
InpDD_Normal=3.5
; DD Level: Normal Trading (%) - Start risk reduction
; Triggers closer to the daily limit to allow breathing room

InpDD_Reduced=4.0
; DD Level: Reduced Risk (%)
; Strict reduction as we approach daily limit

InpDD_Pause=4.8
; DD Level: Pause Trading (%) - HARD STOP
; MUST be below 5.0% (FundingPips Daily Limit)
; Stops all new trades at 4.8% drawdown

InpDD_ReducedMult=0.60
; Risk Multiplier when DD > Normal
; Increased from 0.5 to 0.60 (40% reduction instead of 50%)
; More gradual risk reduction allows recovery

;═══════ ROLLING PF GOVERNOR ═══════
InpRollingTrades=20
; Rolling Window (trades) - Adjusted for 3 pairs
; Reduced from 50 to 20 for faster adaptation to current market conditions

InpPF_Normal=1.3
; PF Level: Normal Trading
; Reduced from 1.4 to 1.3 (more achievable target)
; Target: Win $1.30 for every $1 lost (realistic with $10 risk)

InpPF_Reduced=1.15
; PF Level: Reduced Risk
; Reduced from 1.3 to 1.15 (earlier warning signal)
; Warning: Performance degrading, reduce size

InpPF_Pause=0.95
; PF Level: Pause Trading
; Reduced from 1.0 to 0.95 (stop before break-even)
; Stop: Losing money, reassess strategy immediately

InpPF_ReducedMult=0.70
; Risk Mult when PF < Normal
; Increased from 0.65 to 0.70 (reduce size by 30% instead of 35%)
; More gradual reduction allows recovery

;═══════ DAILY/WEEKLY LIMITS ═══════
InpDailyMaxDD=4.9
; Daily Max Drawdown (%)
; FundingPips Limit is 5.0% - Set to 4.9% for safety

InpWeeklyMaxDD=8.0
; Weekly Max Drawdown (%)
; Intermediate stop before monthly limit

InpMonthlyMaxDD=9.5
; Monthly Max Drawdown (%)
; FundingPips Limit is 10.0% - Set to 9.5% for safety

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=false
; Enable Correlation Guard
; DISABLED for 3-pair elite portfolio (we want all 3 to trade)

InpHighCorrelation=0.70
; High Correlation Threshold
; Detects pairs moving together (EURUSD/GBPUSD, AUDUSD/NZDUSD)

InpCorrelationReduction=0.50
; Size Reduction Factor
; Cut position size in half for correlated entries

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
; Magic Number Base
; Symbol_Engine instances use 100000-100999

InpMagicRange=999
; Magic Number Range
; Covers all Symbol_Engine instances

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=5
; Update Interval (seconds)
; Balance between responsiveness and CPU usage
