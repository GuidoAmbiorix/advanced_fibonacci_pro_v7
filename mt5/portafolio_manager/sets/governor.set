; Portfolio Governor - H4 Swing Mode
; Account: Standard
; H4 Swing: Aggressive Mode | Let % system manage targets
; Strategy: H4 Swing, Standard Updates, Portfolio % Management

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=100.0
; Max Total Portfolio Risk (%)
; TEST MODE: sin limite

InpMaxSymbolRisk=3.0
; Max Risk Per Symbol (%)

InpMaxGroupRisk=3.0
; Max Risk Per Correlation Group (%)

;═══════ DRAWDOWN GOVERNOR ═══════
InpDD_Normal=3.0
; DD Level: Normal Trading (%)

InpDD_Reduced=6.0
; DD Level: Reduced Risk (%)

InpDD_Pause=10.0
; DD Level: Pause Trading (%) - HARD STOP

InpDD_ReducedMult=0.70
; Risk Multiplier when DD > Normal

;═══════ ROLLING PF GOVERNOR ═══════
InpRollingTrades=30
; Rolling Window (trades)

InpPF_Normal=1.4
InpPF_Reduced=1.0
InpPF_Pause=0.8
InpPF_ReducedMult=0.80

;═══════ DAILY/WEEKLY LIMITS ═══════
InpDailyMaxDD=5.0
; Diario: 5% antes de pausar

InpWeeklyMaxDD=10.0
InpMonthlyMaxDD=15.0

InpDailyTarget=0.0
InpDailyTargetUSD=0.0
; Disabled - let % system manage

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=true
InpHighCorrelation=0.80
InpCorrelationReduction=0.60

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
InpMagicRange=999

;═══════ FRIDAY CLOSE ═══════
InpFridayCloseHour=22

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=5
; H4: Standard update frequency
