; Portfolio Governor - M5 Scalper Mode
; Account: $6,000 Virtual Capital
; Phase 1 Rules: 4% Profit Target | 5% Max DD | 3% Daily DD | 3 Min Days
; Strategy: M5 Scalping, Faster Updates, Tighter Risk Control

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=2.5
; Max Total Portfolio Risk (%)
; Permite hasta 5 symbols activos x 0.5% = 2.5% total

InpMaxSymbolRisk=0.5
; Max Risk Per Symbol (%)

InpMaxGroupRisk=1.5
; Max Risk Per Correlation Group (%)

;═══════ DRAWDOWN GOVERNOR ═══════
InpDD_Normal=1.5
; DD Level: Normal Trading (%)

InpDD_Reduced=2.5
; DD Level: Reduced Risk (%)

InpDD_Pause=4.5
; DD Level: Pause Trading (%) - HARD STOP

InpDD_ReducedMult=0.50
; Risk Multiplier when DD > Normal

;═══════ ROLLING PF GOVERNOR ═══════
InpRollingTrades=30
; Rolling Window (trades)

InpPF_Normal=1.8
InpPF_Reduced=1.2
InpPF_Pause=1.0
InpPF_ReducedMult=0.70

;═══════ DAILY/WEEKLY LIMITS ═══════
InpDailyMaxDD=3.0
; GOAT limit: 3% diario

InpWeeklyMaxDD=4.0
InpMonthlyMaxDD=5.0

InpDailyTarget=0.0
InpDailyTargetUSD=80.0
; Daily Profit Target ($)

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=true
InpHighCorrelation=0.70
InpCorrelationReduction=0.50

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
InpMagicRange=999

;═══════ FRIDAY CLOSE ═══════
InpFridayCloseHour=22

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=3
; M5: Faster updates (3 seconds instead of 5)
; Scalping needs faster DD detection and risk adjustment
