; Portfolio Governor v2 - H4 Swing Mode
; Account: Standard | Production mode
; Governor v2: full risk controls + ASMA + cooldowns

;═══════ SYMBOL ENGINE MAGIC RANGE ═══════
InpMagicMin=100001
InpMagicMax=100020

;═══════ DAILY P&L CONTROL ═══════
InpDailyProfitTarget=0.0
InpDailyLossLimit=-150.0
InpPauseOnProfitTarget=true
InpCloseOnDailyLoss=true

;═══════ PORTFOLIO DRAWDOWN ═══════
InpMaxPortfolioDD_Pct=12.0
InpReduceRiskAt_Pct=6.0
InpCloseAllOnMaxDD=true

;═══════ CORRELATION FILTER ═══════
InpUseCorrelFilter=true
InpMaxSameCurrency=2
InpCloseCorrelOnBreech=false

;═══════ FRIDAY CLOSE ═══════
InpFridayClose=true
InpFridayCloseHour=20
InpFridayCloseMinute=0

;═══════ DISPLAY ═══════
InpShowDashboard=true
InpRefreshSeconds=5
InpDashboardCorner=0

;═══════ TIEMPO Y COOLDOWN ═══════
InpFridayBlockHours=3
InpSymbolCooldownHours=4

;═══════ LÍMITES DE OPERACIÓN ═══════
InpMaxOpenPositions=7
InpMaxDailyTrades=10
InpMaxWeeklyTrades=25

;═══════ RACHA DE PÉRDIDAS ═══════
InpConsecLossReduce=5
InpConsecLossPause=10

;═══════ EQUITY CURVE FILTER ═══════
InpUseEqCurve=true
InpEqCurvePeriod=20
InpEqCurveReductMult=0.6
