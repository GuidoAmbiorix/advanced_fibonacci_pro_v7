; Portfolio Governor - FundingPips 5K Account Configuration
; Optimized for 8 pairs: EURUSD, GBPUSD, USDJPY, AUDUSD, USDCAD, EURJPY, AUDJPY, XAUUSD
; Account: $5,000 FundingPips
; Strategy: Conservative multi-symbol portfolio management

;═══════ PORTFOLIO LIMITS ═══════
InpMaxPortfolioRisk=1.5
; Max Total Portfolio Risk (%) - Conservative for prop firm
; With 8 pairs, max risk = $75 total across all positions

InpMaxSymbolRisk=0.4
; Max Risk Per Symbol (%) = $20 per pair
; Allows 3-4 positions max before hitting portfolio limit

InpMaxGroupRisk=0.8
; Max Risk Per Correlation Group (%)
; Prevents overexposure to USD, JPY, or correlated pairs

;═══════ DRAWDOWN GOVERNOR ═══════
InpDD_Normal=2.5
; DD Level: Normal Trading (%) - Start risk reduction at 2.5%
; H1: Increased from 2.0% to 2.5% (allow slightly more breathing room)
; Triggers at -$125 drawdown from peak

InpDD_Reduced=4.0
; DD Level: Reduced Risk (%) - Heavy reduction at 4%
; Triggers at -$200 drawdown from peak

InpDD_Pause=6.0
; DD Level: Pause Trading (%) - Emergency stop at 6%
; Triggers at -$300 (well before FundingPips daily limit)

InpDD_ReducedMult=0.5
; Risk Multiplier when DD > Normal
; Cuts position sizes in half during drawdown

;═══════ ROLLING PF GOVERNOR ═══════
InpRollingTrades=40
; Rolling Window (trades) - Larger sample for 8 pairs
; ~5 trades per pair for statistical significance

InpPF_Normal=1.4
; PF Level: Normal Trading
; H1: Reduced from 1.6 to 1.4 (more realistic target after bug fixes)
; Target: Win $1.40 for every $1 lost

InpPF_Reduced=1.3
; PF Level: Reduced Risk
; Warning: Performance degrading

InpPF_Pause=1.0
; PF Level: Pause Trading
; Stop: Break-even or losing, reassess strategy

InpPF_ReducedMult=0.65
; Risk Mult when PF < Normal
; Reduce size by 35% when underperforming

;═══════ DAILY/WEEKLY LIMITS ═══════
InpDailyMaxDD=2.5
; Daily Max Drawdown (%) = $125
; FundingPips allows ~5% daily loss, this is conservative

InpWeeklyMaxDD=5.0
; Weekly Max Drawdown (%) = $250
; Prevents weekly blowout

InpMonthlyMaxDD=8.0
; Monthly Max Drawdown (%) = $400
; FundingPips max DD is usually 10%, this stays under

;═══════ CORRELATION GUARD ═══════
InpUseCorrelationGuard=true
; Enable Correlation Guard
; Critical for 8-pair portfolio

InpHighCorrelation=0.70
; High Correlation Threshold
; Detects pairs moving together (EURUSD/GBPUSD, AUDUSD/NZDUSD)

InpCorrelationReduction=0.50
; Size Reduction Factor
; Cut position size in half for correlated entries

;═══════ MAGIC NUMBER RANGE ═══════
InpMagicBase=100000
; Magic Number Base
; Symbol_Engine instances use 100000-100999

InpMagicRange=999
; Magic Number Range
; Covers all 8 Symbol_Engine instances

;═══════ UPDATE FREQUENCY ═══════
InpUpdateSeconds=5
; Update Interval (seconds)
; Balance between responsiveness and CPU usage
