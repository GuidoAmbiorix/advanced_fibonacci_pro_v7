; CADJPY - Canadian Yen Cross - Oil Proxy
; Oil correlation with safe haven
; Best Performance: Asian and NY sessions
; Risk Profile: Moderate - commodity dynamics
; Target: Win Rate 62-70%, Profit Factor 2.0+
; Correlation: +0.70 with oil prices

; ====== IDENTITY ======
InpMagicNumber=100018
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; Asian and NY sessions
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=false
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
InpSwingLookback=22
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.23

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.3
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=39
InpRSI_Overbought=61
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.11

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.74
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.7
InpAddOn2_R=2.9
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.47
InpRiskAddOn1=0.27
InpRiskAddOn2=0.18

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.7
InpPartialClosePercent=43.0
InpBE_Threshold_R=1.3
InpTrailStart_R=2.2
InpTrailATR_Mult=1.15

; ====== SPREAD ======
InpMaxSpreadPoints=22

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=22
InpSMC_MinImpulseATR=2.1
InpSMC_MinFVG_ATR=0.51

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Monitor CAD, JPY, and oil inventory
InpUseNewsFilter=true
InpNewsMinutesBefore=40
InpNewsMinutesAfter=35

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.47
InpDailyMaxDD=2.8
InpWeeklyMaxDD=5.6

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
