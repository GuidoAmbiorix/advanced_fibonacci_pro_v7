; AUDJPYm — BUMP MODE | Risk-on/off sharp reversals
InpMagicNumber=500010
InpBrokerUTCOffset=0
InpMinConfluenceEntry=14.0
InpDominanceThreshold=7.0
InpMaxLotsPerTrade=0.01
InpFixedLots=0.01
InpRiskBase=0.50
InpDirection=0
; --- FILTERS (all off) ---
InpUseKillzoneFilter=false
InpUseTimeFilter=false
InpUseMTF=false
InpUseHMM=false
InpUseMacroSentiment=false
InpUseCorrelationFilter=false
InpUseDXYConflict=false
InpKZRegimeAware=false
; --- NEWS ---
InpUseNewsFilter=false
; --- VOLATILITY ---
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.5
InpVolatilitySpikeCooldown=5
; --- KELLY (off) ---
InpUseKelly=false
; --- COOLDOWNS (all off) ---
InpTradeCooldownMinutes=0
InpLossCooldownMinutes=0
InpReversalCooldownMinutes=0
InpSymbolCooldown=0
InpMaxDailyTrades=0
; --- CONSECUTIVE LOSSES ---
InpMaxConsecutiveLosses=3
; --- INSTANT BE + TRAIL ---
InpInstantBreakeven=true
InpUniversalBE=true
InpUniversalBE_Pips=0.1
InpUniversalTrail_Pips=1.0
; --- SPREAD ---
InpMaxSpreadPoints=22
InpMaxSpreadRanging=300
InpMaxSpreadVolatile=40
; --- SL/TRAIL ---
InpATR_Mult_SL=1.0
InpTrailATR_Mult=1.2
InpSMC_MinImpulseATR=1.0
InpTrailDecayRate=0.50
InpTrailMinMult=0.30
; --- ESCALATOR ---
InpEsc_FirstR=0.05
InpEsc_FirstSL_R=0.02
InpEsc_StepR=0.10
InpEsc_BaseHarvest=90.0
InpEsc_MaxStages=5
; --- GOVERNOR ---
InpGov_Enabled=true
InpGov_DailyMaxDD=8.0
InpGov_DD_Reduce=12.0
InpGov_DD_Pause=20.0
; --- MISC ---
InpTimeStaleMins=3.0
InpTickThrottleSeconds=1
InpMaxPositions=1
InpPipLadder=false
InpDisableFailsafe=true
InpDisablePullbackFilter=true
InpBumpMode=true
InpEnableAdaptiveFilters=false
InpUseH1Trigger=false
InpResetKillSwitch=true
