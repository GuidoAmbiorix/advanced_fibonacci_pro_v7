InpVolatilitySpikeCooldown=0
; --- KELLY (off) ---
InpUseKelly=false
; --- COOLDOWNS (all off) ---
InpTradeCooldownMinutes=0
InpLossCooldownMinutes=0
InpReversalCooldownMinutes=0
InpSymbolCooldown=0
InpMaxDailyTrades=0
; --- INSTANT BE + TRAIL (cross needs more room) ---
