; EURJPYm — SCALPING M15 | Exness Standard | 0.01 lots
; Sessions: Asian + London Open + NY (cubre las 3, momentum fuerte)
; Spread Standard: 0.7-1.5 pip
InpMagicNumber=400007
InpBrokerUTCOffset=0
InpMinConfluenceEntry=18.0
InpMaxLotsPerTrade=0.01
InpFixedLots=0.01
InpRiskBase=0.50
InpDirection=0
; --- KILLZONES ---
InpUseKillzoneFilter=true
InpKZRegimeAware=false
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpNotifyKillzoneOpen=true
InpCloseOnKillzoneEnd=true
InpKZBEMinutesBefore=10
InpKZBEMinProfitR=0.1
; --- TIME WINDOW (disabled) ---
InpUseTimeFilter=false
; --- INSTANT BREAKEVEN + TRAIL ---
InpInstantBreakeven=true
InpUniversalBE=true
InpUniversalBE_Pips=0.1
InpUniversalTrail_Pips=1.0
; --- SPREAD (JPY cross = wider) ---
InpMaxSpreadPoints=25
InpMaxSpreadRanging=25
InpMaxSpreadVolatile=40
; --- ESCALATOR ---
InpEsc_FirstR=0.05
InpEsc_FirstSL_R=0.02
InpEsc_StepR=0.10
InpEsc_GrowthFactor=1.0
InpEsc_BaseHarvest=90.0
InpEsc_HarvestDecay=1.0
InpEsc_MinHarvest=20.0
InpEsc_MaxStages=10
; --- TRAIL/SL (JPY cross = slightly wider) ---
InpTrailATR_Mult=1.5
InpATR_Mult_SL=1.2
InpSMC_MinImpulseATR=1.3
InpMTF_Weight=0.5
InpTrailDecayRate=0.50
InpTrailMinMult=0.30
; --- FILTERS ---
InpUseHMM=true
InpUseMacroSentiment=true
InpUseMTF=true
InpMTF=16408
InpMTF_EMAPeriod=50
InpTickThrottleSeconds=5
InpUseCorrelationFilter=true
InpMaxCurrencyExposure=0.25
; --- PIP LADDER (cross = wider pips) ---
InpPipLadder=true
InpTightPips1=6
InpTightFactor1=0.80
InpTightPips2=10
InpTightFactor2=0.60
InpTightPips3=15
InpTightFactor3=0.40
; --- MISC ---
InpTimeStaleMins=15.0
InpMaxPositions=1

; --- NEWS FILTER ---
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
InpVolatilitySpikeCooldown=15
