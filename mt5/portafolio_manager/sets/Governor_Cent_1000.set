; Portfolio Governor - Cent Account Setup
; Balance: 1000 USC (= $10)
; Target: 100 USC (= $1.00)
; ---------------------------------------

; Daily Limits (Money) - The "Hit and Run"
InpUseDailyLimits=true
InpDailyProfitTarget=100.0
InpDailyLossLimit=100.0
InpCloseAllOnLimit=true

; Update Frequency
InpUpdateSeconds=1

; Risk Management Defaults
InpMaxPortfolioRisk=5.0
InpMaxSymbolRisk=2.0
InpDailyMaxDD=5.0
InpWeeklyMaxDD=10.0
