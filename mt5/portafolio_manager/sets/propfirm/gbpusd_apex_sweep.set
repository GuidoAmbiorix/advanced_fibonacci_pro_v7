; GBPUSD — APEX Sweep | Exness Personal Account
; Timeframe: M5 | Window: 07:00-08:30 UTC (London open extendido)
; ─────────────────────────────────────────────────
; Asian range típico: 20-35 pips
; SL típico: ~25 pips = $2.50 | TP 1.5R: ~37 pips = $3.75
; "Judas Swing" — fake move más agresivo que EUR, necesita más tolerancia
; Governor cap: $2.00/día → pausa este símbolo solo
; ─────────────────────────────────────────────────
; LOTS: 0.01 fijos siempre
; ─────────────────────────────────────────────────

InpMagicNumber=100047
InpApexMode=6
InpDirection=0
InpBrokerUTCOffset=0

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=false
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=false
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false
InpCloseOnKillzoneEnd=false
InpKZBEMinutesBefore=0
InpKZBEMinProfitR=0.0
InpNotifyKillzoneOpen=false

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=6
InpDominanceThreshold=0.0
InpMaxPositions=1

;═══════ RISK ═══════
; 0.01 lots fijos — pip value $0.10
InpRiskBase=0.5
InpMaxRisk=1.0
InpMaxLotsPerTrade=0.10
InpFixedLots=0.10
InpEnableMarginCheck=true

;═══════ FIBONACCI ═══════
; GBP necesita tolerancia extra — Judas Swing es más amplio
InpSwingLookback=10
InpFibLevelLow=0.500
InpFibLevelHigh=0.618
InpZoneTolerance=0.25

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=false
InpDisplacementATR=1.0
InpDisplacementLookback=3

;═══════ RSI ═══════
InpRSI_Period=8
InpRSI_Oversold=30
InpRSI_Overbought=70
InpRSI_Momentum=false

;═══════ TREND FILTER ═══════
InpUseTrendFilter=false
InpEMA_Period=200
InpEMA_MinSlope=0.0

;═══════ CHOP FILTER ═══════
InpUseChopFilter=false
InpChopThreshold=0.75
InpATR_MA_Period=20

;═══════ TAKE PROFIT ═══════
InpTPMode=1
InpFixedTP_R=1.5
InpMinTP_R=1.0
InpMaxTP_R=2.5
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=0
InpTrailType=0
InpTrailStepATR=0.3

;═══════ VOLATILITY FILTER ═══════
; GBP más volátil — threshold más alto que EUR, menor que gold
InpMinVolatilityPips=4.0
InpMaxVolatilityFactor=4.5
InpVolatilityTP_Mult=1.5

;═══════ PARTIAL TP & TRAILING ═══════
InpPartialTP_R=0.8
InpPartialClosePercent=50.0
InpBE_Threshold_R=0.3
InpTrailStart_R=0.3
InpTrailATR_Mult=0.8
InpTrailDecayRate=0.40
InpTrailMinMult=0.30
InpTrailRegimeAware=false
InpTrailMinBufferATR=0.10

;═══════ INFINITE ESCALATOR ═══════
InpEsc_FirstR=0.3
InpEsc_FirstSL_R=-0.05
InpEsc_StepR=0.4
InpEsc_GrowthFactor=1.1
InpEsc_BaseHarvest=50.0
InpEsc_HarvestDecay=0.80
InpEsc_MinHarvest=15.0
InpEsc_MaxStages=4
InpRunnerTrailTight=0.85
InpTimeStaleMins=30.0
InpTimeStaleTight1=0.85
InpTimeStaleTight2=0.75

;═══════ PIP LADDER TRAIL ═══════
InpPipLadder=false

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=1
InpPyr_MinProfitR=1.0
InpAgg_MaxTotalRisk=1.0
InpAgg_MaxPositions=1

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.05
InpRegimeHarvest=false
InpMFECalibration=false
InpMomentumTrail=false
InpChaosEmergencyLock=true
InpFridayCloseHour=20

;═══════ STALE TRADE EXIT ═══════
; GBP: ventana más larga — 8 velas = 40 min
InpUseStaleTrade=true
InpStaleBarLimit=8

;═══════ SPREAD ═══════
; GBP spread London open: ~0.5-1.5 pip = 5-15 puntos
; Bloquear si spread > 25 puntos (2.5 pip) — señal de news o volatilidad
InpMaxSpreadPoints=25
InpMaxSpreadRanging=25
InpMaxSpreadVolatile=40

;═══════ SMC ═══════
InpUseSMC=false
InpSMC_SwingLookback=10
InpSMC_MinImpulseATR=1.0
InpSMC_MinFVG_ATR=0.3

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=false
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
; GBP news es más agresivo — buffer extra
InpUseNewsFilter=true
InpNewsMinutesBefore=20
InpNewsMinutesAfter=20

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.5
InpVolatilitySpikeCooldown=20

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=5.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=60
InpMinTradesForLearning=10

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=8.0
InpLossCooldownMinutes=120
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=3
InpUseReversalFilter=false
InpReversalCooldownMinutes=60

;═══════ SESSION GOVERNOR ═══════
; Ventana 07:00-08:30 UTC — GBP tiene window más larga
; Cooldown 20 min entre trades
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpTradeCooldownMinutes=20
InpCloseIntradayProfits=false
InpEndOfDayHour=10

;═══════ EQUITY GUARD ═══════
InpDailyProfitCapPct=0.0
InpEquityTrailPct=0.0
InpHotStreakBonus=0
InpADR_MaxConsumed=0.40

;═══════ PROP FIRM COMPLIANCE ═══════
InpPFC_Enabled=false
InpPFC_FloatLossLimit=0.0
InpPFC_ConsistencyPct=0.0
InpPFC_DailyLossMaxPct=0.0
InpPFC_FridayUTCHour=0

;═══════ GOVERNOR ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=2.0
InpGov_DD_Pause=4.0
InpGov_ReducedMult=0.5
InpGov_DailyMaxDD=2.5

;═══════ MOMENTUM EXIT ═══════
InpUseMomentumExit=true
InpMomADX_Period=14
InpMomADX_Threshold=18.0
InpMomATR_CollapseRatio=0.60
InpMomBarsNoProgress=3
InpMomProgressATR=0.15
InpMomSignalsToExit=2
InpMomRecoveryMinScore=1

;═══════ VISUAL / REGIME ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=5
InpUseRollingMode=false
InpSymbolCooldown=1
InpUseH1Trigger=false
InpUseVolTarget=false
InpUseHMM=false
InpUseERFractal=false
InpUseMacroSentiment=false
InpUseDXYConflict=false
InpMaxCurrencyExposure=0.0
