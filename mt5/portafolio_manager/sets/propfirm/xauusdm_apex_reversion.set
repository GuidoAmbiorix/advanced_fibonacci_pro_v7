; XAUUSD — APEX Reversal (Mean Reversion)
; Timeframe: M30 | Entry: exhaustion reversals | Target: VWAP + BB midline
; Philosophy: Catch 3-5 daily gold reversions. Fast BE, small R, high WR.
; Regime: RANGING + VOLATILE ideal. ADR >80% consumed.

InpMagicNumber=100041
InpApexMode=1
InpDirection=0
InpBrokerUTCOffset=3

;═══════ KILLZONES ═══════
; Reversions happen all session — no killzone restriction
InpUseKillzoneFilter=false
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=false
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false
InpCloseOnKillzoneEnd=false
InpKZBEMinutesBefore=0
InpKZBEMinProfitR=0.0
InpNotifyKillzoneOpen=false

;═══════ CONFLUENCE ═══════
; APEX scoring: 0-12 scale. Min 6 = valid signal.
InpMinConfluenceEntry=6
InpDominanceThreshold=0.0
InpMaxPositions=2

;═══════ RISK ═══════
InpRiskBase=0.5
InpMaxRisk=1.0
InpMaxLotsPerTrade=0.5
InpFixedLots=0.01
InpEnableMarginCheck=true

;═══════ FIBONACCI (unused in APEX mode, set neutral) ═══════
InpSwingLookback=20
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=false
InpDisplacementATR=1.0
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=30
InpRSI_Overbought=70
InpRSI_Momentum=false

;═══════ TREND FILTER ═══════
; Disabled — reversions trade against short-term trend
InpUseTrendFilter=false
InpEMA_Period=200
InpEMA_MinSlope=0.0

;═══════ CHOP FILTER ═══════
InpUseChopFilter=false
InpChopThreshold=0.75
InpATR_MA_Period=20

;═══════ TAKE PROFIT ═══════
; Reversion: tight TP. TP1=VWAP (fast), TP2=BB midline
InpTPMode=1
InpFixedTP_R=2.0
InpMinTP_R=1.0
InpMaxTP_R=3.0
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=0
InpTrailStepATR=0.3

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=10.0
InpMaxVolatilityFactor=4.0
InpVolatilityTP_Mult=2.0

;═══════ PARTIAL TP & TRAILING ═══════
; Fast securing: 50% at 0.5R, BE immediately
InpPartialTP_R=0.5
InpPartialClosePercent=50.0
InpBE_Threshold_R=0.3
InpTrailStart_R=0.3
InpTrailATR_Mult=1.0
InpTrailDecayRate=0.40
InpTrailMinMult=0.30
InpTrailRegimeAware=false
InpTrailMinBufferATR=0.15

;═══════ INFINITE ESCALATOR ═══════
; Tight stages — reversions don't run far
InpEsc_FirstR=0.3
InpEsc_FirstSL_R=-0.05
InpEsc_StepR=0.5
InpEsc_GrowthFactor=1.2
InpEsc_BaseHarvest=40.0
InpEsc_HarvestDecay=0.80
InpEsc_MinHarvest=10.0
InpEsc_MaxStages=8
InpRunnerTrailTight=0.85
InpTimeStaleMins=60.0
InpTimeStaleTight1=0.85
InpTimeStaleTight2=0.70

;═══════ PIP LADDER TRAIL ═══════
InpPipLadder=false

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=1
InpPyr_MinProfitR=1.0
InpAgg_MaxTotalRisk=1.0
InpAgg_MaxPositions=2

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=false
InpScoreAdaptFactor=0.05
InpRegimeHarvest=false
InpMFECalibration=false
InpMomentumTrail=false
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ STALE TRADE EXIT ═══════
; M30 reversions: exit if stuck after 6 bars (3h)
InpUseStaleTrade=true
InpStaleBarLimit=6

;═══════ SPREAD ═══════
InpMaxSpreadPoints=9999
InpMaxSpreadRanging=9999
InpMaxSpreadVolatile=9999

;═══════ SMC ═══════
InpUseSMC=false
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=1.2
InpSMC_MinFVG_ATR=0.5

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=false
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=false
InpNewsMinutesBefore=10
InpNewsMinutesAfter=10

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
InpVolatilitySpikeCooldown=15

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=90
InpMinTradesForLearning=20

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=4.0
InpLossCooldownMinutes=30
InpMaxConsecutiveLosses=3
InpMaxDailyTrades=6
InpUseReversalFilter=false
InpReversalCooldownMinutes=15

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=false
InpMaxTradesPerSession=6
InpTradeCooldownMinutes=15
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ EQUITY GUARD ═══════
InpDailyProfitCapPct=0.0
InpEquityTrailPct=0.0
InpHotStreakBonus=0
InpADR_MaxConsumed=0.0

;═══════ PROP FIRM COMPLIANCE ═══════
InpPFC_Enabled=false
InpPFC_FloatLossLimit=0.0
InpPFC_ConsistencyPct=0.0
InpPFC_DailyLossMaxPct=0.0
InpPFC_FridayUTCHour=0

;═══════ GOVERNOR ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=3.0
InpGov_DD_Pause=6.0
InpGov_ReducedMult=0.5
InpGov_DailyMaxDD=3.0

;═══════ MOMENTUM EXIT ═══════
; Fast exit if momentum dies — critical for reversions
InpUseMomentumExit=true
InpMomADX_Period=14
InpMomADX_Threshold=20.0
InpMomATR_CollapseRatio=0.60
InpMomBarsNoProgress=4
InpMomProgressATR=0.20
InpMomSignalsToExit=2
InpMomRecoveryMinScore=1

;═══════ VISUAL / REGIME ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=30
InpUseRollingMode=false
InpSymbolCooldown=1
InpUseH1Trigger=false
InpUseVolTarget=false
InpUseHMM=false
InpUseERFractal=false
InpUseMacroSentiment=false
InpUseDXYConflict=false
InpMaxCurrencyExposure=0.0
