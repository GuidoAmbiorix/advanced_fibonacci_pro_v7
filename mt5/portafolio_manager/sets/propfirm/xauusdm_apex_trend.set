; XAUUSD — APEX Trend (Trend Following)
; Timeframe: H4 | Entry: pullbacks into EMA+structure in strong trend
; Philosophy: Ride institutional gold swings. Wide trail, big TP, patience.
; Regime: TREND_STRONG ideal.

InpMagicNumber=100042
InpApexMode=2
InpDirection=0
InpBrokerUTCOffset=3

;═══════ KILLZONES ═══════
; H4 trend: London + NY provide the big moves
InpUseKillzoneFilter=false
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=false
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false
InpCloseOnKillzoneEnd=false
InpKZBEMinutesBefore=0
InpKZBEMinProfitR=0.0
InpNotifyKillzoneOpen=false

;═══════ CONFLUENCE ═══════
; APEX scoring: 0-12. Min 6 valid, target 8+ for trend.
InpMinConfluenceEntry=8
InpDominanceThreshold=2.0
InpMaxPositions=2

;═══════ RISK ═══════
; H4 trend: larger SL, controlled risk
InpRiskBase=0.5
InpMaxRisk=1.0
InpMaxLotsPerTrade=0.5
InpFixedLots=0.01
InpEnableMarginCheck=true

;═══════ FIBONACCI ═══════
InpSwingLookback=30
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.35

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.5
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

;═══════ TREND FILTER ═══════
InpUseTrendFilter=true
InpEMA_Period=200
InpEMA_MinSlope=0.05

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.65
InpATR_MA_Period=20

;═══════ TAKE PROFIT ═══════
; Trend: let it run. TP1 at 3R, TP2 at 6R.
InpTPMode=2
InpFixedTP_R=4.0
InpMinTP_R=3.0
InpMaxTP_R=8.0
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.5

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=15.0
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING ═══════
; Trend: hold runner. Small partial, wide trail.
InpPartialTP_R=1.0
InpPartialClosePercent=30.0
InpBE_Threshold_R=0.5
InpTrailStart_R=0.5
InpTrailATR_Mult=2.0
InpTrailDecayRate=0.20
InpTrailMinMult=0.60
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.25

;═══════ INFINITE ESCALATOR ═══════
; Trend: wider stages, let profit run
InpEsc_FirstR=0.8
InpEsc_FirstSL_R=-0.05
InpEsc_StepR=0.8
InpEsc_GrowthFactor=1.4
InpEsc_BaseHarvest=20.0
InpEsc_HarvestDecay=0.90
InpEsc_MinHarvest=5.0
InpEsc_MaxStages=20
InpRunnerTrailTight=0.90
InpTimeStaleMins=480.0
InpTimeStaleTight1=0.88
InpTimeStaleTight2=0.75

;═══════ PIP LADDER TRAIL ═══════
InpPipLadder=false

;═══════ SCALE-IN PYRAMID ═══════
; Trend: pyramid into winners
InpPyr_Enable=true
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.15
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.05
InpPyr_MaxAddOns=3
InpPyr_MinProfitR=1.5
InpAgg_MaxTotalRisk=1.5
InpAgg_MaxPositions=4

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.06
InpRegimeHarvest=true
InpMFECalibration=false
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ STALE TRADE EXIT ═══════
; H4 trend: 12 bars = 48h before calling it stale
InpUseStaleTrade=true
InpStaleBarLimit=12

;═══════ SPREAD ═══════
InpMaxSpreadPoints=9999
InpMaxSpreadRanging=9999
InpMaxSpreadVolatile=9999

;═══════ SMC ═══════
InpUseSMC=true
InpSMC_SwingLookback=24
InpSMC_MinImpulseATR=1.5
InpSMC_MinFVG_ATR=0.5

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
InpVolatilitySpikeCooldown=30

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=4.0
InpWeeklyMaxDD=8.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=30

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=5.0
InpLossCooldownMinutes=60
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=3
InpUseReversalFilter=true
InpReversalCooldownMinutes=120

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=2
InpTradeCooldownMinutes=60
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ EQUITY GUARD ═══════
InpDailyProfitCapPct=0.0
InpEquityTrailPct=0.0
InpHotStreakBonus=0
InpADR_MaxConsumed=0.0

;═══════ PROP FIRM COMPLIANCE ═══════
InpPFC_Enabled=false
InpPFC_FloatLossLimit=0.0
InpPFC_ConsistencyPct=0.0
InpPFC_DailyLossMaxPct=0.0
InpPFC_FridayUTCHour=0

;═══════ GOVERNOR ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=3.0
InpGov_DD_Pause=6.0
InpGov_ReducedMult=0.5
InpGov_DailyMaxDD=3.0

;═══════ MOMENTUM EXIT ═══════
InpUseMomentumExit=true
InpMomADX_Period=14
InpMomADX_Threshold=25.0
InpMomATR_CollapseRatio=0.55
InpMomBarsNoProgress=8
InpMomProgressATR=0.30
InpMomSignalsToExit=3
InpMomRecoveryMinScore=2

;═══════ VISUAL / REGIME ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=60
InpUseRollingMode=true
InpSymbolCooldown=4
InpUseH1Trigger=true
InpUseVolTarget=true
InpUseHMM=true
InpUseERFractal=true
InpUseMacroSentiment=true
InpUseDXYConflict=true
InpMaxCurrencyExposure=0.0
