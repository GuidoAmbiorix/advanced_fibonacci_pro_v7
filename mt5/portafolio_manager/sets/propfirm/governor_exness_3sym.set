; Governor — Exness Personal Account (5 símbolos)
; ─────────────────────────────────────────────────
; Magic 100045 (XAU), 100046 (EUR), 100047 (GBP), 100048 (JPY), 100049 (AUD)
; Lots fijos 0.01 en los 5 — riesgo por trade máximo $2.50
; Target: $2/símbolo → $10 acumulado cuando los 5 llegan
; ─────────────────────────────────────────────────

;═══════ MAGIC RANGE ═══════
InpMagicMin=100045
InpMagicMax=100049

;═══════ DAILY P&L ═══════
; Por símbolo: $2.00 — cuando llega, pausa ese símbolo solo
; Global target: $10.00 — si los 5 llegan, pausa todo
InpDailyProfitTarget=10.0
InpDailyLossLimit=-20.0
InpPauseOnProfitTarget=true
InpCloseOnProfitTarget=false
InpCloseOnDailyLoss=true
InpSymbolDailyTarget=2.0

;═══════ PORTFOLIO DRAWDOWN ═══════
; DD máximo $30 en cuenta $500 (6%) — ajustar según capital
InpMaxPortfolioDD_Pct=6.0
InpReduceRiskAt_Pct=3.0
InpCloseAllOnMaxDD=true

;═══════ CORRELATION FILTER ═══════
; EUR, GBP, AUD comparten USD — permitir hasta 3 exposiciones
; USDJPY es inverso: protege días de USD fuerte
InpUseCorrelFilter=true
InpMaxSameCurrency=3
InpCloseCorrelOnBreech=false

;═══════ INSTITUTIONAL SAFETY ═══════
InpEquityVelocityLimit=1.5
InpGlobalVolatileLimit=3

;═══════ FRIDAY CLOSE ═══════
InpFridayClose=true
InpFridayCloseHour=20
InpFridayCloseMinute=0

;═══════ DISPLAY ═══════
InpShowDashboard=true
InpRefreshSeconds=5

;═══════ TIEMPO Y COOLDOWN ═══════
InpFridayBlockHours=3
InpSymbolCooldownHours=0

;═══════ LÍMITES DE OPERACIÓN ═══════
; 5 símbolos × max 3 trades c/u = 15 diarios max
InpMaxOpenPositions=5
InpMaxDailyTrades=15
InpMaxWeeklyTrades=75

;═══════ RACHA DE PÉRDIDAS ═══════
; Reducir riesgo después de 3 losses globales, pausar a los 5
InpConsecLossReduce=3
InpConsecLossPause=5

;═══════ EQUITY CURVE FILTER ═══════
InpUseEqCurve=true
InpEqCurvePeriod=20
InpEqCurveReductMult=0.5
