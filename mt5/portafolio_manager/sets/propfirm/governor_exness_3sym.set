; Governor — Exness Personal Account (XAUUSD + EURUSD + GBPUSD)
; ─────────────────────────────────────────────────
; 3 símbolos: Magic 100045 (XAU), 100046 (EUR), 100047 (GBP)
; Lots fijos 0.01 en los 3 — riesgo por trade máximo $2.50
; Target: $2/símbolo → $6 acumulado cuando los 3 llegan
; ─────────────────────────────────────────────────

;═══════ MAGIC RANGE ═══════
InpMagicMin=100045
InpMagicMax=100047

;═══════ DAILY P&L ═══════
; Por símbolo: $2.00 — cuando llega, pausa ese símbolo solo
; Global target: $6.00 — si los 3 llegan, pausa todo
InpDailyProfitTarget=6.0
InpDailyLossLimit=-15.0
InpPauseOnProfitTarget=true
InpCloseOnProfitTarget=false
InpCloseOnDailyLoss=true
InpSymbolDailyTarget=2.0

;═══════ PORTFOLIO DRAWDOWN ═══════
; DD máximo $30 en cuenta $500 (6%) — ajustar según capital
InpMaxPortfolioDD_Pct=6.0
InpReduceRiskAt_Pct=3.0
InpCloseAllOnMaxDD=true

;═══════ CORRELATION FILTER ═══════
; EUR y GBP comparten USD — permitir hasta 2 exposiciones
InpUseCorrelFilter=true
InpMaxSameCurrency=2
InpCloseCorrelOnBreech=false

;═══════ INSTITUTIONAL SAFETY ═══════
InpEquityVelocityLimit=1.5
InpGlobalVolatileLimit=3

;═══════ FRIDAY CLOSE ═══════
InpFridayClose=true
InpFridayCloseHour=20
InpFridayCloseMinute=0

;═══════ DISPLAY ═══════
InpShowDashboard=true
InpRefreshSeconds=5

;═══════ TIEMPO Y COOLDOWN ═══════
InpFridayBlockHours=3
InpSymbolCooldownHours=0

;═══════ LÍMITES DE OPERACIÓN ═══════
; 3 símbolos × max 3 trades c/u = 9 diarios max
InpMaxOpenPositions=3
InpMaxDailyTrades=9
InpMaxWeeklyTrades=45

;═══════ RACHA DE PÉRDIDAS ═══════
; Reducir riesgo después de 3 losses globales, pausar a los 5
InpConsecLossReduce=3
InpConsecLossPause=5

;═══════ EQUITY CURVE FILTER ═══════
InpUseEqCurve=true
InpEqCurvePeriod=20
InpEqCurveReductMult=0.5
