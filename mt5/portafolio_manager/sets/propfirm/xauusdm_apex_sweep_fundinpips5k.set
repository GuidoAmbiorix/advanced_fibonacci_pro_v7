; XAUUSD — APEX Sweep | FundingPips Zero Challenge $5K
; Timeframe: M5 | Window: 07:00-07:45 UTC
; ─────────────────────────────────────────────────
; REGLAS FUNDINPIPS $5K ZERO CHALLENGE:
;   Daily Loss:   3%  = $150  → Governor limit $130 (buffer)
;   Max Loss:     5%  = $250  → Governor DD    4.0% (buffer)
;   Consistency:  15% Master → Governor target $20/día (auto-satisface)
;   Min days:     7 días
;   Split:        95% biweekly
; ─────────────────────────────────────────────────
; LOTS: 0.05 fijos — nunca escalar
;   Win típico:  $22.50 | Loss típico: $8.75
;   Daily limit $130: necesitás 14 losses seguidos para violarlo (imposible)
; ─────────────────────────────────────────────────

InpMagicNumber=100045
InpApexMode=5
InpDirection=0
InpBrokerUTCOffset=3

