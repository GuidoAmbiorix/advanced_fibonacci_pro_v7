; GOVERNOR — Cuenta Propia $50 · Exness · H4 Conservador
; Philosophy: Cold, calculated, protect the account above all else.
; Sin reglas propfirm — límites propios para cuenta de $50.
; XAUUSD: 36% riesgo/trade — necesita control estricto del governor.
; Magic range: 100031-100035 (5 pares: XAUUSD, GBPJPY, GBPUSD, EURJPY, AUDJPY)

InpMagicMin=100031
InpMagicMax=100035

;═══════ DAILY P&L CONTROL ═══════
; 10% daily loss máximo = $5. Governor dispara a $4.50 (buffer antes del límite).
; Con XAUUSD un solo SL hit = -$18, por eso el límite diario NO evita ese caso
; individual — el governor protege el día completo, no el trade individual.
InpDailyProfitTarget=0.0
InpDailyLossLimit=-4.50
InpPauseOnProfitTarget=false
InpCloseOnDailyLoss=true

;═══════ PORTFOLIO DRAWDOWN ═══════
; Sin propfirm DD rule. Auto-protección: cierre total al 15% DD ($7.50).
; Reduce riesgo al 8% DD ($4.00) — da margen para recuperar antes del cierre.
InpMaxPortfolioDD_Pct=15.0
InpReduceRiskAt_Pct=8.0
InpCloseAllOnMaxDD=true

;═══════ CORRELATION FILTER ═══════
; JPY pairs pueden correlacionar — máx 2 posiciones en la misma divisa.
InpUseCorrelFilter=true
InpMaxSameCurrency=2
InpCloseCorrelOnBreech=false

;═══════ INSTITUTIONAL SAFETY ═══════
InpEquityVelocityLimit=0.5
InpGlobalVolatileLimit=2

;═══════ FRIDAY CLOSE ═══════
; UTC+2 broker: 21:00 UTC = 23:00 broker. Cerrar TODO antes del fin de semana.
InpFridayClose=true
InpFridayCloseHour=23
InpFridayCloseMinute=0

;═══════ DISPLAY ═══════
InpShowDashboard=true
InpRefreshSeconds=5

;═══════ TIEMPO Y COOLDOWN ═══════
InpFridayBlockHours=2
InpSymbolCooldownHours=4

;═══════ LÍMITES DE OPERACIÓN ═══════
; H4 conservador: máx 5 trades/día (1 por par), 15 semanales.
InpMaxOpenPositions=5
InpMaxDailyTrades=5
InpMaxWeeklyTrades=15

;═══════ RACHA DE PÉRDIDAS ═══════
; Cuenta pequeña: reducir riesgo en 2 pérdidas seguidas, pausar en 3.
InpConsecLossReduce=2
InpConsecLossPause=3

;═══════ EQUITY CURVE FILTER ═══════
InpUseEqCurve=true
InpEqCurvePeriod=20
InpEqCurveReductMult=0.5
