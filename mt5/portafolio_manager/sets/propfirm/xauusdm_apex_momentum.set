; XAUUSD — APEX Momentum (H1 Momentum Burst)
; Timeframe: H1 | Entry: RSI/MACD cross with volume ignition
; Philosophy: Ride the first 2-4 hours of a momentum burst after compression.
; Regime: SQUEEZE breaking into TREND ideal.

InpMagicNumber=100043
InpApexMode=3
InpDirection=0
InpBrokerUTCOffset=3

;═══════ KILLZONES ═══════
; Momentum ignites at London Open + NY Open
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpCloseOnKillzoneEnd=false
InpKZBEMinutesBefore=20
InpKZBEMinProfitR=0.2
InpNotifyKillzoneOpen=true

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=6
InpDominanceThreshold=1.0
InpMaxPositions=2

;═══════ RISK ═══════
InpRiskBase=0.5
InpMaxRisk=1.0
InpMaxLotsPerTrade=0.5
InpFixedLots=0.0
InpEnableMarginCheck=true

;═══════ FIBONACCI ═══════
InpSwingLookback=20
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.30

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=35
InpRSI_Overbought=65
InpRSI_Momentum=true

;═══════ TREND FILTER ═══════
InpUseTrendFilter=true
InpEMA_Period=200
InpEMA_MinSlope=0.05

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.70
InpATR_MA_Period=20

;═══════ TAKE PROFIT ═══════
; Momentum: TP1=2R fast capture, TP2=4R if running
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=2.0
InpMaxTP_R=5.0
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.4

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=12.0
InpMaxVolatilityFactor=3.5
InpVolatilityTP_Mult=2.5

;═══════ PARTIAL TP & TRAILING ═══════
; 50% out at 1R, trail the runner
InpPartialTP_R=1.0
InpPartialClosePercent=50.0
InpBE_Threshold_R=0.5
InpTrailStart_R=0.5
InpTrailATR_Mult=1.5
InpTrailDecayRate=0.30
InpTrailMinMult=0.40
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.20

;═══════ INFINITE ESCALATOR ═══════
InpEsc_FirstR=0.5
InpEsc_FirstSL_R=-0.05
InpEsc_StepR=0.7
InpEsc_GrowthFactor=1.3
InpEsc_BaseHarvest=30.0
InpEsc_HarvestDecay=0.85
InpEsc_MinHarvest=8.0
InpEsc_MaxStages=15
InpRunnerTrailTight=0.88
InpTimeStaleMins=180.0
InpTimeStaleTight1=0.88
InpTimeStaleTight2=0.75

;═══════ PIP LADDER TRAIL ═══════
InpPipLadder=false

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=2
InpPyr_MinProfitR=1.0
InpAgg_MaxTotalRisk=1.5
InpAgg_MaxPositions=3

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.05
InpRegimeHarvest=true
InpMFECalibration=false
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ STALE TRADE EXIT ═══════
; H1 momentum: 8 bars = 8 hours before calling stale
InpUseStaleTrade=true
InpStaleBarLimit=8

;═══════ SPREAD ═══════
InpMaxSpreadPoints=9999
InpMaxSpreadRanging=9999
InpMaxSpreadVolatile=9999

;═══════ SMC ═══════
InpUseSMC=false
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=1.2
InpSMC_MinFVG_ATR=0.5

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=false
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=15
InpNewsMinutesAfter=15

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
InpVolatilitySpikeCooldown=20

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=90
InpMinTradesForLearning=20

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=4.0
InpLossCooldownMinutes=45
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=5
InpUseReversalFilter=true
InpReversalCooldownMinutes=60

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpTradeCooldownMinutes=30
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ EQUITY GUARD ═══════
InpDailyProfitCapPct=3.0
InpEquityTrailPct=0.35
InpHotStreakBonus=2
InpADR_MaxConsumed=0.0

;═══════ PROP FIRM COMPLIANCE ═══════
InpPFC_Enabled=false
InpPFC_FloatLossLimit=0.0
InpPFC_ConsistencyPct=0.0
InpPFC_DailyLossMaxPct=0.0
InpPFC_FridayUTCHour=0

;═══════ GOVERNOR ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=3.0
InpGov_DD_Pause=6.0
InpGov_ReducedMult=0.5
InpGov_DailyMaxDD=3.0

;═══════ MOMENTUM EXIT ═══════
InpUseMomentumExit=true
InpMomADX_Period=14
InpMomADX_Threshold=22.0
InpMomATR_CollapseRatio=0.55
InpMomBarsNoProgress=5
InpMomProgressATR=0.25
InpMomSignalsToExit=2
InpMomRecoveryMinScore=2

;═══════ VISUAL / REGIME ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=30
InpUseRollingMode=false
InpSymbolCooldown=2
InpUseH1Trigger=false
InpUseVolTarget=false
InpUseHMM=false
InpUseERFractal=false
InpUseMacroSentiment=false
InpUseDXYConflict=false
InpMaxCurrencyExposure=0.0
