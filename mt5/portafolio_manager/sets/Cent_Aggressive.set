; Cent Account Aggressive Set File (1000 USC = $10)
; Strategy: Hit & Run (Multi-Pair)
; ---------------------------------------

; Identity
InpMagicNumber=100200
InpEnableMobileAlerts=true

; Direction
InpDirection=0

; Risk (0.10 Cent Lots = 0.001 Standard Lots)
; calculated as: 1000 USC balance. 1% risk = 10 USC.
InpUseKelly=false
InpRiskBase=1.0  ; This input might be ignored if we force lots, but good to keep aligned
InpMaxRisk=5.0

; Lot Size Override (Crucial for Cent)
; If your EA uses calculated lots, we rely on the risk % above. 
; If you have a fixed lot input, ensuring it's 0.10 is key.
; The current Symbol_Engine uses risk %, so 1% of 1000 = 10 units.
; 10 units stop loss distance? 
; Let's ensure max lots allow for 0.10+
InpMaxLotsPerTrade=5.0

; Confluence
InpMinConfluenceEntry=8
InpEnableAddOns=true

; Trend
InpEMA_Period=200
InpUseTrendFilter=true

; SMC & Filters
InpUseSMC=true
InpUseNewsFilter=true
InpUseCorrelationFilter=true
InpUseReversalFilter=true

; Management
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=1.5
InpMaxTP_R=10.0
InpTrailingMode=1

; Spread (Standard Forex)
InpMaxSpreadPoints=50
