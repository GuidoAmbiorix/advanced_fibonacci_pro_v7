; XAUUSD - Gold - Ultimate Safe Haven Asset
; High volatility, strong trending, reacts to USD and risk sentiment
; Best Performance: NY session, economic uncertainty periods
; Risk Profile: Aggressive - wide swings but trending
; Target: Win Rate 58-68%, Profit Factor 2.5+
; Correlation: -0.70 with USD, +0.60 with AUD

; ====== IDENTITY ======
InpMagicNumber=100007
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; Gold most active during London and NY
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=true

; ====== FIBONACCI ======
; Wider zones due to high volatility
InpSwingLookback=18
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.35

; ====== DISPLACEMENT ======
; Strong displacements common in gold
InpUseDisplacement=true
InpDisplacementATR=1.8
InpDisplacementLookback=4

; ====== RSI ======
; Wide RSI bands for extreme moves
InpRSI_Period=14
InpRSI_Oversold=32
InpRSI_Overbought=68
InpRSI_Momentum=true

; ====== TREND ======
; Strong trends - higher slope requirement
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.18

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.85
InpATR_MA_Period=20

; ====== CONFLUENCE ======
; Higher threshold for volatile asset
InpMinConfluenceEntry=6
InpEnableAddOns=true
InpAddOn1_R=2.5
InpAddOn2_R=4.0
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
; Lower base risk due to volatility
InpRiskBase=0.35
InpRiskAddOn1=0.20
InpRiskAddOn2=0.12

; ====== EXIT ======
; Wider targets for gold's trending nature
InpTrailingMode=1
InpPartialTP_R=2.5
InpPartialClosePercent=35.0
InpBE_Threshold_R=1.8
InpTrailStart_R=3.0
InpTrailATR_Mult=1.5

; ====== SPREAD ======
; Allow wider spreads for gold
InpMaxSpreadPoints=30

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=18
InpSMC_MinImpulseATR=3.0
InpSMC_MinFVG_ATR=0.70

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Critical for gold - reacts strongly to news
InpUseNewsFilter=true
InpNewsMinutesBefore=60
InpNewsMinutesAfter=60

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.35
InpDailyMaxDD=2.0
InpWeeklyMaxDD=4.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
