; XAUUSD - Gold - Ultimate Safe Haven Asset
; High volatility, strong trending with liquidity sweeps
; Best Timeframe: H1-H4 (Day Trading), M15-M30 (Aggressive Scalping)
; Best Performance: NY session (8 AM New York + COMEX open), London steady activity
; Risk Profile: Aggressive - wide swings but trending, prone to liquidity sweeps
; Target: Win Rate 58-68%, Profit Factor 2.5+
; Correlation: -0.70 with USD, +0.60 with AUD
; Characteristics: Explosive moves around US news, clean Fair Value Gaps, institutional favorite

; ====== IDENTITY ======
InpMagicNumber=100007

; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; Gold most active during London and NY (NY preferred for institutional activity)
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=true

; ====== FIBONACCI ======
; Wider zones due to high volatility and liquidity sweeps
InpSwingLookback=18
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.35

; ====== DISPLACEMENT ======
; Strong displacements common in gold (institutional moves)
InpUseDisplacement=true
InpDisplacementATR=1.8
InpDisplacementLookback=4

; ====== RSI ======
; Wide RSI bands for extreme moves
InpRSI_Period=14
InpRSI_Oversold=32
InpRSI_Overbought=68
InpRSI_Momentum=true

; ====== TREND ======
; Strong trends - higher slope requirement
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.18

; ====== CHOP FILTER ======
; Higher threshold to avoid choppy gold sessions
InpUseChopFilter=true
InpChopThreshold=0.85
InpATR_MA_Period=20

; ====== CONFLUENCE ======
; UPDATED: Maintained strict 6.0 threshold (good for gold)
InpMinConfluenceEntry=6
InpEnableAddOns=false
InpAddOn1_R=2.5
InpAddOn2_R=4.0
InpMaxPositions=1

; ====== RISK (Before Governor Scaling) ======
; UPDATED: Very conservative for volatile gold (reduced from 0.35)
InpRiskBase=0.15
InpRiskAddOn1=0.10
InpRiskAddOn2=0.07
InpMaxRisk=0.45
InpMaxLotsPerTrade=0.5
InpEnableMarginCheck=true

; ====== TAKE PROFIT ======
; Wider TP for gold's trending nature
InpTPMode=2
InpFixedTP_R=4.0
InpMinTP_R=2.5
InpMaxTP_R=7.0
InpTPUseLearnedMFE=true

; ====== EXIT ======
; Wider targets for gold's trending nature
InpTrailingMode=1
InpPartialTP_R=2.5
InpPartialClosePercent=35.0
InpBE_Threshold_R=1.8
InpTrailStart_R=3.0
InpTrailATR_Mult=1.5

; ====== SPREAD ======
; Allow wider spreads for gold
InpMaxSpreadPoints=30

; ====== SMC - SMART MONEY CONCEPTS ======
; Critical for gold - institutional liquidity sweeps are common
InpUseSMC=true
InpSMC_SwingLookback=18
InpSMC_MinImpulseATR=3.0
InpSMC_MinFVG_ATR=0.70

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Critical for gold - reacts strongly to US economic news
InpUseNewsFilter=true
InpNewsMinutesBefore=60
InpNewsMinutesAfter=60

; ====== KELLY POSITION SIZING ======
; UPDATED: Very conservative Quarter Kelly for gold
InpUseKelly=true
InpKellyFraction=0.20
InpDailyMaxDD=1.5
InpWeeklyMaxDD=3.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

; ====== SESSION GOVERNOR ======
; UPDATED: Only 1 trade per session for volatile gold
InpUseSessionGovernor=true
InpMaxTradesPerSession=1
InpMaxProfitPerSession_R=5.0
InpMaxLossPerSession_R=1.5
InpMinSessionConfidence=0.55
InpTradeCooldownMinutes=40
InpEnableSessionBlacklist=true

; ====== PORTFOLIO PROTECTION ======
; NEW: Circuit breaker for gold (separate correlation group)
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=2.5
InpLossCooldownMinutes=60
