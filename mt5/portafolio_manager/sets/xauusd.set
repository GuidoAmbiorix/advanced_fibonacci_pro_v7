; XAUUSD - H1 Timeframe - GOAT Instant Funding Pro
; Account: $6,000 Virtual | Phase 1: 4% Target, 5% Max DD, 3% Daily DD
; Strategy: Conservative Risk (0.2%), H1 Swing Trading, Smart Trailing
; Confluence: 15 (ELITE setups), TP Cap 4R, Partial TP 1.0R/50%

InpMagicNumber=100004
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=false
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=false
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

;═══════ FIBONACCI ═══════
InpSwingLookback=35
; H1: Need more history (35 bars = ~1.5 days)
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25
; H1: Slightly more tolerant

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.5
; H1: More displacement space
InpDisplacementLookback=8

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=30
InpRSI_Overbought=70
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.10

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=16
; OPTIMIZED: 15 for H1 (2-4 signals/day)
InpDominanceThreshold=2.0
InpEnableAddOns=true
InpMaxPositions=5

;═══════ RISK (Before Governor Scaling) ═══════
InpRiskBase=7.0
; Conservative: 1.0% per trade (Gold requires more width)
InpRiskAddOn1=0.0
InpRiskAddOn2=0.0
InpMaxRisk=10.0
InpMaxLotsPerTrade=20.0
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=2
; 2=Adaptive TP (uses learned MFE)
InpFixedTP_R=3.0
InpMinTP_R=2.0
InpMaxTP_R=5.0
; H1: Can achieve 4R targets
InpTPUseLearnedMFE=true

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
; 1=Runner mode
InpTrailType=1
; 1=Chandelier Exit (ATR-based)
InpTrailStepATR=0.5

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=25.0
; Gold: Ignore low vol chop
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING (H1 OPTIMIZED) ═══════
InpPartialTP_R=1.0
; H1: Partial TP at 1.0R (~$12 profit)
InpPartialClosePercent=50.0
; Close 50% at 1R, let 50% run

InpBE_Threshold_R=0.5
; H1: Move to BE at +0.5R (~$6 profit)
InpTrailStart_R=0.5
; H1: Start trailing from 0.5R

InpTrailATR_Mult=0.4
; Gold: Wider trail step
InpTrailDecayRate=0.25
; H1: Slower decay rate
InpTrailMinMult=0.50
; Gold: Wider tight floor to survive wicks

InpTrailRegimeAware=true
; Adjust trail based on regime
InpTrailMinBufferATR=0.50
; Gold: Larger buffer from price

;═══════ SPREAD ═══════
InpMaxSpreadPoints=100

;═══════ SMC - SMART MONEY CONCEPTS ═══════
InpUseSMC=true
InpSMC_SwingLookback=25
; H1: Longer SMC lookback
InpSMC_MinImpulseATR=2.0
InpSMC_MinFVG_ATR=1.0

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=16408
; H4 higher timeframe
InpMTF=16388
; M15 lower timeframe (for precision)
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=false
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=4.0
InpVolatilitySpikeCooldown=30

;═══════ KELLY POSITION SIZING ═══════
InpUseKelly=false
InpKellyFraction=0.5
; Half-Kelly for safety
InpDailyMaxDD=3.0
; GOAT limit: 3% daily DD
InpWeeklyMaxDD=4.0
InpDailyTarget=0.0

;═══════ LEARNING & ADAPTATION ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=true

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=15.0
; Circuit breaker: 15R (~$180)
InpLossCooldownMinutes=5
InpMaxConsecutiveLosses=10
InpMaxDailyTrades=20
InpUseReversalFilter=true
InpReversalCooldownMinutes=0

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=10
InpTradeCooldownMinutes=5
InpCloseIntradayProfits=true
; H1: Don't force close at EOD
InpEndOfDayHour=22

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=60
