; XAUUSD (Gold) - H1 Timeframe - Swing Trading
; Account: Exness Cent | Strategy: H1 Swing, Adaptive TP, Smart Trailing
; NOTE: Gold is highly volatile - wider parameters to survive wicks
; Gold wicks can be brutal - wider stops + buffer essential

InpMagicNumber=100011
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
; Gold: London open creates big moves
InpEnableNYKZ=true
; Gold: NY session is the most volatile
InpEnableLondonCloseKZ=false

;═══════ FIBONACCI ═══════
InpSwingLookback=24
; Gold: Wider lookback for bigger swings
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.30
; Gold: Wider tolerance (bigger wicks)

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.5
; Gold: Needs strong displacement (lots of noise)
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
; Gold: Wider RSI bands (trends harder)
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.1

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.80
; Gold: Stricter chop filter (avoid ranging gold)
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=10
; Gold: Higher confluence required (avoid noise)
InpDominanceThreshold=2.5
InpEnableAddOns=true
InpAddOn1_R=1.5
InpAddOn2_R=2.5
InpMaxPositions=2
; Gold: Max 2 positions (very volatile)

;═══════ RISK ═══════
InpRiskBase=8.0
; Gold: Slightly lower base risk (wider stops = bigger $ risk)
InpRiskAddOn1=4.0
InpRiskAddOn2=2.0
InpMaxRisk=8.0
InpMaxLotsPerTrade=20.0
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=2
; Gold: Adaptive TP (gold trends can run far)
InpFixedTP_R=3.0
InpMinTP_R=1.5
InpMaxTP_R=6.0
; Gold: Higher max TP (trends can extend)
InpTPUseLearnedMFE=true

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.6
; Gold: Wider trail step (big wicks)

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=30.0
; Gold: Measured in cents, much higher min
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING ═══════
InpPartialTP_R=1.0
InpPartialClosePercent=40.0
; Gold: Close less at partial (let runners run)
InpBE_Threshold_R=0.7
; Gold: Later BE (survive wicks)
InpTrailStart_R=0.7
InpTrailATR_Mult=2.0
; Gold: Wider trail (massive wicks)
InpTrailDecayRate=0.20
; Gold: Slower decay
InpTrailMinMult=0.60
; Gold: Higher floor
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.40
; Gold: Wider buffer (wicks!)

;═══════ PROFIT ESCALATOR ═══════
InpStage1_R=0.4
; Gold: Later quick lock
InpStage1_SL_R=-0.1
InpStage2_R=1.0
; Gold: Later first harvest
InpStage2_Close=25.0
; Gold: Close less (let it run)
InpStage2_SL_R=0.2
InpStage3_R=2.0
; Gold: Later second harvest
InpStage3_Close=25.0
InpStage3_SL_R=1.0
InpRunnerTrailTight=0.8
InpTimeStaleMins=180.0
; Gold: 3 hours stale (moves take time)
InpTimeStaleTight1=0.8
InpTimeStaleTight2=0.6

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.05
InpRegimeHarvest=true
InpMFECalibration=true
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ SPREAD ═══════
InpMaxSpreadPoints=50
; Gold: Wider spreads normal

;═══════ SMC ═══════
InpUseSMC=true
InpSMC_SwingLookback=24
; Gold: Wider lookback
InpSMC_MinImpulseATR=2.5
; Gold: Needs strong impulse
InpSMC_MinFVG_ATR=0.6

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=45
InpNewsMinutesAfter=30
; Gold: Wider pre-news window (gold reacts early)

;═══════ VOLATILITY SPIKE ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.5
; Gold: Higher threshold (gold IS volatile)
InpVolatilitySpikeCooldown=45
; Gold: Longer cooldown after spikes

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=true

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=8.0
; Gold: Tighter daily loss limit
InpLossCooldownMinutes=45
; Gold: Longer cooldown
InpMaxConsecutiveLosses=2
; Gold: Stop after 2 consecutive losses
InpMaxDailyTrades=3
; Gold: Fewer trades per day
InpUseReversalFilter=true
InpReversalCooldownMinutes=60
; Gold: Longer reversal cooldown

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=2
; Gold: Max 2 per session
InpTradeCooldownMinutes=30
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=30
