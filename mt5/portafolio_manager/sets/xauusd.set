; XAUUSD - H4 Timeframe - Swing Trading
; Account: Standard | Strategy: H4 Swing, Adaptive TP, Smart Trailing

InpMagicNumber=100011
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

;═══════ FIBONACCI ═══════
InpSwingLookback=24
; XAUUSD: Wider lookback - gold H4 swings are longer and more complex
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.30
; XAUUSD: Wider tolerance - gold wicks are aggressive on H4

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.5
; XAUUSD: Higher displacement - gold needs strong institutional displacement
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=40
; XAUUSD: Wider RSI bands - gold trends run from deeper levels
InpRSI_Overbought=60
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.1

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.80
; XAUUSD: Stricter chop filter - gold consolidates aggressively, only trade clear trends
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=10
; XAUUSD: Higher confluence requirement - gold is harder to predict on H4
InpDominanceThreshold=2.5
InpMaxPositions=2
; XAUUSD: Fewer max positions - gold ties up significant margin

;═══════ RISK ═══════
InpRiskBase=100.0
; XAUUSD: Reduced risk per trade - gold stops are physically wider
InpMaxRisk=100.0
InpMaxLotsPerTrade=5.0
InpEnableMarginCheck=false

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=5.0
; XAUUSD: Extended fixed TP - gold H4 swings regularly reach 5R+
InpMinTP_R=2.5
InpMaxTP_R=10.0
; XAUUSD: Extended ceiling - gold can run far on H4
InpTPUseLearnedMFE=true

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.6
; XAUUSD: Wider trail step - gold ATR on H4 is large

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=30.0
; XAUUSD: High min volatility - gold pip value requires minimum range
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING ═══════
InpPartialTP_R=1.2
; XAUUSD: Slightly later partial - give gold room to breathe
InpPartialClosePercent=40.0
; XAUUSD: Close less on partial - keep more running in gold
InpBE_Threshold_R=1.0
InpTrailStart_R=1.0
InpTrailATR_Mult=1.5
InpTrailDecayRate=0.20
; XAUUSD: Slower decay - gold runner stays loose longer
InpTrailMinMult=0.50
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.35

;═══════ INFINITE ESCALATOR ═══════
InpEsc_FirstR=0.6
; XAUUSD: Quick Lock at 0.6R - secure profit before gold reverses
InpEsc_FirstSL_R=-0.1
InpEsc_StepR=0.9
; XAUUSD: Larger steps - gold H4 moves are bigger
InpEsc_GrowthFactor=1.3
InpEsc_BaseHarvest=20.0
; XAUUSD: Aggressive harvest - gold generates high dollar value per stage
InpEsc_HarvestDecay=0.80
; XAUUSD: Faster decay - runner concentrates on home run
InpEsc_MinHarvest=3.0
InpEsc_MaxStages=25
; XAUUSD: More stages - gold can trend for many H4 bars
InpRunnerTrailTight=0.80
; XAUUSD: Looser runner trail - gold needs room
InpTimeStaleMins=360.0
; XAUUSD: 360 min = 1.5 H4 bars before stale check
InpTimeStaleTight1=0.8
InpTimeStaleTight2=0.65

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=true
InpPyr_Frequency=2
; XAUUSD: More frequent scale-in - capitalize on gold momentum
InpPyr_FirstRiskPct=0.10
; XAUUSD: Smaller first add-on - gold risk is already high
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.04
InpPyr_MaxAddOns=4
; XAUUSD: More add-ons - gold trends can compound well
InpPyr_MinProfitR=1.5
; XAUUSD: Wait for stronger profit before scaling in gold
InpAgg_MaxTotalRisk=1.5
; XAUUSD: Controlled aggregate risk - gold margin is significant
InpAgg_MaxPositions=5

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.06
; XAUUSD: Stronger score adaptation
InpRegimeHarvest=true
InpMFECalibration=true
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ CONFLUENCE FLIP EXIT (legacy fallback) ═══════
InpUseConflFlipExit=false
InpConflFlipMinScore=10.0
InpConflFlipDelta=3.0
InpConflFlipOnlyAfterStage0=true

;═══════ STALE TRADE EXIT ═══════
InpUseStaleTrade=true
InpStaleBarLimit=10
; XAUUSD: More bars before stale - gold trends can pause longer

;═══════ SMART REVERSAL DETECTION ═══════
InpUseSmartReversal=true
InpUseMFERetraceExit=true
InpUseFlipAndReverse=true
InpRevW_CHoCH=0.40
InpRevW_Divergence=0.25
InpRevW_LiqSweep=0.20
InpRevW_ScoreVelocity=0.15
InpRevExitThreshold=0.55
InpRevExitMinScore=8.0
InpRevOnlyAfterStage0=true
InpRevCHoCH_MaxBars=5
InpRevRegimeGate=3
InpMFERetrace_Threshold=0.40
InpMFERetrace_MinPeakR=1.0
InpMFERetrace_AfterStage0=true
InpFlipRev_MinScore=0.75
InpFlipRev_RiskPct=0.20
InpFlipRev_CooldownBars=2
InpFlipRev_RequireMFE=true
InpFlipRev_MinPeakR=0.5

;═══════ SPREAD ═══════
InpMaxSpreadPoints=50
; XAUUSD: Wide spread tolerance - gold spot spreads can be wide

;═══════ SMC - SMART MONEY CONCEPTS ═══════
InpUseSMC=true
InpSMC_SwingLookback=24
; XAUUSD: Matches Fibonacci lookback for gold
InpSMC_MinImpulseATR=2.5
; XAUUSD: Stronger impulse required - gold needs clear institutional order flow
InpSMC_MinFVG_ATR=0.6
; XAUUSD: Larger FVG required - filter noise in gold H4

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=45
; XAUUSD: Extended pre-news window - gold reacts violently to macro news
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.5
; XAUUSD: Higher threshold - gold volatility naturally elevated
InpVolatilitySpikeCooldown=45
; XAUUSD: Longer spike cooldown - gold takes time to normalize

;═══════ KELLY POSITION SIZING ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0
InpDailyTarget=0.0

;═══════ LEARNING & ADAPTATION ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=true

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=6.0
InpLossCooldownMinutes=45
; XAUUSD: Longer cooldown after loss - gold losses can cascade
InpMaxConsecutiveLosses=2
; XAUUSD: Stop after 2 consecutive losses - gold is unforgiving
InpMaxDailyTrades=2
; XAUUSD: Fewer daily trades - gold requires high quality setups
InpUseReversalFilter=true
InpReversalCooldownMinutes=60

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=1
; XAUUSD: Only 1 trade per session - quality over quantity in gold
InpTradeCooldownMinutes=90
; XAUUSD: 90 min cooldown - wait for gold to fully develop setup
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=60
