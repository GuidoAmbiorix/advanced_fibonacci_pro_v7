; EURUSD — AGGRESSIVE ENSEMBLE SWARM
; Prop Firm: 9% target | 6% max DD | 3% daily DD
; PHILOSOPHY: High frequency, aggressive entries, managed risk.
; Risk: 0.05% per trade | Target: 2R avg + Escalator

InpMagicNumber=200001
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpKZRegimeAware=true ; *** MAINTAINED: Bypass enabled for aggressive trading ***
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpCloseOnKillzoneEnd=false
InpKZBEMinutesBefore=0
InpKZBEMinProfitR=0.0
InpNotifyKillzoneOpen=true

;═══════ MOMENTUM EXIT ═══════
InpUseMomentumExit=true
InpMomADX_Period=14
InpMomADX_Threshold=25.0
InpMomATR_CollapseRatio=0.55
InpMomBarsNoProgress=6
InpMomProgressATR=0.25
InpMomSignalsToExit=2
InpMomRecoveryMinScore=2

;═══════ FIBONACCI ═══════
InpSwingLookback=24
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.20

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.08

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.68
InpATR_MA_Period=20

;═══════ CONFLUENCE — **AGGRESSIVE SWARM TARGET: 15.0** ═══════
InpMinConfluenceEntry=15.0 ; *** LOWERED TO 15.0 ***
InpDominanceThreshold=2.0
InpMaxPositions=1

;═══════ RISK — **AGGRESSIVE 0.05 LOT** ═══════
InpRiskBase=0.05 ; *** SET TO 0.05% ***
InpMaxRisk=0.15 ; Base risk will be capped by lot size, but this adds a layer
InpMaxLotsPerTrade=0.05 ; *** SET TO 0.05 LOTS ***
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=2.0
InpMaxTP_R=5.0
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.4

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=5.0
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=2.5

;═══════ PARTIAL TP & TRAILING — CALIBRATED ═══════
InpPartialTP_R=0.60
InpPartialClosePercent=40.0
InpBE_Threshold_R=0.15
InpTrailStart_R=0.20
InpTrailATR_Mult=1.20
InpTrailDecayRate=0.30
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.12

;═══════ INFINITE ESCALATOR — **AGGRESSIVE** ═══════
InpEsc_FirstR=1.2 ; *** INCREASED STAGE 1 ***
InpEsc_FirstSL_R=-0.01
InpEsc_StepR=0.8  ; *** NEW STEP SIZE ***
InpEsc_GrowthFactor=1.50
InpEsc_BaseHarvest=50.0 ; *** INCREASED HARVEST ***
InpEsc_HarvestDecay=0.40
InpEsc_MinHarvest=10.0
InpEsc_MaxStages=5      ; *** REDUCED STAGES FOR AGGRESSIVENESS ***
InpRunnerTrailTight=0.93
InpTimeStaleMins=120.0
InpTimeStaleTight1=0.92
InpTimeStaleTight2=0.82

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=2
InpPyr_MinProfitR=1.5
InpAgg_MaxTotalRisk=0.50
InpAgg_MaxPositions=1

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.08
InpRegimeHarvest=true
InpMFECalibration=false
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=20

;═══════ STALE TRADE EXIT ═══════
InpUseStaleTrade=true
InpStaleBarLimit=6

;═══════ SPREAD ═══════
InpMaxSpreadPoints=40
InpMaxSpreadRanging=40
InpMaxSpreadVolatile=60

;═══════ SMC ═══════
InpUseSMC=true
InpSMC_SwingLookback=24
InpSMC_MinImpulseATR=1.5 ; *** ADJUSTED FOR GBP GROUP ***
InpSMC_MinFVG_ATR=0.4

;═══════ MULTI-TIMEFRAME — **H4 BIAS** ═══════
InpUseMTF=true
InpHTF=49153 ; PERIOD_H4
InpMTF=16408 ; PERIOD_H1 (This will be adjusted per group below)
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=60
InpNewsMinutesAfter=60

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=2.0
InpVolatilitySpikeCooldown=60

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=20

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=true
InpEnableAdaptiveFilters=true

;═══════ PORTFOLIO PROTECTION — TIGHT ON FUNDED ═══════
InpUseCorrelationFilter=true
InpMaxCurrencyExposure=0.03
InpDailyMaxLoss_R=2.0
InpLossCooldownMinutes=240
InpMaxConsecutiveLosses=2
InpMaxDailyTrades=3
InpUseReversalFilter=true
InpReversalCooldownMinutes=120

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=1
InpTradeCooldownMinutes=120
InpCloseIntradayProfits=false
InpEndOfDayHour=21

;═══════ GOVERNOR (per-symbol backup) — **AGGRESSIVE SAFETY CAPS** ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=1.5
InpGov_DD_Pause=3.5  ; *** Adjusted for Daily DD 3% ***
InpGov_ReducedMult=0.5
InpGov_DailyMaxDD=3.5 ; *** Adjusted for Daily DD 3% ***

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=10 ; *** Adjusted for performance ***

InpUseRollingMode=true
InpSymbolCooldown=6
