; Portfolio Governor — FUNDED ACCOUNT $6,000
; STRATEGY: Ultra-Diversification (28 pairs)
; Risk per trade: 0.10% = $6.
; Goal: High frequency of Elite signals (20.0 confluence).

;═══════ SYMBOL ENGINE MAGIC RANGE ═══════
InpMagicMin=200001
InpMagicMax=200030

;═══════ DAILY P&L CONTROL ═══════
InpDailyProfitTarget=150.0
InpDailyLossLimit=-160.0
InpPauseOnProfitTarget=true
InpCloseOnDailyLoss=true

;═══════ PORTFOLIO DRAWDOWN ═══════
InpMaxPortfolioDD_Pct=5.0
InpReduceRiskAt_Pct=2.0
InpCloseAllOnMaxDD=true

;═══════ CORRELATION FILTER ═══════
; Max 2 positions per currency — allowed for high diversification
InpUseCorrelFilter=true
InpMaxSameCurrency=2
InpCloseCorrelOnBreech=true

;═══════ FRIDAY CLOSE ═══════
; MANDATORY: always close before weekend on funded accounts
InpFridayClose=true
InpFridayCloseHour=20
InpFridayCloseMinute=0

;═══════ DISPLAY ═══════
InpShowDashboard=true
InpRefreshSeconds=5
InpDashboardCorner=0

;═══════ TIEMPO Y COOLDOWN ═══════
InpFridayBlockHours=4
InpSymbolCooldownHours=6

;═══════ LÍMITES DE OPERACIÓN ═══════
; Max 10 simultaneous positions (highly diversified)
; Max 12 trades/day
; Max 40 trades/week
InpMaxOpenPositions=10
InpMaxDailyTrades=12
InpMaxWeeklyTrades=40

;═══════ RACHA DE PÉRDIDAS ═══════
; Reduce risk 50% after 4 consecutive losses
; Pause after 8 consecutive losses (calibrated for 28 pairs)
InpConsecLossReduce=4
InpConsecLossPause=8

;═══════ EQUITY CURVE FILTER ═══════
; If equity drops below 20-bar SMA, reduce size to 50%
InpUseEqCurve=true
InpEqCurvePeriod=20
InpEqCurveReductMult=0.5
