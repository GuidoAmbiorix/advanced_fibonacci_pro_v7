; USDCAD - The Loonie - Oil-Correlated Pair
; CAD heavily influenced by oil prices
; Best Performance: NY session, oil inventory reports
; Risk Profile: Moderate - commodity correlation
; Target: Win Rate 64-72%, Profit Factor 2.0+
; Correlation: -0.85 with Oil, +0.70 with USD Index

; ====== IDENTITY ======
InpMagicNumber=100009
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; CAD most active during NY session
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=false
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
InpSwingLookback=23
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.20

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.10

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.73
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.6
InpAddOn2_R=2.7
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.48
InpRiskAddOn1=0.28
InpRiskAddOn2=0.18

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.6
InpPartialClosePercent=45.0
InpBE_Threshold_R=1.2
InpTrailStart_R=2.1
InpTrailATR_Mult=1.1

; ====== SPREAD ======
InpMaxSpreadPoints=16

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=23
InpSMC_MinImpulseATR=2.1
InpSMC_MinFVG_ATR=0.50

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Monitor CAD, USD, and oil inventory data
InpUseNewsFilter=true
InpNewsMinutesBefore=35
InpNewsMinutesAfter=30

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.48
InpDailyMaxDD=2.9
InpWeeklyMaxDD=5.8

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
