; USDCAD - H4 - AGGRESSIVE LIVE
; PHILOSOPHY: Enter only elite setups. Lock profit fast. Runner gives back nothing.
; CAD: Oil-correlated. NY session dominates — strongest moves at NY open.

InpMagicNumber=100003
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpCloseOnKillzoneEnd=false
InpKZBEMinutesBefore=0
InpKZBEMinProfitR=0.0
InpNotifyKillzoneOpen=true

;═══════ MOMENTUM EXIT ═══════
InpUseMomentumExit=true
InpMomADX_Period=14
InpMomADX_Threshold=25.0
InpMomATR_CollapseRatio=0.55
InpMomBarsNoProgress=6
InpMomProgressATR=0.25
InpMomSignalsToExit=2
InpMomRecoveryMinScore=2

;═══════ FIBONACCI ═══════
InpSwingLookback=24
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.20

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=40
InpRSI_Overbought=60
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.08

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.68
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=17
InpDominanceThreshold=1.5
InpMaxPositions=1

;═══════ RISK ═══════
InpRiskBase=1.0
InpMaxRisk=1.5
InpMaxLotsPerTrade=2.0
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=2.0
InpMaxTP_R=5.0
InpTPUseLearnedMFE=false

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.4

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=5.0
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=2.5

;═══════ PARTIAL TP & TRAILING — AGGRESSIVE ═══════
InpPartialTP_R=0.40
InpPartialClosePercent=60.0
InpBE_Threshold_R=0.20
InpTrailStart_R=0.30
InpTrailATR_Mult=0.80
InpTrailDecayRate=0.35
InpTrailMinMult=0.25
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.18

;═══════ INFINITE ESCALATOR — AGGRESSIVE ═══════
InpEsc_FirstR=0.15
InpEsc_FirstSL_R=-0.02
InpEsc_StepR=0.20
InpEsc_GrowthFactor=1.7
InpEsc_BaseHarvest=65.0
InpEsc_HarvestDecay=0.62
InpEsc_MinHarvest=20.0
InpEsc_MaxStages=15
InpRunnerTrailTight=0.93
InpTimeStaleMins=120.0
InpTimeStaleTight1=0.92
InpTimeStaleTight2=0.82

;═══════ SCALE-IN PYRAMID ═══════
InpPyr_Enable=false
InpPyr_Frequency=3
InpPyr_FirstRiskPct=0.10
InpPyr_RiskDecay=0.70
InpPyr_MinRiskPct=0.03
InpPyr_MaxAddOns=2
InpPyr_MinProfitR=1.5
InpAgg_MaxTotalRisk=1.5
InpAgg_MaxPositions=1

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.08
InpRegimeHarvest=true
InpMFECalibration=false
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ STALE TRADE EXIT ═══════
InpUseStaleTrade=true
InpStaleBarLimit=6

;═══════ SPREAD ═══════
InpMaxSpreadPoints=50
InpMaxSpreadRanging=50
InpMaxSpreadVolatile=80

;═══════ SMC ═══════
InpUseSMC=true
InpSMC_SwingLookback=24
InpSMC_MinImpulseATR=1.8
InpSMC_MinFVG_ATR=0.4

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=49153
InpMTF=16408
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=2.5
InpVolatilitySpikeCooldown=45

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false

;═══════ PORTFOLIO PROTECTION (per-symbol backup) ═══════
InpUseCorrelationFilter=false
InpDailyMaxLoss_R=3.0
InpLossCooldownMinutes=60
InpMaxConsecutiveLosses=3
InpMaxDailyTrades=5
InpUseReversalFilter=true
InpReversalCooldownMinutes=90

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=2
InpTradeCooldownMinutes=60
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ GOVERNOR (per-symbol backup) ═══════
InpGov_Enabled=true
InpGov_DD_Reduce=8.0
InpGov_DD_Pause=15.0
InpGov_ReducedMult=0.5
InpGov_DailyMaxDD=5.0

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=30

