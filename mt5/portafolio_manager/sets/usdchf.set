; USDCHF - H1 Timeframe - Swing Trading
; Account: Exness Cent | Strategy: H1 Swing, Adaptive TP, Smart Trailing
; NOTE: USDCHF inverse correlation to EURUSD - good diversification

InpMagicNumber=100005
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false

;═══════ FIBONACCI ═══════
InpSwingLookback=20
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.2
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=14
InpRSI_Oversold=45
InpRSI_Overbought=55
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.1

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=8
InpDominanceThreshold=2.0
InpEnableAddOns=true
InpAddOn1_R=1.5
InpAddOn2_R=2.5
InpMaxPositions=3

;═══════ RISK ═══════
InpRiskBase=10.0
InpRiskAddOn1=5.0
InpRiskAddOn2=3.0
InpMaxRisk=10.0
InpMaxLotsPerTrade=20.0
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=2
InpFixedTP_R=3.0
InpMinTP_R=1.5
InpMaxTP_R=5.0
InpTPUseLearnedMFE=true

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.5

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=5.0
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=3.0

;═══════ PARTIAL TP & TRAILING ═══════
InpPartialTP_R=0.5
InpPartialClosePercent=60.0
InpBE_Threshold_R=0.3
InpTrailStart_R=0.3
InpTrailATR_Mult=1.5
InpTrailDecayRate=0.40
InpTrailMinMult=0.50
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.30

;═══════ PROFIT ESCALATOR ═══════
InpStage1_R=0.2
InpStage1_SL_R=0.0
InpStage2_R=0.5
InpStage2_Close=40.0
InpStage2_SL_R=0.1
InpStage3_R=1.0
InpStage3_Close=35.0
InpStage3_SL_R=0.5
InpRunnerTrailTight=0.6
InpTimeStaleMins=60.0
InpTimeStaleTight1=0.7
InpTimeStaleTight2=0.5

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.05
InpRegimeHarvest=true
InpMFECalibration=true
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ SPREAD ═══════
InpMaxSpreadPoints=30

;═══════ SMC ═══════
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=2.0
InpSMC_MinFVG_ATR=0.5

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=3.0
InpVolatilitySpikeCooldown=30

;═══════ KELLY ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0
InpDailyTarget=0.0

;═══════ LEARNING ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=true

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=10.0
InpLossCooldownMinutes=30
InpMaxConsecutiveLosses=3
InpMaxDailyTrades=5
InpUseReversalFilter=true
InpReversalCooldownMinutes=30

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=3
InpTradeCooldownMinutes=15
InpCloseIntradayProfits=false
InpEndOfDayHour=22

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=30
