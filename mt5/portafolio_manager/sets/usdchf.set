; USDCHF - The Swissie - Safe Haven Pair
; Inverse correlation with EURUSD
; Best Performance: European and NY sessions
; Risk Profile: Conservative - low volatility
; Target: Win Rate 66-76%, Profit Factor 2.0+
; Correlation: -0.95 with EURUSD, +0.85 with USD Index

; ====== IDENTITY ======
InpMagicNumber=100005
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; CHF active during European hours
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
; Tight zones for low volatility pair
InpSwingLookback=24
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.16

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.1
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=42
InpRSI_Overbought=58
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.09

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.70
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.4
InpAddOn2_R=2.5
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.60
InpRiskAddOn1=0.35
InpRiskAddOn2=0.25

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.5
InpPartialClosePercent=50.0
InpBE_Threshold_R=1.1
InpTrailStart_R=2.0
InpTrailATR_Mult=1.0

; ====== SPREAD ======
InpMaxSpreadPoints=15

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=24
InpSMC_MinImpulseATR=1.8
InpSMC_MinFVG_ATR=0.45

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=30
InpNewsMinutesAfter=30

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=6.0

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
