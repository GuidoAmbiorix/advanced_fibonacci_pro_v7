; XAUUSD - M5 Timeframe - Scalper Mode
; Account: $6,000 Virtual | Phase 1: 4% Target, 5% Max DD, 3% Daily DD
; Strategy: M5 Gold Scalping, Fast TP, Wider Stops (Gold Wicks)
; NOTE: Gold is highly volatile - wider parameters to survive wicks

InpMagicNumber=100011
InpDirection=0
InpBrokerUTCOffset=2

;═══════ KILLZONES ═══════
InpUseKillzoneFilter=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
; Gold: Best in NY session
InpEnableLondonCloseKZ=false

;═══════ FIBONACCI ═══════
InpSwingLookback=15
; M5 Gold: Slightly more lookback (gold is wild)
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.25
; Gold: Keep wider tolerance (bigger wicks)

;═══════ DISPLACEMENT ═══════
InpUseDisplacement=true
InpDisplacementATR=1.0
; Gold: Slightly higher than FX (gold moves bigger)
InpDisplacementLookback=5

;═══════ RSI ═══════
InpRSI_Period=7
InpRSI_Oversold=35
InpRSI_Overbought=65
InpRSI_Momentum=true

;═══════ TREND ═══════
InpEMA_Period=50
InpUseTrendFilter=true
InpEMA_MinSlope=0.05

;═══════ CHOP FILTER ═══════
InpUseChopFilter=true
InpChopThreshold=0.65
InpATR_MA_Period=20

;═══════ CONFLUENCE ═══════
InpMinConfluenceEntry=6
InpDominanceThreshold=1.5
InpEnableAddOns=false
InpMaxPositions=3

;═══════ RISK (Before Governor Scaling) ═══════
InpRiskBase=7.0
; Gold: Higher base risk (wider SL needs more room)
InpRiskAddOn1=0.0
InpRiskAddOn2=0.0
InpMaxRisk=10.0
InpMaxLotsPerTrade=20.0
InpEnableMarginCheck=true

;═══════ TAKE PROFIT ═══════
InpTPMode=1
InpFixedTP_R=1.5
InpMinTP_R=0.8
InpMaxTP_R=2.5
; Gold: Slightly higher max (gold can run)
InpTPUseLearnedMFE=true

;═══════ TRAILING STOP ═══════
InpTrailingMode=1
InpTrailType=1
InpTrailStepATR=0.4
; Gold: Slightly wider step (survives wicks)

;═══════ VOLATILITY FILTER ═══════
InpMinVolatilityPips=10.0
; Gold M5: Ignore dead markets
InpMaxVolatilityFactor=3.0
InpVolatilityTP_Mult=1.5

;═══════ PARTIAL TP & TRAILING (M5 GOLD SCALP) ═══════
InpPartialTP_R=0.5
InpPartialClosePercent=60.0
InpBE_Threshold_R=0.3
InpTrailStart_R=0.3
InpTrailATR_Mult=0.6
; Gold: Slightly wider trail
InpTrailDecayRate=0.35
InpTrailMinMult=0.35
; Gold: Wider floor to survive wicks
InpTrailRegimeAware=true
InpTrailMinBufferATR=0.25
; Gold: Bigger buffer from price

;═══════ PROFIT ESCALATOR (M5 Gold Compressed) ═══════
InpStage1_R=0.2
InpStage1_SL_R=0.0
InpStage2_R=0.5
InpStage2_Close=50.0
InpStage2_SL_R=0.2
InpStage3_R=1.0
InpStage3_Close=30.0
InpStage3_SL_R=0.5
InpRunnerTrailTight=0.7
; Gold: Slightly wider runner
InpTimeStaleMins=10.0
InpTimeStaleTight1=0.7
InpTimeStaleTight2=0.5

;═══════ ADAPTIVE ESCALATOR ═══════
InpAdaptiveEscalator=true
InpScoreAdaptFactor=0.05
InpRegimeHarvest=true
InpMFECalibration=true
InpMomentumTrail=true
InpChaosEmergencyLock=true
InpFridayCloseHour=22

;═══════ SPREAD ═══════
InpMaxSpreadPoints=50
; Gold: Wider spread acceptable (gold spreads are larger)

;═══════ SMC - SMART MONEY CONCEPTS ═══════
InpUseSMC=true
InpSMC_SwingLookback=15
InpSMC_MinImpulseATR=1.2
; Gold: Slightly higher impulse threshold
InpSMC_MinFVG_ATR=0.5
; Gold: Keep wider FVG (gold gaps are bigger)

;═══════ MULTI-TIMEFRAME ═══════
InpUseMTF=true
InpHTF=16385
; H1 higher timeframe
InpMTF=15
; M15 medium timeframe
InpMTF_EMAPeriod=50

;═══════ NEWS FILTER ═══════
InpUseNewsFilter=true
InpNewsMinutesBefore=15
InpNewsMinutesAfter=15

;═══════ VOLATILITY SPIKE PROTECTION ═══════
InpEnableVolatilityFilter=true
InpVolatilityThreshold=4.0
; Gold: Higher spike threshold (gold is naturally volatile)
InpVolatilitySpikeCooldown=15
; Gold: Longer cooldown after spikes

;═══════ KELLY POSITION SIZING ═══════
InpUseKelly=false
InpKellyFraction=0.5
InpDailyMaxDD=3.0
InpWeeklyMaxDD=4.0
InpDailyTarget=0.0

;═══════ LEARNING & ADAPTATION ═══════
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

;═══════ ADAPTIVE BEHAVIOR ═══════
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=true

;═══════ PORTFOLIO PROTECTION ═══════
InpUseCorrelationFilter=true
InpDailyMaxLoss_R=10.0
InpLossCooldownMinutes=5
; Gold: Slightly longer cooldown (bigger swings)
InpMaxConsecutiveLosses=3
InpMaxDailyTrades=15
; Gold: Fewer daily trades (each is higher impact)
InpUseReversalFilter=true
InpReversalCooldownMinutes=5
; Gold: Longer same-direction cooldown

;═══════ SESSION GOVERNOR ═══════
InpUseSessionGovernor=true
InpMaxTradesPerSession=8
; Gold: Fewer per session
InpTradeCooldownMinutes=5
InpCloseIntradayProfits=true
InpEndOfDayHour=22

;═══════ VISUAL DEBUGGING ═══════
InpEnableVisualLevels=true
InpTickThrottleSeconds=5
