; XAGUSD - Silver - Industrial Metal with Safe Haven Properties
; More volatile than gold, industrial demand
; Best Performance: London-NY overlap
; Risk Profile: High - extreme volatility
; Target: Win Rate 56-66%, Profit Factor 2.4+
; Correlation: +0.80 with XAUUSD, industrial cycles

; ====== IDENTITY ======
InpMagicNumber=100020
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; London and NY sessions
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=true
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=true

; ====== FIBONACCI ======
; Very wide zones for extreme volatility
InpSwingLookback=17
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.42

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=2.0
InpDisplacementLookback=4

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=30
InpRSI_Overbought=70
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.22

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.88
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=6
InpEnableAddOns=true
InpAddOn1_R=3.0
InpAddOn2_R=4.5
InpMaxPositions=2

; ====== RISK (Before Governor Scaling) ======
; Very low risk due to extreme volatility
InpRiskBase=0.28
InpRiskAddOn1=0.16
InpRiskAddOn2=0.10

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=2.8
InpPartialClosePercent=33.0
InpBE_Threshold_R=2.0
InpTrailStart_R=3.3
InpTrailATR_Mult=1.7

; ====== SPREAD ======
InpMaxSpreadPoints=45

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=17
InpSMC_MinImpulseATR=3.5
InpSMC_MinFVG_ATR=0.80

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=65
InpNewsMinutesAfter=60

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.30
InpDailyMaxDD=1.8
InpWeeklyMaxDD=3.5

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
