; EURJPY - Euro Yen Cross - Major Risk Barometer
; Classic risk-on/risk-off indicator
; Best Performance: European and Asian sessions
; Risk Profile: Moderate-High - volatile trends
; Target: Win Rate 62-72%, Profit Factor 2.1+
; Correlation: +0.70 with risk sentiment, follows equities

; ====== IDENTITY ======
InpMagicNumber=100010
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; Active in both European and Asian sessions
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=true
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
InpSwingLookback=22
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.28

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.5
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=35
InpRSI_Overbought=65
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.14

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.76
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.9
InpAddOn2_R=3.2
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.43
InpRiskAddOn1=0.26
InpRiskAddOn2=0.17

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.9
InpPartialClosePercent=43.0
InpBE_Threshold_R=1.4
InpTrailStart_R=2.4
InpTrailATR_Mult=1.25

; ====== SPREAD ======
InpMaxSpreadPoints=22

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=22
InpSMC_MinImpulseATR=2.4
InpSMC_MinFVG_ATR=0.57

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=40
InpNewsMinutesAfter=35

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.43
InpDailyMaxDD=2.7
InpWeeklyMaxDD=5.3

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
