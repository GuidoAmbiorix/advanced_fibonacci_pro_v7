; NZDJPY - New Zealand Yen Cross
; High beta risk sentiment play
; Best Performance: Asian session, dairy data
; Risk Profile: Moderate-High - volatile
; Target: Win Rate 60-68%, Profit Factor 2.0+
; Correlation: Risk assets, commodity cycles

; ====== IDENTITY ======
InpMagicNumber=100019
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; Asian session primary
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=true
InpEnableLondonOpenKZ=false
InpEnableNYKZ=false
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=false

; ====== FIBONACCI ======
InpSwingLookback=21
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.26

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.4
InpDisplacementLookback=5

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=37
InpRSI_Overbought=63
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.12

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.75
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=5
InpEnableAddOns=true
InpAddOn1_R=1.8
InpAddOn2_R=3.0
InpMaxPositions=3

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.43
InpRiskAddOn1=0.25
InpRiskAddOn2=0.16

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=1.8
InpPartialClosePercent=41.0
InpBE_Threshold_R=1.4
InpTrailStart_R=2.3
InpTrailATR_Mult=1.2

; ====== SPREAD ======
InpMaxSpreadPoints=26

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=21
InpSMC_MinImpulseATR=2.2
InpSMC_MinFVG_ATR=0.54

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
InpUseNewsFilter=true
InpNewsMinutesBefore=40
InpNewsMinutesAfter=35

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.43
InpDailyMaxDD=2.7
InpWeeklyMaxDD=5.3

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
