; US30 - Dow Jones Industrial Average Index
; Blue chip stocks index, economic health indicator
; Best Performance: NY session, economic reports
; Risk Profile: Moderate-High - index volatility
; Target: Win Rate 60-68%, Profit Factor 2.2+
; Correlation: US economic strength, Fed policy

; ====== IDENTITY ======
InpMagicNumber=100021
; ====== DIRECTION ======
InpDirection=0
InpBrokerUTCOffset=2

; ====== KILLZONES ======
; NY session primary for US indices
InpUseKillzoneFilter=true
InpUseSymbolDefaults=true
InpAutoDST=true
InpEnableAsianKZ=false
InpEnableLondonOpenKZ=false
InpEnableNYKZ=true
InpEnableLondonCloseKZ=false
InpFocusPrimeOnly=true

; ====== FIBONACCI ======
InpSwingLookback=20
InpFibLevelLow=0.618
InpFibLevelHigh=0.786
InpZoneTolerance=0.32

; ====== DISPLACEMENT ======
InpUseDisplacement=true
InpDisplacementATR=1.6
InpDisplacementLookback=4

; ====== RSI ======
InpRSI_Period=14
InpRSI_Oversold=35
InpRSI_Overbought=65
InpRSI_Momentum=true

; ====== TREND ======
InpEMA_Period=200
InpUseTrendFilter=true
InpEMA_MinSlope=0.15

; ====== CHOP FILTER ======
InpUseChopFilter=true
InpChopThreshold=0.78
InpATR_MA_Period=20

; ====== CONFLUENCE ======
InpMinConfluenceEntry=6
InpEnableAddOns=true
InpAddOn1_R=2.2
InpAddOn2_R=3.7
InpMaxPositions=2

; ====== RISK (Before Governor Scaling) ======
InpRiskBase=0.38
InpRiskAddOn1=0.22
InpRiskAddOn2=0.14

; ====== EXIT ======
InpTrailingMode=1
InpPartialTP_R=2.1
InpPartialClosePercent=40.0
InpBE_Threshold_R=1.6
InpTrailStart_R=2.6
InpTrailATR_Mult=1.35

; ====== SPREAD ======
InpMaxSpreadPoints=35

; ====== SMC - SMART MONEY CONCEPTS ======
InpUseSMC=true
InpSMC_SwingLookback=20
InpSMC_MinImpulseATR=2.7
InpSMC_MinFVG_ATR=0.65

; ====== MULTI-TIMEFRAME ======
InpUseMTF=true
InpHTF=16388
InpMTF=16385
InpMTF_EMAPeriod=50

; ====== NEWS FILTER ======
; Critical for US indices
InpUseNewsFilter=true
InpNewsMinutesBefore=55
InpNewsMinutesAfter=50

; ====== KELLY POSITION SIZING ======
InpUseKelly=true
InpKellyFraction=0.38
InpDailyMaxDD=2.3
InpWeeklyMaxDD=4.5

; ====== LEARNING & ADAPTATION ======
InpEnableLearning=true
InpLogTradesToFile=true
InpLearningHistory=180
InpMinTradesForLearning=50

; ====== ADAPTIVE BEHAVIOR (Advanced) ======
InpEnableAdaptiveRisk=false
InpEnableAdaptiveExits=false
InpEnableAdaptiveFilters=false
