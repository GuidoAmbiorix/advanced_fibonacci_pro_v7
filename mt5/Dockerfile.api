FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY mt5_api_requirements.txt .
RUN pip install --no-cache-dir -r mt5_api_requirements.txt

# Copy API server
COPY mt5_api_server.py .

# Expose API port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8001/health')"

# Run API server
CMD ["python", "mt5_api_server.py"]
