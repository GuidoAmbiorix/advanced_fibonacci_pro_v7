; EURUSD - Optimized Settings for Prueba.mq5
; Strategy: KAMA + Bollinger Bands Range Breakout
; Best Timeframe: H1 (recommended for this strategy)
; Best Performance: London-NY session (high liquidity, clean breakouts)
; Risk Profile: Moderate with adaptive trailing
; Target: Win Rate 60-70%, Profit Factor 1.8+
; EURUSD Characteristics: Low spread, high liquidity, moderate volatility

; ====== ORDER EXECUTION ======
preferredFillingType=ORDER_FILLING_FOK
forceFillingType=false

; ====== IDENTITY ======
CustomComment=Prueba_EURUSD_H1
MagicNumber=11111

; ====== KAMA PARAMETERS ======
; KAMA adapts to market conditions - optimized for EURUSD's rhythm
KAMAERPeriod1=35
KAMAShortPeriod1=36
KAMALongPeriod1=192
PriceEntryMult1=0.1

; ====== PROFIT/LOSS TARGETS ======
; Conservative targets for EURUSD - reliable pair
ProfitTargetCoef1=2.8
StopLoss1=9

; ====== TRAILING STOP ======
; Adaptive trailing for EURUSD's gradual trends
TrailingStopCoef1=4.7
TrailingActCef1=2.8

; ====== BOLLINGER BANDS ======
Period1=5
BBRangePeriod1=68

; ====== MONEY MANAGEMENT ======
; Fixed % risk - conservative for consistent growth
UseMoneyManagement=true
mmRiskPercent=2.0
mmDecimals=2
mmStopLossPips=100
mmLotsIfNoMM=0.01
mmMaxLots=5.0
mmMultiplier=1.0
mmStep=0.0
InitialCapital=10000

; ====== WEEKEND TRADING ======
; Avoid weekend gaps on EURUSD
DontTradeOnWeekends=true
FridayCloseTime=20:00
SundayOpenTime=22:00

; ====== EXIT AT END OF DAY ======
ExitAtEndOfDay=false
EODExitTime=23:00

; ====== EXIT ON FRIDAY ======
; Close positions before weekend
ExitOnFriday=true
FridayExitTime=20:00

; ====== TIME RANGE FILTER ======
; Trade during liquid EURUSD sessions (London open to NY close)
LimitTimeRange=true
SignalTimeRangeFrom=07:00
SignalTimeRangeTo=21:00
ExitAtEndOfRange=false
OrderTypeToExit=0

; ====== MAX DISTANCE FROM MARKET ======
; Prevent entries too far from current price
LimitMaxDistanceFromMarketPrice=true
MaxDistanceFromMarketPct=3.0

; ====== MAX TRADES PER DAY ======
; Conservative approach - quality over quantity
MaxTradesPerDay=3

; ====== SL/PT LIMITS ======
; Ensure reasonable risk/reward
MinimumSL=15
MinimumPT=20
MaximumSL=150
MaximumPT=500

; ====== TICK SIZE (For CFDs) ======
UseSQTickSize=false
MainChartTickSizeSQ=0.0001

; ====== SESSION HOURS ======
; Respect broker's trading sessions
tradeInSessionHoursOnly=true
MAX_ORDER_RETRIES=20

; ====== BAR TIMING ======
OpenBarDelay=0

; ====== ORDER EXPIRATION ======
ExpirationTime=0
ModifyInsteadOfReplacing=false
