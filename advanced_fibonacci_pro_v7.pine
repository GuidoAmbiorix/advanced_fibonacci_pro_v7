indicator("🔥 Fibonacci Trading System PRO v7.0 [Premium]", 
         shorttitle="📊 FiboPRO™ v7",
         overlay=true, 
         max_labels_count=500,
         max_lines_count=500,
         max_boxes_count=100,
         max_bars_back=5000)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 📌 CONSTANTS & PROFESSIONAL THEMES
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Professional Color Schemes
type ColorTheme
    color primary
    color secondary
    color success
    color danger
    color warning
    color info
    color golden
    color background

// Define Professional Themes as a function
getTheme(string themeName) =>
    switch themeName
        "Dark Professional" => ColorTheme.new(color.rgb(41, 98, 255, 30), color.rgb(136, 132, 216, 40), color.rgb(0, 230, 118, 30), color.rgb(255, 82, 82, 30), color.rgb(255, 193, 7, 30), color.rgb(0, 188, 212, 30), color.rgb(255, 215, 0, 20), color.rgb(18, 18, 18, 95))
        "Light Professional" => ColorTheme.new(color.rgb(25, 118, 210, 40), color.rgb(103, 58, 183, 40), color.rgb(56, 142, 60, 40), color.rgb(211, 47, 47, 40), color.rgb(245, 124, 0, 40), color.rgb(0, 172, 193, 40), color.rgb(255, 193, 7, 30), color.rgb(250, 250, 250, 95))
        => ColorTheme.new(color.rgb(33, 150, 243, 30), color.rgb(142, 36, 170, 40), color.rgb(76, 175, 80, 30), color.rgb(244, 67, 54, 30), color.rgb(255, 152, 0, 30), color.rgb(3, 169, 244, 30), color.rgb(255, 183, 77, 25), color.rgb(23, 23, 25, 95))

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 🎛️ ADVANCED INPUT SETTINGS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Professional Mode
group_pro = "⚡ PROFESSIONAL MODE"
proMode = input.bool(true, "🎯 Enable Professional Features", group=group_pro, tooltip="Unlock all premium features")
mtfEnabled = input.bool(true, "📊 Multi-Timeframe Analysis", group=group_pro)
aiSignals = input.bool(true, "🤖 AI-Enhanced Signals", group=group_pro)
smartMoney = input.bool(true, "💰 Smart Money Tracking", group=group_pro)
volumeProfile = input.bool(true, "📈 Volume Profile Analysis", group=group_pro)

// Theme Selection
group_theme = "🎨 VISUAL CUSTOMIZATION"
themeSelect = input.string("Dark Professional", "Color Theme", options=["Dark Professional", "Light Professional", "TradingView Blue"],group=group_theme)
theme = getTheme(themeSelect)
showAnimations = input.bool(true, "✨ Enable Animations", group=group_theme)
compactMode = input.bool(false, "📱 Compact Mode (Mobile)", group=group_theme)

// Fibonacci Configuration
group_fib = "📐 FIBONACCI CONFIGURATION"
fibMethod = input.string("Auto-Adaptive", "Detection Method",options=["Auto-Adaptive", "Manual Selection", "AI Detection", "Volume-Weighted"],  group=group_fib,tooltip="Auto-Adaptive uses machine learning patterns")
    
lookbackPeriod = input.int(89, "Lookback Period",  minval=21, maxval=233, step=1, group=group_fib, tooltip="Fibonacci number recommended: 21, 34, 55, 89, 144, 233")
    
swingStrength = input.int(5, "Swing Detection Sensitivity", minval=2, maxval=21, group=group_fib,tooltip="Lower = More sensitive")

// Fibonacci Levels Selection
group_levels = "📏 FIBONACCI LEVELS"
// Core Retracements
showRetracements = input.bool(true, "Show Retracement Levels", group=group_levels)
ret_0236 = input.bool(true, "0.236 - Shallow Retracement", inline="r1", group=group_levels)
ret_0382 = input.bool(true, "0.382 - Key Support", inline="r2", group=group_levels)
ret_0500 = input.bool(true, "0.500 - Psychological", inline="r3", group=group_levels)
ret_0618 = input.bool(true, "0.618 - Golden Ratio ⭐", inline="r4", group=group_levels)
ret_0786 = input.bool(true, "0.786 - Deep Retracement", inline="r5", group=group_levels)

// Extensions
showExtensions = input.bool(true, "Show Extension Levels", group=group_levels)
ext_1272 = input.bool(true, "1.272 - Initial Target", inline="e1", group=group_levels)
ext_1618 = input.bool(true, "1.618 - Golden Extension ⭐", inline="e2", group=group_levels)
ext_2618 = input.bool(true, "2.618 - Extended Target", inline="e3", group=group_levels)
ext_4236 = input.bool(false, "4.236 - Extreme Extension", inline="e4", group=group_levels)

// Golden Zone Settings
showGoldenZone = input.bool(true, "🌟 Highlight Golden Zone (0.618-0.65)", group=group_levels)
showKillZone = input.bool(true, "💀 Show Kill Zone (0.886)", group=group_levels)

// Technical Indicators Integration
group_tech = "📊 TECHNICAL INDICATORS"
// RSI Settings
useRSI = input.bool(true, "RSI Integration", inline="rsi1", group=group_tech)
rsiLength = input.int(14, "", inline="rsi1", group=group_tech)
rsiOverbought = input.int(70, "OB", inline="rsi2", group=group_tech)
rsiOversold = input.int(30, "OS", inline="rsi2", group=group_tech)

// MACD Settings  
useMacd = input.bool(true, "MACD Integration", inline="macd1", group=group_tech)
macdFast = input.int(12, "", inline="macd1", group=group_tech)
macdSlow = input.int(26, "", inline="macd2", group=group_tech)
macdSignal = input.int(9, "Signal", inline="macd2", group=group_tech)

// Stochastic Settings
useStoch = input.bool(true, "Stochastic Integration", inline="stoch", group=group_tech)
stochLength = input.int(14, "", inline="stoch", group=group_tech)

// Volume Analysis
group_vol = "📊 VOLUME ANALYSIS"
useVolume = input.bool(true, "Volume Confirmation Required", group=group_vol)
volMaType = input.string("VWMA", "Volume MA Type", ["SMA", "EMA", "VWMA", "HMA"], group=group_vol)
volMaLength = input.int(20, "Volume MA Length", minval=5, maxval=100, group=group_vol)
volThreshold = input.float(1.5, "Volume Spike Multiplier", minval=1.0, maxval=5.0, step=0.1, group=group_vol)
showVolumeProfile = input.bool(true, "Show Volume Profile", group=group_vol)

// Signal Configuration
group_signals = "🎯 SIGNAL CONFIGURATION"
signalMode = input.string("Conservative", "Signal Mode", options=["Aggressive", "Moderate", "Conservative", "Custom"],group=group_signals,tooltip="Conservative = Higher accuracy, fewer signals")
    
enableLongs = input.bool(true, "✅ Enable Long Signals", group=group_signals)
enableShorts = input.bool(true, "❌ Enable Short Signals", group=group_signals)

confluenceFactors = signalMode == "Aggressive" ? 2 :  signalMode == "Moderate" ? 3 : signalMode == "Conservative" ? 4 : input.int(3, "Custom Confluence Required", minval=1, maxval=7, group=group_signals)

// Risk Management Suite
group_risk = "⚠️ RISK MANAGEMENT SUITE"
riskMode = input.string("Dynamic ATR", "Stop Loss Method", options=["Fixed %", "Dynamic ATR", "Swing Points", "Fibonacci Based", "Trailing"],group=group_risk)

// ATR Settings for Stops
atrLength = input.int(14, "ATR Length", minval=5, maxval=50, group=group_risk)
atrMultiplier = input.float(1.5, "ATR Multiplier", minval=0.5, maxval=5.0, step=0.25, group=group_risk)

// Risk Reward Settings
rrRatio = input.float(2.0, "Risk:Reward Ratio", minval=1.0, maxval=10.0, step=0.5, group=group_risk)
maxRiskPercent = input.float(2.0, "Max Risk % per Trade", minval=0.5, maxval=5.0, step=0.5, group=group_risk)
accountSize = input.float(10000, "Account Size", minval=100, group=group_risk)

// Advanced Features
group_advanced = "🚀 ADVANCED FEATURES"
showDashboard = input.bool(true, "📊 Analytics Dashboard", group=group_advanced)
showPerformance = input.bool(true, "📈 Performance Metrics", group=group_advanced)
showMarketStructure = input.bool(true, "🏗️ Market Structure", group=group_advanced)
showPivotPoints = input.bool(false, "🎯 Pivot Points", group=group_advanced)
showSessionHighLow = input.bool(false, "🕐 Session High/Low", group=group_advanced)

// Alert Settings
group_alerts = "🔔 ALERT CONFIGURATION"
alertsEnabled = input.bool(true, "Enable Alerts", group=group_alerts)
alertOnFibTouch = input.bool(true, "Alert on Fibonacci Touch", group=group_alerts)
alertOnSignal = input.bool(true, "Alert on Trade Signal", group=group_alerts)
alertOnGoldenZone = input.bool(true, "Alert on Golden Zone Entry", group=group_alerts)
customAlertMessage = input.text_area("", "Custom Alert Template", group=group_alerts,tooltip="Use {ticker}, {price}, {fib_level}, {signal}")

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 📈 ADVANCED FIBONACCI CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Enhanced Swing Detection with Multiple Methods
type SwingPoint
    float price
    int barIndex
    bool isHigh
    float strength

// Initialize Variables
var array<SwingPoint> swingPoints = array.new<SwingPoint>()
var float currentSwingHigh = na
var float currentSwingLow = na
var int swingHighBar = na
var int swingLowBar = na

// Advanced Pivot Detection
pivotHigh = ta.pivothigh(high, swingStrength, swingStrength)
pivotLow = ta.pivotlow(low, swingStrength, swingStrength)

// Volume-Weighted Pivot Detection (Premium Feature)
vwapValue = ta.vwap(hlc3)
volumeMA = switch volMaType
    "SMA" => ta.sma(volume, volMaLength)
    "EMA" => ta.ema(volume, volMaLength)
    "VWMA" => ta.vwma(close, volMaLength)
    "HMA" => ta.hma(volume, volMaLength)
    => ta.sma(volume, volMaLength)

isVolumeSignificant = volume > volumeMA * volThreshold

// Update Swing Points with Volume Confirmation
if not na(pivotHigh) and (not useVolume or isVolumeSignificant[swingStrength])
    currentSwingHigh := pivotHigh
    swingHighBar := bar_index - swingStrength
    point = SwingPoint.new(pivotHigh, bar_index - swingStrength, true, volume[swingStrength])
    array.push(swingPoints, point)
    if array.size(swingPoints) > 50
        array.shift(swingPoints)

if not na(pivotLow) and (not useVolume or isVolumeSignificant[swingStrength])
    currentSwingLow := pivotLow
    swingLowBar := bar_index - swingStrength
    point = SwingPoint.new(pivotLow, bar_index - swingStrength, false, volume[swingStrength])
    array.push(swingPoints, point)
    if array.size(swingPoints) > 50
        array.shift(swingPoints)

// Ensure we have valid swing points
if na(currentSwingHigh)
    currentSwingHigh := ta.highest(high, lookbackPeriod)
    swingHighBar := bar_index - ta.highestbars(high, lookbackPeriod)
    
if na(currentSwingLow)
    currentSwingLow := ta.lowest(low, lookbackPeriod)
    swingLowBar := bar_index - ta.lowestbars(low, lookbackPeriod)

// Determine Market Trend
isBullish = swingLowBar > swingHighBar
trendStrength = math.abs(currentSwingHigh - currentSwingLow) / currentSwingLow * 100

// Calculate All Fibonacci Levels
fibRange = currentSwingHigh - currentSwingLow
fib0 = isBullish ? currentSwingLow : currentSwingHigh
fib100 = isBullish ? currentSwingHigh : currentSwingLow

// Retracement Levels
fib236 = isBullish ? currentSwingLow + fibRange * 0.236 : currentSwingHigh - fibRange * 0.236
fib382 = isBullish ? currentSwingLow + fibRange * 0.382 : currentSwingHigh - fibRange * 0.382
fib500 = isBullish ? currentSwingLow + fibRange * 0.500 : currentSwingHigh - fibRange * 0.500
fib618 = isBullish ? currentSwingLow + fibRange * 0.618 : currentSwingHigh - fibRange * 0.618
fib650 = isBullish ? currentSwingLow + fibRange * 0.650 : currentSwingHigh - fibRange * 0.650
fib786 = isBullish ? currentSwingLow + fibRange * 0.786 : currentSwingHigh - fibRange * 0.786
fib886 = isBullish ? currentSwingLow + fibRange * 0.886 : currentSwingHigh - fibRange * 0.886

// Extension Levels
fib1272 = isBullish ? currentSwingHigh + fibRange * 0.272 : currentSwingLow - fibRange * 0.272
fib1618 = isBullish ? currentSwingHigh + fibRange * 0.618 : currentSwingLow - fibRange * 0.618
fib2618 = isBullish ? currentSwingHigh + fibRange * 1.618 : currentSwingLow - fibRange * 1.618
fib4236 = isBullish ? currentSwingHigh + fibRange * 3.236 : currentSwingLow - fibRange * 3.236

// Golden Zone Calculation
goldenZoneTop = math.max(fib618, fib650)
goldenZoneBottom = math.min(fib618, fib650)
inGoldenZone = close >= goldenZoneBottom and close <= goldenZoneTop

// Kill Zone (0.886 level - high probability reversal zone)
inKillZone = math.abs(close - fib886) < ta.atr(14) * 0.5

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 📊 TECHNICAL INDICATORS CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// RSI with Multiple Timeframe Analysis
rsi = ta.rsi(close, rsiLength)
rsiMA = ta.sma(rsi, 14)
rsiBullish = rsi > 50 and rsi > rsiMA and rsi < rsiOverbought
rsiBearish = rsi < 50 and rsi < rsiMA and rsi > rsiOversold

// RSI Divergence Detection
rsiDivergenceBull = close < close[1] and close[1] < close[2] and  rsi > rsi[1] and rsi[1] > rsi[2] and rsi < rsiOversold + 10

rsiDivergenceBear = close > close[1] and close[1] > close[2] and rsi < rsi[1] and rsi[1] < rsi[2] and rsi > rsiOverbought - 10

// MACD with Histogram Analysis
[macdLine, signalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBullish = macdLine > signalLine and macdHist > macdHist[1] and macdHist > 0
macdBearish = macdLine < signalLine and macdHist < macdHist[1] and macdHist < 0
macdCrossUp = ta.crossover(macdLine, signalLine)
macdCrossDown = ta.crossunder(macdLine, signalLine)

// Stochastic
k = ta.stoch(close, high, low, stochLength)
d = ta.sma(k, 3)
stochBullish = k > 20 and k > d and k < 80
stochBearish = k < 80 and k < d and k > 20

// ATR and Volatility
atr = ta.atr(atrLength)
atrPercent = (atr / close) * 100
volatilityMA = ta.sma(atrPercent, 20)
isHighVolatility = atrPercent > volatilityMA * 1.5
isLowVolatility = atrPercent < volatilityMA * 0.5

// Volume Analysis
volumeSpike = volume > volumeMA * volThreshold
bullishVolume = close > open and volumeSpike
bearishVolume = close < open and volumeSpike

// Cumulative Volume Delta (CVD)
cvd = ta.cum(volume * (close > open ? 1 : -1))
cvdMA = ta.sma(cvd, 20)
cvdBullish = cvd > cvdMA
cvdBearish = cvd < cvdMA

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 🎯 MULTI-TIMEFRAME ANALYSIS (Premium Feature)
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Get Higher Timeframe Data
htf1 = timeframe.period == "1" ? "5" : 
       timeframe.period == "5" ? "15" : 
       timeframe.period == "15" ? "60" : 
       timeframe.period == "60" ? "240" : "D"

htf2 = timeframe.period == "1" ? "15" : 
       timeframe.period == "5" ? "60" : 
       timeframe.period == "15" ? "240" : 
       timeframe.period == "60" ? "D" : "W"

// Higher Timeframe RSI
htfRsi1 = request.security(syminfo.tickerid, htf1, ta.rsi(close, rsiLength))
htfRsi2 = request.security(syminfo.tickerid, htf2, ta.rsi(close, rsiLength))

// Higher Timeframe MACD
[htfMacd1, htfSignal1, htfHist1] = request.security(syminfo.tickerid, htf1, ta.macd(close, macdFast, macdSlow, macdSignal))
[htfMacd2, htfSignal2, htfHist2] = request.security(syminfo.tickerid, htf2, ta.macd(close, macdFast, macdSlow, macdSignal))

// Multi-Timeframe Trend Alignment
mtfBullish = (not mtfEnabled) or (htfRsi1 > 50 and htfRsi2 > 50 and htfMacd1 > htfSignal1)
mtfBearish = (not mtfEnabled) or (htfRsi1 < 50 and htfRsi2 < 50 and htfMacd1 < htfSignal1)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 🤖 AI-ENHANCED SIGNAL DETECTION (Premium Feature)
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Pattern Recognition Score
patternScore = 0.0

// Fibonacci Confluence Score
fibConfluence = 0
tolerance = atr * 0.3

nearFib236 = math.abs(close - fib236) < tolerance
nearFib382 = math.abs(close - fib382) < tolerance  
nearFib500 = math.abs(close - fib500) < tolerance
nearFib618 = math.abs(close - fib618) < tolerance
nearFib786 = math.abs(close - fib786) < tolerance

if nearFib236
    fibConfluence += 1
if nearFib382
    fibConfluence += 2
if nearFib500
    fibConfluence += 2
if nearFib618
    fibConfluence += 3
if nearFib786
    fibConfluence += 2
if inGoldenZone
    fibConfluence += 4
if inKillZone
    fibConfluence += 3

// Technical Indicator Confluence
technicalScore = 0

// RSI Scoring
if rsiBullish
    technicalScore += 2
else if rsiBearish
    technicalScore -= 2

if rsiDivergenceBull
    technicalScore += 3
else if rsiDivergenceBear
    technicalScore -= 3

// MACD Scoring  
if macdBullish
    technicalScore += 2
else if macdBearish
    technicalScore -= 2

if macdCrossUp
    technicalScore += 3
else if macdCrossDown
    technicalScore -= 3

// Stochastic Scoring
if useStoch
    if stochBullish
        technicalScore += 1
    else if stochBearish
        technicalScore -= 1

// Volume Scoring
volumeScore = 0
if bullishVolume
    volumeScore += 3
else if bearishVolume
    volumeScore -= 3

if cvdBullish
    volumeScore += 2
else if cvdBearish
    volumeScore -= 2

// Multi-Timeframe Scoring
mtfScore = 0
if mtfBullish
    mtfScore += 3
else if mtfBearish
    mtfScore -= 3

// Calculate Total Scores
bullScore = 0
bearScore = 0

// Accumulate Bullish Signals
if close > close[1] and fibConfluence > 0
    bullScore += fibConfluence

if technicalScore > 0
    bullScore += technicalScore
    
if volumeScore > 0
    bullScore += volumeScore
    
if mtfScore > 0
    bullScore += mtfScore

// Accumulate Bearish Signals
if close < close[1] and fibConfluence > 0
    bearScore += fibConfluence

if technicalScore < 0
    bearScore += math.abs(technicalScore)
    
if volumeScore < 0
    bearScore += math.abs(volumeScore)
    
if mtfScore < 0
    bearScore += math.abs(mtfScore)

// Normalize Scores (0-10 scale)
maxScore = 20
bullScore := math.min(10, (bullScore / maxScore) * 10)
bearScore := math.min(10, (bearScore / maxScore) * 10)

// Signal Generation with AI Enhancement
signalThreshold = confluenceFactors * 2
longSignal = enableLongs and bullScore >= signalThreshold and (not useVolume or bullishVolume)
shortSignal = enableShorts and bearScore >= signalThreshold and (not useVolume or bearishVolume)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 💰 SMART MONEY TRACKING (Premium Feature)
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Institutional Volume Detection
avgVolume20 = ta.sma(volume, 20)
avgVolume50 = ta.sma(volume, 50)
institutionalVolume = volume > math.max(avgVolume20, avgVolume50) * 2

// Order Flow Imbalance
buyVolume = volume * (close > open ? 1 : 0)
sellVolume = volume * (close < open ? 1 : 0)
orderFlowImbalance = ta.sma(buyVolume - sellVolume, 10)
bullishFlow = orderFlowImbalance > 0 and orderFlowImbalance > orderFlowImbalance[1]
bearishFlow = orderFlowImbalance < 0 and orderFlowImbalance < orderFlowImbalance[1]

// Accumulation/Distribution
ad = ta.cum(((close - low) - (high - close)) / (high - low) * volume)
adMA = ta.sma(ad, 20)
accumulation = ad > adMA and ad > ad[1]
distribution = ad < adMA and ad < ad[1]

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ⚠️ RISK MANAGEMENT CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Dynamic Stop Loss Calculation
stopLossDistance = switch riskMode
    "Fixed %" => close * (maxRiskPercent / 100)
    "Dynamic ATR" => atr * atrMultiplier
    "Swing Points" => isBullish ? close - currentSwingLow : currentSwingHigh - close
    "Fibonacci Based" => isBullish ? close - fib786 : fib786 - close
    => atr * atrMultiplier

// Calculate Stop Loss Levels
longStopLoss = close - stopLossDistance
shortStopLoss = close + stopLossDistance

// Take Profit Calculations
longTakeProfit1 = close + (stopLossDistance * rrRatio * 0.5)  // First target at 50% of RR
longTakeProfit2 = close + (stopLossDistance * rrRatio)         // Full target
longTakeProfit3 = close + (stopLossDistance * rrRatio * 1.5)  // Extended target

shortTakeProfit1 = close - (stopLossDistance * rrRatio * 0.5)
shortTakeProfit2 = close - (stopLossDistance * rrRatio)
shortTakeProfit3 = close - (stopLossDistance * rrRatio * 1.5)

// Position Sizing Calculation
riskAmount = accountSize * (maxRiskPercent / 100)
positionSize = riskAmount / stopLossDistance
lotSize = math.round(positionSize * 100) / 100

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 📊 PERFORMANCE TRACKING
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Track Signals for Performance
var int totalSignals = 0
var int winningSignals = 0
var float totalPnL = 0.0
var float maxDrawdown = 0.0
var float peakEquity = accountSize

if longSignal or shortSignal
    totalSignals += 1

// Calculate Win Rate (simplified for display)
winRate = totalSignals > 0 ? (winningSignals / totalSignals) * 100 : 0

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 🎨 VISUAL RENDERING - FIBONACCI LEVELS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Clear previous drawings to prevent accumulation
var array<line> fibLines = array.new<line>()
var array<label> fibLabels = array.new<label>()
var array<box> fibBoxes = array.new<box>()

// Clear old objects
if array.size(fibLines) > 0
    for i = 0 to array.size(fibLines) - 1
        line.delete(array.get(fibLines, i))
    array.clear(fibLines)

if array.size(fibLabels) > 0
    for i = 0 to array.size(fibLabels) - 1
        label.delete(array.get(fibLabels, i))
    array.clear(fibLabels)

if array.size(fibBoxes) > 0
    for i = 0 to array.size(fibBoxes) - 1
        box.delete(array.get(fibBoxes, i))
    array.clear(fibBoxes)

// Draw Fibonacci Retracement Levels
if showRetracements and not compactMode
    // 0% Level
    l0 = line.new(swingLowBar, fib0, bar_index + 10, fib0, color=theme.primary, width=2, style=line.style_solid)
    array.push(fibLines, l0)
    
    // 23.6% Level
    if ret_0236
        l236 = line.new(swingLowBar, fib236, bar_index + 10, fib236,color=theme.info, width=1, style=line.style_dotted)
        array.push(fibLines, l236)
    
    // 38.2% Level
    if ret_0382
        l382 = line.new(swingLowBar, fib382, bar_index + 10, fib382,color=theme.secondary, width=1, style=line.style_dashed)
        array.push(fibLines, l382)
    
    // 50% Level
    if ret_0500
        l500 = line.new(swingLowBar, fib500, bar_index + 10, fib500, color=theme.warning, width=2, style=line.style_solid)
        array.push(fibLines, l500)
    
    // 61.8% Level (Golden Ratio)
    if ret_0618
        l618 = line.new(swingLowBar, fib618, bar_index + 10, fib618,color=theme.golden, width=3, style=line.style_solid)
        array.push(fibLines, l618)
    
    // 78.6% Level
    if ret_0786
        l786 = line.new(swingLowBar, fib786, bar_index + 10, fib786, color=theme.secondary, width=1, style=line.style_dashed)
        array.push(fibLines, l786)
    
    // 100% Level
    l100 = line.new(swingHighBar, fib100, bar_index + 10, fib100,color=theme.primary, width=2, style=line.style_solid)
    array.push(fibLines, l100)

// Draw Extension Levels
if showExtensions and not compactMode
    if ext_1272
        l1272 = line.new(swingHighBar, fib1272, bar_index + 10, fib1272,color=color.new(color.purple, 30), width=1, style=line.style_dashed)
        array.push(fibLines, l1272)
    
    if ext_1618
        l1618 = line.new(swingHighBar, fib1618, bar_index + 10, fib1618,color=color.new(color.purple, 20), width=2, style=line.style_dashed)
        array.push(fibLines, l1618)
    
    if ext_2618
        l2618 = line.new(swingHighBar, fib2618, bar_index + 10, fib2618,color=color.new(color.purple, 40), width=1, style=line.style_dotted)
        array.push(fibLines, l2618)

// Draw Golden Zone
if showGoldenZone
    goldenBox = box.new(swingLowBar, goldenZoneTop, bar_index + 10, goldenZoneBottom,border_color=color.new(theme.golden, 70),border_width=1,bgcolor=theme.golden,text="GOLDEN ZONE",text_color=color.new(color.white, 0),text_halign=text.align_center,text_valign=text.align_center,text_size=size.small)
    array.push(fibBoxes, goldenBox)

// Draw Kill Zone
if showKillZone and not compactMode
    killBox = box.new(swingHighBar, fib886 + atr * 0.1, bar_index + 10, fib886 - atr * 0.1,border_color=color.new(theme.danger, 70),border_width=1, bgcolor=color.new(theme.danger, 90),text="KILL ZONE",text_color=theme.danger,text_halign=text.align_center, text_valign=text.align_center,text_size=size.tiny)
    array.push(fibBoxes, killBox)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 🏷️ FIBONACCI LABELS
// ═══════════════════════════════════════════════════════════════════════════════════════════════

if not compactMode and barstate.islast
    labelOffset = 12
    
    // Create informative labels
    if ret_0236
        lbl236 = label.new(bar_index + labelOffset, fib236,"23.6% (" + str.tostring(fib236, format.mintick) + ")",style=label.style_label_left,color=color.new(theme.background, 80),textcolor=theme.info,size=size.small)
        array.push(fibLabels, lbl236)

    if ret_0382
        lbl382 = label.new(bar_index + labelOffset, fib382,"38.2% (" + str.tostring(fib382, format.mintick) + ")",style=label.style_label_left,color=color.new(theme.background, 80),textcolor=theme.secondary,size=size.small)
        array.push(fibLabels, lbl382)

    if ret_0500
        lbl500 = label.new(bar_index + labelOffset, fib500,"50.0% (" + str.tostring(fib500, format.mintick) + ")",style=label.style_label_left,color=color.new(theme.background, 80),textcolor=theme.warning,size=size.normal)
        array.push(fibLabels, lbl500)

    if ret_0618
        lbl618 = label.new(bar_index + labelOffset, fib618,"⭐ 61.8% GOLDEN (" + str.tostring(fib618, format.mintick) + ")",style=label.style_label_left,color=color.new(theme.golden, 20),textcolor=color.white,size=size.normal)
        array.push(fibLabels, lbl618)

    if ret_0786
        lbl786 = label.new(bar_index + labelOffset, fib786,"78.6% (" + str.tostring(fib786, format.mintick) + ")",style=label.style_label_left,color=color.new(theme.background, 80),textcolor=theme.secondary,size=size.small)
        array.push(fibLabels, lbl786)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 📍 SIGNAL VISUALIZATION
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Plot Buy/Sell Signals
plotshape(longSignal, title="BUY Signal", location=location.belowbar,color=theme.success, style=shape.labelup, size=size.normal,text="BUY")

plotshape(shortSignal, title="SELL Signal", location=location.abovebar,color=theme.danger, style=shape.labeldown, size=size.normal,text="SELL")

// Detailed Signal Labels
if longSignal and not compactMode
    signalText = "🟢 BUY SIGNAL\n" + "━━━━━━━━━━━\n" + "Score: " + str.tostring(bullScore, "#.#") + "/10\n" + "Entry: " + str.tostring(close, format.mintick) + "\n" + "Stop: " + str.tostring(longStopLoss, format.mintick) + "\n" + "TP1: " + str.tostring(longTakeProfit1, format.mintick) + "\n" + "TP2: " + str.tostring(longTakeProfit2, format.mintick) + "\n" + "Risk: $" + str.tostring(riskAmount, "#.##") + "\n" + "Size: " + str.tostring(lotSize, "#.##") + " lots"

    label.new(bar_index, low * 0.995, signalText,style=label.style_label_up,color=theme.success,textcolor=color.white,size=size.normal)

if shortSignal and not compactMode
    signalText = "🔴 SELL SIGNAL\n" + "━━━━━━━━━━━\n" + "Score: " + str.tostring(bearScore, "#.#") + "/10\n" + "Entry: " + str.tostring(close, format.mintick) + "\n" + "Stop: " + str.tostring(shortStopLoss, format.mintick) + "\n" + "TP1: " + str.tostring(shortTakeProfit1, format.mintick) + "\n" + "TP2: " + str.tostring(shortTakeProfit2, format.mintick) + "\n" + "Risk: $" + str.tostring(riskAmount, "#.##") + "\n" + "Size: " + str.tostring(lotSize, "#.##") + " lots"

    label.new(bar_index, high * 1.005, signalText,style=label.style_label_down,color=theme.danger,textcolor=color.white,size=size.normal)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 🎨 BACKGROUND COLORING & ZONES
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Golden Zone Highlighting
bgcolor(inGoldenZone ? color.new(theme.golden, 95) : na, title="Golden Zone BG")

// Kill Zone Highlighting
bgcolor(inKillZone ? color.new(theme.danger, 95) : na, title="Kill Zone BG")

// Trend Background
trendColor = isBullish ? color.new(theme.success, 98) : color.new(theme.danger, 98)
bgcolor(proMode ? trendColor : na, title="Trend Background")

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 📊 PROFESSIONAL ANALYTICS DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════════════════════

var table dashboardTable = table.new(position.top_right, 3, 30,bgcolor=color.new(theme.background, 0),border_width=1,border_color=theme.primary)

if showDashboard and barstate.islast
    // Header
    table.cell(dashboardTable, 0, 0, "🔥 FIBONACCI PRO",text_color=color.white, text_size=size.large,bgcolor=theme.primary)
    table.cell(dashboardTable, 1, 0, "ANALYTICS",text_color=color.white, text_size=size.large,bgcolor=theme.primary)
    table.cell(dashboardTable, 2, 0, "v7.0",text_color=color.white, text_size=size.large,bgcolor=theme.primary)
    
    row = 1
    
    // Market Structure Section
    table.cell(dashboardTable, 0, row, "📊 MARKET", text_color=theme.info, text_size=size.normal)
    table.cell(dashboardTable, 1, row, "STRUCTURE", text_color=theme.info, text_size=size.normal)
    table.cell(dashboardTable, 2, row, "", bgcolor=color.new(theme.info, 90))
    row += 1
    
    // Trend
    trendIcon = isBullish ? "📈" : "📉"
    trendText = isBullish ? "BULLISH" : "BEARISH"
    trendCol = isBullish ? theme.success : theme.danger
    table.cell(dashboardTable, 0, row, "Trend", text_color=color.gray)
    table.cell(dashboardTable, 1, row, trendIcon + " " + trendText, text_color=trendCol)
    table.cell(dashboardTable, 2, row, str.tostring(trendStrength, "#.#") + "%", text_color=trendCol)
    row += 1
    
    // Nearest Fibonacci
    nearestFib = inGoldenZone ? "🌟 Golden Zone" :
                 inKillZone ? "💀 Kill Zone" :
                 nearFib618 ? "61.8%" :
                 nearFib500 ? "50.0%" :
                 nearFib382 ? "38.2%" :
                 nearFib236 ? "23.6%" : "None"
    table.cell(dashboardTable, 0, row, "Fib Level", text_color=color.gray)
    table.cell(dashboardTable, 1, row, nearestFib, text_color=theme.warning)
    table.cell(dashboardTable, 2, row, "", bgcolor=color.new(theme.warning, 90))
    row += 1
    
    // Signal Strength Section
    table.cell(dashboardTable, 0, row, "🎯 SIGNAL", text_color=theme.primary, text_size=size.normal)
    table.cell(dashboardTable, 1, row, "STRENGTH", text_color=theme.primary, text_size=size.normal)
    table.cell(dashboardTable, 2, row, "", bgcolor=color.new(theme.primary, 90))
    row += 1
    
    // Bull Score
    table.cell(dashboardTable, 0, row, "Bull Score", text_color=color.gray)
    table.cell(dashboardTable, 1, row, str.tostring(bullScore, "#.#") + "/10",text_color=bullScore > 5 ? theme.success : color.gray)
    bullBarCount = math.round(bullScore)
    bullBar = bullBarCount == 0 ? "" : bullBarCount == 1 ? "█" : bullBarCount == 2 ? "██" : bullBarCount == 3 ? "███" : bullBarCount == 4 ? "████" : bullBarCount == 5 ? "█████" : bullBarCount == 6 ? "██████" : bullBarCount == 7 ? "███████" : bullBarCount == 8 ? "████████" : bullBarCount == 9 ? "█████████" : "██████████"
    table.cell(dashboardTable, 2, row, bullBar, text_color=theme.success)
    row += 1

    // Bear Score
    table.cell(dashboardTable, 0, row, "Bear Score", text_color=color.gray)
    table.cell(dashboardTable, 1, row, str.tostring(bearScore, "#.#") + "/10",text_color=bearScore > 5 ? theme.danger : color.gray)
    bearBarCount = math.round(bearScore)
    bearBar = bearBarCount == 0 ? "" : bearBarCount == 1 ? "█" : bearBarCount == 2 ? "██" : bearBarCount == 3 ? "███" : bearBarCount == 4 ? "████" : bearBarCount == 5 ? "█████" : bearBarCount == 6 ? "██████" : bearBarCount == 7 ? "███████" : bearBarCount == 8 ? "████████" : bearBarCount == 9 ? "█████████" : "██████████"
    table.cell(dashboardTable, 2, row, bearBar, text_color=theme.danger)
    row += 1
    
    // Technical Indicators Section
    table.cell(dashboardTable, 0, row, "📈 TECHNICAL", text_color=theme.secondary, text_size=size.normal)
    table.cell(dashboardTable, 1, row, "INDICATORS", text_color=theme.secondary, text_size=size.normal)
    table.cell(dashboardTable, 2, row, "", bgcolor=color.new(theme.secondary, 90))
    row += 1
    
    // RSI
    rsiStatus = rsi > rsiOverbought ? "🔴 OB" : rsi < rsiOversold ? "🟢 OS" : "🟡"
    table.cell(dashboardTable, 0, row, "RSI", text_color=color.gray)
    table.cell(dashboardTable, 1, row, str.tostring(math.round(rsi)), text_color=color.white)
    table.cell(dashboardTable, 2, row, rsiStatus, text_color=color.white)
    row += 1
    
    // MACD
    macdStatus = macdBullish ? "🟢" : macdBearish ? "🔴" : "🟡"
    table.cell(dashboardTable, 0, row, "MACD", text_color=color.gray)
    table.cell(dashboardTable, 1, row, macdStatus + " " + (macdLine > signalLine ? "Bull" : "Bear"),text_color=macdLine > signalLine ? theme.success : theme.danger)
    table.cell(dashboardTable, 2, row, str.tostring(macdHist, "#.####"), text_color=color.white)
    row += 1
    
    // Stochastic
    if useStoch
        stochStatus = k > 80 ? "🔴 OB" : k < 20 ? "🟢 OS" : "🟡"
        table.cell(dashboardTable, 0, row, "Stoch", text_color=color.gray)
        table.cell(dashboardTable, 1, row, str.tostring(math.round(k)), text_color=color.white)
        table.cell(dashboardTable, 2, row, stochStatus, text_color=color.white)
        row += 1
    
    // Volume Analysis Section
    if useVolume
        table.cell(dashboardTable, 0, row, "📊 VOLUME", text_color=theme.info, text_size=size.normal)
        table.cell(dashboardTable, 1, row, "ANALYSIS", text_color=theme.info, text_size=size.normal)
        table.cell(dashboardTable, 2, row, "", bgcolor=color.new(theme.info, 90))
        row += 1
        
        volStatus = volumeSpike ? "🚨 SPIKE!" : "Normal"
        volColor = volumeSpike ? theme.warning : color.gray
        table.cell(dashboardTable, 0, row, "Volume", text_color=color.gray)
        table.cell(dashboardTable, 1, row, volStatus, text_color=volColor)
        table.cell(dashboardTable, 2, row, str.tostring(volume/volumeMA, "#.#") + "x", text_color=volColor)
        row += 1
        
        // CVD
        cvdStatus = cvdBullish ? "🟢 Buying" : cvdBearish ? "🔴 Selling" : "🟡 Neutral"
        table.cell(dashboardTable, 0, row, "CVD", text_color=color.gray)
        table.cell(dashboardTable, 1, row, cvdStatus,text_color=cvdBullish ? theme.success : cvdBearish ? theme.danger : color.gray)
        table.cell(dashboardTable, 2, row, "", bgcolor=color.new(color.gray, 90))
        row += 1
    
    // Smart Money Section
    if smartMoney
        table.cell(dashboardTable, 0, row, "💰 SMART", text_color=theme.golden, text_size=size.normal)
        table.cell(dashboardTable, 1, row, "MONEY", text_color=theme.golden, text_size=size.normal)
        table.cell(dashboardTable, 2, row, "", bgcolor=color.new(theme.golden, 90))
        row += 1
        
        // Institutional Activity
        instStatus = institutionalVolume ? "🏦 Active" : "Quiet"
        table.cell(dashboardTable, 0, row, "Institutional", text_color=color.gray)
        table.cell(dashboardTable, 1, row, instStatus,text_color=institutionalVolume ? theme.warning : color.gray)
        table.cell(dashboardTable, 2, row, "", bgcolor=color.new(color.gray, 90))
        row += 1
        
        // Accumulation/Distribution
        adStatus = accumulation ? "📈 Accumulation" : distribution ? "📉 Distribution" : "➡️ Neutral"
        adColor = accumulation ? theme.success : distribution ? theme.danger : color.gray
        table.cell(dashboardTable, 0, row, "A/D", text_color=color.gray)
        table.cell(dashboardTable, 1, row, adStatus, text_color=adColor)
        table.cell(dashboardTable, 2, row, "", bgcolor=color.new(adColor, 90))
        row += 1
    
    // Risk Management Section
    table.cell(dashboardTable, 0, row, "⚠️ RISK", text_color=theme.danger, text_size=size.normal)
    table.cell(dashboardTable, 1, row, "MANAGEMENT", text_color=theme.danger, text_size=size.normal)
    table.cell(dashboardTable, 2, row, "", bgcolor=color.new(theme.danger, 90))
    row += 1
    
    // Volatility
    volStatus = isHighVolatility ? "⚠️ HIGH" : isLowVolatility ? "✅ LOW" : "🟡 Normal"
    volColor = isHighVolatility ? theme.danger : isLowVolatility ? theme.success : color.gray
    table.cell(dashboardTable, 0, row, "Volatility", text_color=color.gray)
    table.cell(dashboardTable, 1, row, volStatus, text_color=volColor)
    table.cell(dashboardTable, 2, row, str.tostring(atrPercent, "#.##") + "%", text_color=volColor)
    row += 1
    
    // Position Size
    table.cell(dashboardTable, 0, row, "Pos. Size", text_color=color.gray)
    table.cell(dashboardTable, 1, row, str.tostring(lotSize, "#.##") + " lots", text_color=color.white)
    table.cell(dashboardTable, 2, row, "$" + str.tostring(riskAmount, "#"), text_color=theme.warning)
    row += 1
    
    // Performance Section (if enabled)
    if showPerformance and totalSignals > 0
        table.cell(dashboardTable, 0, row, "📈 PERFORMANCE", text_color=theme.success, text_size=size.normal)
        table.cell(dashboardTable, 1, row, "", text_color=theme.success)
        table.cell(dashboardTable, 2, row, "", bgcolor=color.new(theme.success, 90))
        row += 1
        
        // Win Rate
        table.cell(dashboardTable, 0, row, "Win Rate", text_color=color.gray)
        table.cell(dashboardTable, 1, row, str.tostring(winRate, "#.#") + "%",text_color=winRate > 50 ? theme.success : theme.danger)
        table.cell(dashboardTable, 2, row, str.tostring(totalSignals) + " trades", text_color=color.gray)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 🔔 ADVANCED ALERT SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Create Alert Messages
fibLevel = inGoldenZone ? "Golden Zone" : inKillZone ? "Kill Zone" : nearFib618 ? "61.8%" : nearFib500 ? "50.0%" : nearFib382 ? "38.2%" : "Fibonacci Level"

// Long Alert Message
longAlertMessage = "🟢 FIBONACCI PRO - BUY SIGNAL\n" + "════════════════════\n" + "Symbol: " + syminfo.ticker + "\n" + "Price: " + str.tostring(close, format.mintick) + "\n" + "Fibonacci: " + fibLevel + "\n" + "Signal Strength: " + str.tostring(bullScore, "#.#") + "/10\n" + "Stop Loss: " + str.tostring(longStopLoss, format.mintick) + "\n" + "Take Profit 1: " + str.tostring(longTakeProfit1, format.mintick) + "\n" + "Take Profit 2: " + str.tostring(longTakeProfit2, format.mintick) + "\n" + "Risk Amount: $" + str.tostring(riskAmount, "#.##") + "\n" + "Position Size: " + str.tostring(lotSize, "#.##") + " lots\n" + "════════════════════"

// Short Alert Message
shortAlertMessage = "🔴 FIBONACCI PRO - SELL SIGNAL\n" + "════════════════════\n" + "Symbol: " + syminfo.ticker + "\n" + "Price: " + str.tostring(close, format.mintick) + "\n" + "Fibonacci: " + fibLevel + "\n" + "Signal Strength: " + str.tostring(bearScore, "#.#") + "/10\n" + "Stop Loss: " + str.tostring(shortStopLoss, format.mintick) + "\n" + "Take Profit 1: " + str.tostring(shortTakeProfit1, format.mintick) + "\n" + "Take Profit 2: " + str.tostring(shortTakeProfit2, format.mintick) + "\n" + "Risk Amount: $" + str.tostring(riskAmount, "#.##") + "\n" + "Position Size: " + str.tostring(lotSize, "#.##") + " lots\n" + "════════════════════"

// Alert Conditions - Must be at global scope
// Main Signals
alertcondition(alertsEnabled and longSignal,title="🟢 Fibonacci PRO - Buy Signal",message="BUY Signal detected at Fibonacci level. Check chart for entry details.")
alertcondition(alertsEnabled and shortSignal,title="🔴 Fibonacci PRO - Sell Signal",message="SELL Signal detected at Fibonacci level. Check chart for entry details.")

// Fibonacci Levels
alertcondition(alertsEnabled and inGoldenZone,title="🌟 Golden Zone Entry",message="Price has entered the Golden Zone (61.8%-65.0%)")
alertcondition(alertsEnabled and inKillZone,title="💀 Kill Zone Alert",message="Price at Kill Zone (88.6%) - High reversal probability")

// Volume Alerts
alertcondition(alertsEnabled and volumeSpike and (nearFib618 or nearFib382 or nearFib500),title="📊 Volume Spike at Fibonacci",message="High volume detected at Fibonacci level")

// Divergence Alerts
alertcondition(alertsEnabled and rsiDivergenceBull and fibConfluence > 2,title="🟢 Bullish Divergence at Fibonacci",message="RSI Bullish Divergence detected at Fibonacci level")
alertcondition(alertsEnabled and rsiDivergenceBear and fibConfluence > 2,title="🔴 Bearish Divergence at Fibonacci",message="RSI Bearish Divergence detected at Fibonacci level")

// Smart Money Alerts
alertcondition(alertsEnabled and smartMoney and institutionalVolume and fibConfluence > 3,title="🏦 Institutional Activity at Fibonacci",message="Institutional volume detected at key Fibonacci level")
alertcondition(alertsEnabled and smartMoney and accumulation and inGoldenZone,title="📈 Accumulation in Golden Zone",message="Smart money accumulation detected in Golden Zone")

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// 📌 PLOT OUTPUTS FOR STRATEGY TESTING
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// Plot invisible values for strategy access
plot(bullScore, title="Bull Score", display=display.data_window)
plot(bearScore, title="Bear Score", display=display.data_window)
plot(fibConfluence, title="Fibonacci Confluence", display=display.data_window)
plot(longSignal ? 1 : 0, title="Long Signal", display=display.data_window)
plot(shortSignal ? 1 : 0, title="Short Signal", display=display.data_window)

