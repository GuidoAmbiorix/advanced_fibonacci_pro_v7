# ============================================================================
# INSTITUTIONAL EDGE PRO - Production Backend Dockerfile with MT5 Support
# ============================================================================
# This Dockerfile provides MT5 support on Linux through Wine
# For production use on Linux VPS
# ============================================================================

FROM python:3.10-slim

# Prevent Python from writing pyc files and buffering stdout/stderr
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# ============================================================================
# OPTION 1: Basic Installation (No MT5 - for remote MT5 connection)
# Uncomment this section and comment out OPTION 2 if you'll connect to
# a remote Windows machine running MT5
# ============================================================================
# RUN apt-get update && apt-get install -y \
#     gcc \
#     g++ \
#     libpq-dev \
#     wget \
#     curl \
#     && rm -rf /var/lib/apt/lists/*

# ============================================================================
# OPTION 2: Wine Installation (For running MT5 on Linux)
# This installs Wine to run MetaTrader5 directly in the container
# WARNING: This significantly increases image size (~1-2GB)
# ============================================================================
RUN dpkg --add-architecture i386 && \
    apt-get update && apt-get install -y \
    wine \
    wine32 \
    wine64 \
    winetricks \
    xvfb \
    gcc \
    g++ \
    libpq-dev \
    wget \
    curl \
    cabextract \
    && rm -rf /var/lib/apt/lists/*

# Set Wine environment
ENV WINEARCH=win64 \
    WINEPREFIX=/root/.wine \
    DISPLAY=:99

# ============================================================================
# Install Python Dependencies
# ============================================================================
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ============================================================================
# Copy Application Code
# ============================================================================
COPY . .

# Create necessary directories
RUN mkdir -p logs reports /root/.wine

# ============================================================================
# Expose Ports
# ============================================================================
EXPOSE 8000

# ============================================================================
# Health Check
# ============================================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# ============================================================================
# Startup Script
# ============================================================================
# Create startup script to handle Wine display server
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Start virtual display for Wine (if using Wine)\n\
if command -v Xvfb &> /dev/null; then\n\
    echo "Starting virtual display for Wine..."\n\
    Xvfb :99 -screen 0 1024x768x16 &\n\
    export DISPLAY=:99\n\
    sleep 2\n\
fi\n\
\n\
# Run database migrations if needed\n\
# python -m alembic upgrade head\n\
\n\
# Start the application\n\
echo "Starting Institutional Edge Pro Backend..."\n\
exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4\n\
' > /app/start.sh && chmod +x /app/start.sh

CMD ["/app/start.sh"]
