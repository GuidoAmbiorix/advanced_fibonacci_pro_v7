# ============================================================================
# Backend .dockerignore
# Exclude files from Docker build context for faster builds
# ============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Virtual Environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store

# Environment files (will be mounted separately)
.env
.env.local
.env.*.local
.env.production

# Logs and data
logs/
*.log
reports/
*.csv
*.xlsx
*.json.bak

# Database
*.db
*.sqlite
*.sqlite3

# Testing
.coverage
coverage/
.pytest_cache/

# Documentation
docs/
*.md
!README.md

# Git
.git/
.gitignore
.gitattributes

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup
