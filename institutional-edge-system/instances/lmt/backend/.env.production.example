# ============================================================================
# INSTITUTIONAL EDGE PRO - Production Environment Configuration
# Copy this to .env.production and fill in your values
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME="Institutional Edge Pro"
APP_VERSION="1.0.0"
DEBUG=False
SECRET_KEY=generate_a_secure_random_key_here_at_least_32_characters
LOG_LEVEL=INFO
LOG_FILE=/app/logs/trading.log

# ============================================================================
# SERVER
# ============================================================================
HOST=0.0.0.0
PORT=8000

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# Connection URL format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@postgres:5432/institutional_edge
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# REDIS (Cache & Real-time)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_secure_redis_password

# ============================================================================
# RABBITMQ (Message Queue)
# ============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_secure_rabbitmq_password

# ============================================================================
# METATRADER 5 CONFIGURATION
# ============================================================================
# IMPORTANT: Choose ONE of the following options for MT5 integration:
#
# OPTION 1: Remote MT5 Connection (RECOMMENDED for Linux VPS)
# - Run MT5 on a Windows machine (local PC or Windows VPS)
# - Leave MT5_PATH empty or set to ""
# - Backend will use existing MT5 terminal connection
# - You can use MetaTrader's built-in remote access features
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# OPTION 2: Wine-based MT5 (if using Dockerfile.prod with Wine enabled)
# - Runs MT5 directly in Linux container through Wine
# - Requires Wine installation in Dockerfile.prod (increases image size)
# - Less stable but fully containerized
# MT5_LOGIN=your_mt5_account_number
# MT5_PASSWORD=your_mt5_password
# MT5_SERVER=your_broker_server
# MT5_PATH=/opt/mt5/terminal64.exe

# OPTION 3: Mock Mode (for testing without MT5)
# - Leave all MT5 settings empty
# - System will run in demo/mock mode
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_PATH=

# MT5 Symbol Configuration
MT5_SYMBOL_SUFFIX=
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=H1

# ============================================================================
# TRADING PARAMETERS
# ============================================================================
DEFAULT_RISK_PERCENT=2.0
MAX_RISK_PERCENT=5.0
MIN_CONFLUENCE_SCORE=6
MAX_SLIPPAGE_POINTS=10

# ============================================================================
# CORS (API Security)
# ============================================================================
# Add your domain(s) here in production
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET_KEY=generate_a_different_secure_key_for_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# NOTIFICATIONS
# ============================================================================
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM=False

# Discord
DISCORD_WEBHOOK_URL=
ENABLE_DISCORD=False

# Email
ENABLE_EMAIL_ALERTS=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=True

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# AlphaVantage (for fundamental data)
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key

# ============================================================================
# MONITORING & PERFORMANCE
# ============================================================================
ENABLE_METRICS=True
METRICS_PORT=9090

# ============================================================================
# SECURITY
# ============================================================================
# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# API Key authentication (optional)
API_KEY_HEADER=X-API-Key
REQUIRE_API_KEY=False
