# Instance-specific configuration
# This file is a template - the orchestrator will generate .env files for each instance

# Instance number (1, 2, 3, etc.)
VITE_INSTANCE_NUMBER=1

# API Base URL (will be set to /instance/N/api by orchestrator)
VITE_API_BASE_URL=/instance/1/api

# Socket.IO URL (will be set to /instance/N by orchestrator)
VITE_SOCKET_URL=/instance/1

# Instance name (optional, for display purposes)
VITE_INSTANCE_NAME=Instance 1
