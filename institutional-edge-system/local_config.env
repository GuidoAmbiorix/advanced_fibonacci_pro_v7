# Local Overrides for De-Dockerized Execution

# Database (Localhost, Port 5433 from Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/institutional_edge

# Redis (Localhost, Port 6379 from Docker)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
